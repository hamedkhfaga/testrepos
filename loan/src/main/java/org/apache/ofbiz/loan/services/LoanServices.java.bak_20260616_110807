    public static Map<String, Object> createPartyLoan(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String partyId = (String) context.get("partyId");
            String organizationPartyId = (String) context.get("organizationPartyId");
            String loanTypeEnumId = (String) context.get("loanTypeEnumId");
            String currencyUomId = (String) context.get("currencyUomId");
            BigDecimal principalAmount = (BigDecimal) context.get("principalAmount");
            BigDecimal interestAmount = (BigDecimal) context.get("interestAmount");
            BigDecimal feeAmount = (BigDecimal) context.get("feeAmount");
            Long installmentCount = (Long) context.get("installmentCount");
            String agreementId = trimToNull((String) context.get("agreementId"));
            String finAccountId = trimToNull((String) context.get("finAccountId"));

            Timestamp nowTs = UtilDateTime.nowTimestamp();
            Timestamp applicationDate = (Timestamp) context.get("applicationDate");
            if (applicationDate == null) {
                applicationDate = nowTs;
            }

            if (UtilValidate.isEmpty(partyId)
                    || UtilValidate.isEmpty(organizationPartyId)
                    || UtilValidate.isEmpty(loanTypeEnumId)
                    || UtilValidate.isEmpty(currencyUomId)
                    || principalAmount == null
                    || installmentCount == null
                    || installmentCount.longValue() <= 0) {
                return ServiceUtil.returnError(
                        "partyId, organizationPartyId, loanTypeEnumId, currencyUomId, principalAmount, installmentCount are required");
            }

            if (interestAmount == null) {
                interestAmount = BigDecimal.ZERO;
            }
            if (feeAmount == null) {
                feeAmount = BigDecimal.ZERO;
            }

            validateAgreementIfProvided(delegator, agreementId);
            validateFinAccountIfProvided(delegator, finAccountId);

            BigDecimal totalRepayableAmount = principalAmount.add(interestAmount).add(feeAmount);

            String loanId = delegator.getNextSeqId("PartyLoan");

            GenericValue loan = delegator.makeValue("PartyLoan");
            loan.set("loanId", loanId);
            loan.set("loanNumber", loanId);
            loan.set("partyId", partyId);
            loan.set("organizationPartyId", organizationPartyId);
            loan.set("agreementId", agreementId);
            loan.set("finAccountId", finAccountId);
            loan.set("loanTypeEnumId", loanTypeEnumId);
            loan.set("borrowerRoleTypeId", (String) context.get("borrowerRoleTypeId"));
            loan.set("borrowerTypeEnumId", trimToNull((String) context.get("borrowerTypeEnumId")));
            loan.set("currencyUomId", currencyUomId);
            loan.set("principalAmount", principalAmount);
            loan.set("interestAmount", interestAmount);
            loan.set("feeAmount", feeAmount);
            loan.set("penaltyAmount", BigDecimal.ZERO);
            loan.set("totalRepayableAmount", totalRepayableAmount);
            loan.set("paidAmount", BigDecimal.ZERO);
            loan.set("outstandingAmount", totalRepayableAmount);
            loan.set("installmentCount", installmentCount);
            loan.set("interestMethodEnumId",
                    getValueOrPolicy(delegator, loanTypeEnumId, (String) context.get("interestMethodEnumId"),
                            "interestMethodEnumId"));
            loan.set("repaymentPatternEnumId",
                    getValueOrPolicy(delegator, loanTypeEnumId, (String) context.get("repaymentPatternEnumId"),
                            "repaymentPatternEnumId"));
            loan.set("allocationOrderEnumId",
                    getValueOrPolicy(delegator, loanTypeEnumId, (String) context.get("allocationOrderEnumId"),
                            "allocationOrderEnumId"));
            loan.set("settlementPolicyEnumId",
                    getValueOrPolicy(delegator, loanTypeEnumId, (String) context.get("settlementPolicyEnumId"),
                            "settlementPolicyEnumId"));
            loan.set("repaymentChannelEnumId",
                    getValueOrPolicy(delegator, loanTypeEnumId, (String) context.get("repaymentChannelEnumId"),
                            "defaultChannelEnumId"));
            loan.set("preferredRepaymentMethodEnumId", trimToNull((String) context.get("preferredRepaymentMethodEnumId")));
            loan.set("payrollEligibleFlag", getFlagOrPolicy(delegator, loanTypeEnumId, "allowPayrollFlag"));
            loan.set("allowEarlySettlementFlag", getFlagOrPolicy(delegator, loanTypeEnumId, "allowEarlySettlementFlag"));
            loan.set("allowRescheduleFlag", getFlagOrPolicy(delegator, loanTypeEnumId, "allowRescheduleFlag"));
            loan.set("allowPartialPaymentFlag", getFlagOrPolicy(delegator, loanTypeEnumId, "allowPartialPaymentFlag"));
            loan.set("applicationDate", applicationDate);
            loan.set("firstDueDate", (Timestamp) context.get("firstDueDate"));
            loan.set("loanStatusId", LOAN_DRAFT);
            loan.set("remarks", (String) context.get("remarks"));
            loan.set("createdByUserLoginId", userLogin != null ? userLogin.getString("userLoginId") : null);

            delegator.create(loan);

            LoanRepaymentServices.createLoanEvent(
                    delegator,
                    loanId,
                    null,
                    null,
                    "LNE_CREATE",
                    nowTs,
                    userLogin != null ? userLogin.getString("userLoginId") : null,
                    "Loan created",
                    null
            );

            Map<String, Object> data = new HashMap<String, Object>();
            data.put("loanId", loanId);
            data.put("loanNumber", loanId);
            data.put("loanStatusId", LOAN_DRAFT);
            data.put("partyId", partyId);
            data.put("organizationPartyId", organizationPartyId);
            data.put("agreementId", agreementId);
            data.put("finAccountId", finAccountId);
            data.put("loanTypeEnumId", loanTypeEnumId);
            data.put("currencyUomId", currencyUomId);
            data.put("principalAmount", principalAmount);
            data.put("totalRepayableAmount", totalRepayableAmount);
            data.put("installmentCount", installmentCount);

            return buildStandardSuccess("Loan created successfully", data);

        } catch (Exception e) {
            Debug.logError(e, "Error creating loan", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }

    public static Map<String, Object> approvePartyLoan(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        LocalDispatcher dispatcher = dctx.getDispatcher();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String loanId = (String) context.get("loanId");
            Timestamp approvalDate = (Timestamp) context.get("approvalDate");

            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }
            if (approvalDate == null) {
                approvalDate = UtilDateTime.nowTimestamp();
            }

            GenericValue loan = requireLoan(delegator, loanId);

            Map<String, Object> statusValidation = validateLoanStatus(loan, "approvePartyLoan", LOAN_DRAFT);
            if (ServiceUtil.isError(statusValidation)) {
                return statusValidation;
            }

            String previousLoanStatusId = loan.getString("loanStatusId");
            loan.set("loanStatusId", LOAN_APPROVED);
            loan.set("approvalDate", approvalDate);
            loan.set("approvedByUserLoginId", userLogin != null ? userLogin.getString("userLoginId") : null);
            loan.store();

            String agreementId = trimToNull(loan.getString("agreementId"));
            if (UtilValidate.isEmpty(agreementId)) {
                Map<String, Object> agreementCtx = new HashMap<String, Object>();
                agreementCtx.put("loanId", loanId);
                agreementCtx.put("agreementDate", approvalDate);
                agreementCtx.put("userLogin", userLogin);

                Map<String, Object> agreementResp = dispatcher.runSync("createLoanAgreementV1", agreementCtx);
                if (ServiceUtil.isError(agreementResp)) {
                    return ServiceUtil.returnError(
                            "Loan approved but agreement creation failed for loanId: " + loanId + ". "
                                    + ServiceUtil.getErrorMessage(agreementResp));
                }

                agreementId = (String) agreementResp.get("agreementId");
                if (UtilValidate.isNotEmpty(agreementId)) {
                    loan.refresh();
                    loan.set("agreementId", agreementId);
                    loan.store();
                }
            }

            String billingAccountId = getLoanBillingAccountId(loan);
            if (UtilValidate.isEmpty(billingAccountId)) {
                Map<String, Object> billingCtx = new HashMap<String, Object>();
                billingCtx.put("loanId", loanId);
                billingCtx.put("userLogin", userLogin);

                Map<String, Object> billingResp = dispatcher.runSync("createOrLinkLoanBillingAccountV1", billingCtx);
                if (ServiceUtil.isError(billingResp)) {
                    return ServiceUtil.returnError(
                            "Loan approved but billing account creation failed for loanId: " + loanId + ". "
                                    + ServiceUtil.getErrorMessage(billingResp));
                }

                billingAccountId = (String) billingResp.get("billingAccountId");
                if (UtilValidate.isNotEmpty(billingAccountId)) {
                    loan.refresh();
                    if (loan.getModelEntity().isField("billingAccountId")) {
                        loan.set("billingAccountId", billingAccountId);
                        loan.store();
                    }
                }
            }

            LoanRepaymentServices.createLoanEvent(
                    delegator,
                    loanId,
                    null,
                    null,
                    "LNE_APPROVE",
                    approvalDate,
                    userLogin != null ? userLogin.getString("userLoginId") : null,
                    "Loan approved"
                            + (UtilValidate.isNotEmpty(agreementId) ? " agreementId=" + agreementId : ""),
                    agreementId
            );

            long existingScheduleCount = countLoanScheduleRows(delegator, loanId);
            long generatedScheduleCount = 0L;

            if (existingScheduleCount <= 0L) {
                Map<String, Object> genCtx = UtilMisc.<String, Object>toMap(
                        "loanId", loanId,
                        "userLogin", userLogin);

                Map<String, Object> genResp = dispatcher.runSync("generatePartyLoanSchedule", genCtx);
                if (ServiceUtil.isError(genResp)) {
                    return ServiceUtil.returnError(
                            "Loan approved but schedule generation failed for loanId: " + loanId + ". "
                                    + ServiceUtil.getErrorMessage(genResp));
                }

                Object generatedObj = genResp.get("generatedScheduleCount");
                if (generatedObj == null) {
                    generatedObj = genResp.get("generatedCount");
                }

                if (generatedObj instanceof Number) {
                    generatedScheduleCount = ((Number) generatedObj).longValue();
                } else if (generatedObj != null) {
                    generatedScheduleCount = Long.valueOf(generatedObj.toString());
                } else {
                    long afterCount = countLoanScheduleRows(delegator, loanId);
                    generatedScheduleCount = Math.max(0L, afterCount - existingScheduleCount);
                }
            }

            Map<String, Object> data = new HashMap<String, Object>();
            data.put("loanId", loanId);
            data.put("loanStatusId", LOAN_APPROVED);
            data.put("previousLoanStatusId", previousLoanStatusId);
            data.put("approvalDate", approvalDate);
            data.put("agreementId", trimToNull(loan.getString("agreementId")));
            data.put("billingAccountId", getLoanBillingAccountId(loan));
            data.put("generatedScheduleCount", Long.valueOf(generatedScheduleCount));
            data.put("existingScheduleCount", Long.valueOf(existingScheduleCount));

            return buildStandardSuccess("Loan approved successfully", data);

        } catch (Exception e) {
            Debug.logError(e, "Error approving loan", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }

    public static Map<String, Object> disbursePartyLoan(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        LocalDispatcher dispatcher = dctx.getDispatcher();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String loanId = (String) context.get("loanId");
            Timestamp disbursementDate = (Timestamp) context.get("disbursementDate");
            String createPaymentFlag = (String) context.get("createPaymentFlag");
            String paymentMethodId = (String) context.get("paymentMethodId");
            String paymentMethodTypeId = (String) context.get("paymentMethodTypeId");

            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }
            if (disbursementDate == null) {
                disbursementDate = UtilDateTime.nowTimestamp();
            }

            GenericValue loan = requireLoan(delegator, loanId);

            String previousLoanStatusId = loan.getString("loanStatusId");
            if (LOAN_ACTIVE.equals(previousLoanStatusId)) {
                return ServiceUtil.returnError("Loan is already active: " + loanId);
            }
            if (LOAN_DISB_PENDING.equals(previousLoanStatusId)) {
                return ServiceUtil.returnError("Loan disbursement is already pending: " + loanId);
            }

            Map<String, Object> statusValidation = validateLoanStatus(loan, "disbursePartyLoan", LOAN_APPROVED);
            if (ServiceUtil.isError(statusValidation)) {
                return statusValidation;
            }

            BigDecimal principalAmount = loan.getBigDecimal("principalAmount");
            if (principalAmount == null || principalAmount.compareTo(BigDecimal.ZERO) <= 0) {
                return ServiceUtil.returnError("Loan principalAmount must be greater than zero for disbursement");
            }

            String currencyUomId = loan.getString("currencyUomId");
            if (UtilValidate.isEmpty(currencyUomId)) {
                return ServiceUtil.returnError("Loan currencyUomId is required");
            }

            String organizationPartyId = loan.getString("organizationPartyId");
            String partyId = loan.getString("partyId");
            if (UtilValidate.isEmpty(organizationPartyId) || UtilValidate.isEmpty(partyId)) {
                return ServiceUtil.returnError("Loan organizationPartyId and partyId are required");
            }

            String paymentId = null;
            if ("Y".equalsIgnoreCase(createPaymentFlag)) {
                if (UtilValidate.isEmpty(paymentMethodId) && UtilValidate.isEmpty(paymentMethodTypeId)) {
                    return ServiceUtil.returnError("paymentMethodId or paymentMethodTypeId is required when createPaymentFlag = Y");
                }

                String overrideGlAccountId = resolveLoanDisbursementDebitGlAccountId(
                        delegator,
                        organizationPartyId,
                        disbursementDate);

                Map<String, Object> paymentCtx = new HashMap<String, Object>();
                paymentCtx.put("paymentTypeId", DEFAULT_DISBURSEMENT_PAYMENT_TYPE_ID);
                paymentCtx.put("partyIdFrom", organizationPartyId);
                paymentCtx.put("partyIdTo", partyId);
                paymentCtx.put("amount", principalAmount);
                paymentCtx.put("currencyUomId", currencyUomId);
                paymentCtx.put("effectiveDate", disbursementDate);
                paymentCtx.put("paymentMethodId", paymentMethodId);
                paymentCtx.put("paymentMethodTypeId", paymentMethodTypeId);
                paymentCtx.put("overrideGlAccountId", overrideGlAccountId);
                paymentCtx.put("comments", "Loan disbursement loanId=" + loanId
                        + " debitGlAccountId=" + overrideGlAccountId);
                paymentCtx.put("userLogin", userLogin);

                Map<String, Object> paymentResp = dispatcher.runSync("createPayment", paymentCtx);
                if (ServiceUtil.isError(paymentResp)) {
                    return ServiceUtil.returnError(
                            "Failed to create OFBiz Payment for loan disbursement: "
                                    + ServiceUtil.getErrorMessage(paymentResp));
                }

                paymentId = (String) paymentResp.get("paymentId");
                if (UtilValidate.isEmpty(paymentId)) {
                    return ServiceUtil.returnError("createPayment succeeded but returned no paymentId");
                }

                GenericValue payment = validateExistingPayment(delegator, paymentId);
                if (payment == null) {
                    return ServiceUtil.returnError(
                            "createPayment returned paymentId but Payment record was not found: " + paymentId);
                }
            }

            loan.set("loanStatusId", LOAN_DISB_PENDING);
            loan.set("disbursementDate", disbursementDate);
            if (UtilValidate.isNotEmpty(paymentId) && loan.getModelEntity().isField("disbursementPaymentId")) {
                loan.set("disbursementPaymentId", paymentId);
            }
            if (UtilValidate.isNotEmpty(paymentMethodTypeId) && loan.getModelEntity().isField("disbursementMethodTypeId")) {
                loan.set("disbursementMethodTypeId", paymentMethodTypeId);
            }
            if (loan.getModelEntity().isField("activatedDate")) {
                loan.set("activatedDate", null);
            }
            if (loan.getModelEntity().isField("disbursementAcctgTransId")) {
                loan.set("disbursementAcctgTransId", null);
            }
            loan.store();

            LoanRepaymentServices.createLoanEvent(
                    delegator,
                    loanId,
                    null,
                    null,
                    "LNE_DISBURSE_REQUEST",
                    disbursementDate,
                    userLogin != null ? userLogin.getString("userLoginId") : null,
                    "Loan disbursement initiated"
                            + (UtilValidate.isNotEmpty(paymentId) ? " paymentId=" + paymentId : ""),
                    paymentId
            );

            Map<String, Object> data = new HashMap<String, Object>();
            data.put("loanId", loanId);
            data.put("loanStatusId", LOAN_DISB_PENDING);
            data.put("previousLoanStatusId", previousLoanStatusId);
            data.put("disbursementDate", disbursementDate);
            data.put("disbursementAmount", principalAmount);
            data.put("currencyUomId", currencyUomId);
            data.put("paymentId", paymentId);
            data.put("createPaymentFlag", createPaymentFlag);

            return buildStandardSuccess("Loan disbursement initiated successfully", data);

        } catch (Exception e) {
            Debug.logError(e, "Error disbursing loan", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }

public static Map<String, Object> markLoanDisbursementPaymentSentV1(DispatchContext dctx, Map<String, ?> context) {
    Delegator delegator = dctx.getDelegator();

    try {
        String loanId = (String) context.get("loanId");
        String paymentId = (String) context.get("paymentId");
        String organizationPartyId = (String) context.get("organizationPartyId");

        if (UtilValidate.isEmpty(loanId)) {
            return ServiceUtil.returnError("loanId is required");
        }
        if (UtilValidate.isEmpty(paymentId)) {
            return ServiceUtil.returnError("paymentId is required");
        }
        if (UtilValidate.isEmpty(organizationPartyId)) {
            return ServiceUtil.returnError("organizationPartyId is required");
        }

        // Validate loan
        GenericValue loan = EntityQuery.use(delegator)
                .from("PartyLoan")
                .where("loanId", loanId)
                .queryOne();
        if (loan == null) {
            return ServiceUtil.returnError("Loan not found: " + loanId);
        }

        if (!organizationPartyId.equals(loan.getString("organizationPartyId"))) {
            return ServiceUtil.returnError("organizationPartyId mismatch for loanId: " + loanId);
        }

        // Validate payment belongs to loan
        String disbursementPaymentId = loan.getString("disbursementPaymentId");
        if (UtilValidate.isEmpty(disbursementPaymentId)) {
            return ServiceUtil.returnError("Loan has no disbursementPaymentId: " + loanId);
        }
        if (!paymentId.equals(disbursementPaymentId)) {
            return ServiceUtil.returnError("paymentId does not match loan disbursement payment. loanId="
                    + loanId + ", expected=" + disbursementPaymentId + ", actual=" + paymentId);
        }

        // Load payment
        GenericValue payment = EntityQuery.use(delegator)
                .from("Payment")
                .where("paymentId", paymentId)
                .queryOne();
        if (payment == null) {
            return ServiceUtil.returnError("Payment not found: " + paymentId);
        }

        String currentStatusId = payment.getString("statusId");

        // Already sent
        if ("PMNT_SENT".equals(currentStatusId)) {
            Map<String, Object> result = ServiceUtil.returnSuccess("Payment already marked as sent");
            result.put("loanId", loanId);
            result.put("paymentId", paymentId);
            result.put("statusId", currentStatusId);
            return result;
        }

        // Only allow transition from NOT_PAID
        if (!"PMNT_NOT_PAID".equals(currentStatusId)) {
            return ServiceUtil.returnError("Only PMNT_NOT_PAID can move to PMNT_SENT. paymentId="
                    + paymentId + ", currentStatusId=" + currentStatusId);
        }

        // 🔥 Core action: update status
        payment.set("statusId", "PMNT_SENT");
        payment.store();

        Map<String, Object> result = ServiceUtil.returnSuccess("Payment marked as sent successfully");
        result.put("loanId", loanId);
        result.put("paymentId", paymentId);
        result.put("statusId", "PMNT_SENT");

        return result;

    } catch (Exception e) {
        Debug.logError(e, "Error marking loan disbursement payment as sent", MODULE);
        return ServiceUtil.returnError(e.getMessage());
    }
}

    public static Map<String, Object> finalizeLoanDisbursementV1(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        LocalDispatcher dispatcher = dctx.getDispatcher();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String loanId = (String) context.get("loanId");
            String organizationPartyId = (String) context.get("organizationPartyId");
            String paymentId = trimToNull((String) context.get("paymentId"));
            String acctgTransId = trimToNull((String) context.get("acctgTransId"));

            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }
            if (UtilValidate.isEmpty(organizationPartyId)) {
                return ServiceUtil.returnError("organizationPartyId is required");
            }

            GenericValue loan = requireLoan(delegator, loanId);

            String currentLoanStatusId = loan.getString("loanStatusId");
            if (!LOAN_DISB_PENDING.equals(currentLoanStatusId) && !LOAN_ACTIVE.equals(currentLoanStatusId)) {
                return ServiceUtil.returnError("finalizeLoanDisbursementV1 not allowed for loanId: " + loanId
                        + ". Current status is " + currentLoanStatusId
                        + ", allowed statuses: [" + LOAN_DISB_PENDING + ", " + LOAN_ACTIVE + "]");
            }

            if (!organizationPartyId.equals(loan.getString("organizationPartyId"))) {
                return ServiceUtil.returnError("organizationPartyId mismatch for loanId: " + loanId);
            }

            if (UtilValidate.isEmpty(paymentId)) {
                paymentId = trimToNull(loan.getString("disbursementPaymentId"));
            }
            if (UtilValidate.isEmpty(paymentId)) {
                return ServiceUtil.returnError("paymentId is required");
            }

            GenericValue payment = validateExistingPayment(delegator, paymentId);
            if (payment == null) {
                return ServiceUtil.returnError("Payment not found: " + paymentId);
            }

            String paymentStatusId = payment.getString("statusId");
            if ("PMNT_NOT_PAID".equals(paymentStatusId) || UtilValidate.isEmpty(paymentStatusId)) {
                return ServiceUtil.returnError("Payment is not finalized yet: " + paymentId + " statusId=" + paymentStatusId);
            }

            if (UtilValidate.isEmpty(acctgTransId)) {
                acctgTransId = findAcctgTransIdByPaymentId(delegator, paymentId);
            }

            if (UtilValidate.isEmpty(acctgTransId)) {
                return ServiceUtil.returnError("No accounting transaction found for paymentId: " + paymentId);
            }

            Map<String, Object> completeCtx = new HashMap<String, Object>();
            completeCtx.put("loanId", loanId);
            completeCtx.put("organizationPartyId", organizationPartyId);
            completeCtx.put("paymentId", paymentId);
            completeCtx.put("acctgTransId", acctgTransId);
            completeCtx.put("userLogin", userLogin);

            Map<String, Object> completeResp = dispatcher.runSync("completeLoanDisbursementFromFinance", completeCtx);
            if (ServiceUtil.isError(completeResp)) {
                return ServiceUtil.returnError("Failed to complete loan disbursement: "
                        + ServiceUtil.getErrorMessage(completeResp));
            }

            Map<String, Object> data = new HashMap<String, Object>();
            data.put("loanId", loanId);
            data.put("loanStatusId", completeResp.get("loanStatusId"));
            data.put("paymentId", paymentId);
            data.put("acctgTransId", acctgTransId);
            data.put("previousLoanStatusId", currentLoanStatusId);

            return buildStandardSuccess("Loan disbursement finalized successfully", data);

        } catch (Exception e) {
            Debug.logError(e, "Error finalizing loan disbursement", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }


    public static Map<String, Object> createOrLinkLoanBillingAccountV1(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String loanId = (String) context.get("loanId");
            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }

            GenericValue loan = requireLoan(delegator, loanId);

            String existingBillingAccountId = getLoanBillingAccountId(loan);
            if (UtilValidate.isNotEmpty(existingBillingAccountId)) {
                Map<String, Object> result = ServiceUtil.returnSuccess("Loan billing account already exists");
                result.put("loanId", loanId);
                result.put("billingAccountId", existingBillingAccountId);
                result.put("duplicateSkipped", "Y");
                return result;
            }

            String organizationPartyId = loan.getString("organizationPartyId");
            String borrowerPartyId = loan.getString("partyId");
            String currencyUomId = loan.getString("currencyUomId");
            BigDecimal totalRepayableAmount = loan.getBigDecimal("totalRepayableAmount");
            Timestamp fromDate = firstNonNull(
                    loan.getTimestamp("approvalDate"),
                    loan.getTimestamp("applicationDate"),
                    UtilDateTime.nowTimestamp()
            );
            Timestamp thruDate = loan.getTimestamp("maturityDate");

            if (UtilValidate.isEmpty(organizationPartyId) || UtilValidate.isEmpty(borrowerPartyId)) {
                return ServiceUtil.returnError("Loan organizationPartyId and partyId are required");
            }

            String billingAccountId = delegator.getNextSeqId("BillingAccount");
            GenericValue billingAccount = delegator.makeValue("BillingAccount");
            billingAccount.set("billingAccountId", billingAccountId);

            if (billingAccount.getModelEntity().isField("accountLimit")) {
                billingAccount.set("accountLimit", totalRepayableAmount != null ? totalRepayableAmount : BigDecimal.ZERO);
            }
            if (billingAccount.getModelEntity().isField("accountCurrencyUomId")) {
                billingAccount.set("accountCurrencyUomId", currencyUomId);
            }
            if (billingAccount.getModelEntity().isField("description")) {
                billingAccount.set("description", "Loan billing account for loanId=" + loanId);
            }
            if (billingAccount.getModelEntity().isField("fromDate")) {
                billingAccount.set("fromDate", fromDate);
            }
            if (billingAccount.getModelEntity().isField("thruDate")) {
                billingAccount.set("thruDate", thruDate);
            }
            if (billingAccount.getModelEntity().isField("statusId")) {
                billingAccount.set("statusId", "BA_CREATED");
            }

            delegator.create(billingAccount);

            ensurePartyRoleExists(delegator, borrowerPartyId, "BILL_TO_CUSTOMER");

            GenericValue billingRole = delegator.makeValue("BillingAccountRole");
            billingRole.set("billingAccountId", billingAccountId);
            billingRole.set("partyId", borrowerPartyId);
            billingRole.set("roleTypeId", "BILL_TO_CUSTOMER");
            if (billingRole.getModelEntity().isField("fromDate")) {
                billingRole.set("fromDate", fromDate);
            }
            delegator.create(billingRole);

            if (loan.getModelEntity().isField("billingAccountId")) {
                loan.set("billingAccountId", billingAccountId);
                loan.store();
            }

            Map<String, Object> result = ServiceUtil.returnSuccess("Loan billing account created successfully");
            result.put("loanId", loanId);
            result.put("billingAccountId", billingAccountId);
            result.put("partyId", borrowerPartyId);
            result.put("organizationPartyId", organizationPartyId);
            result.put("createdByUserLoginId", userLogin != null ? userLogin.getString("userLoginId") : null);
            return result;

        } catch (Exception e) {
            Debug.logError(e, "Error creating or linking loan billing account", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }

