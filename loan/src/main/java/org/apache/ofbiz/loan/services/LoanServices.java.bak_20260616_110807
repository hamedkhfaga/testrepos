        Delegator delegator = dctx.getDelegator();

        String organizationPartyId = trimToNull((String) context.get("organizationPartyId"));
        String activeOnly = normalizeFlagDefaultY((String) context.get("activeOnly"));

        try {
            List<Map<String, Object>> methodList = new ArrayList<Map<String, Object>>();
            Timestamp nowTs = UtilDateTime.nowTimestamp();

            if (UtilValidate.isNotEmpty(organizationPartyId) && hasEntity(delegator, "LoanRepaymentMethodConfig")) {
                List<EntityCondition> conds = new ArrayList<EntityCondition>();
                conds.add(EntityCondition.makeCondition("organizationPartyId", organizationPartyId));
                if ("Y".equals(activeOnly)) {
                    conds.add(EntityCondition.makeCondition("isActive", "Y"));
