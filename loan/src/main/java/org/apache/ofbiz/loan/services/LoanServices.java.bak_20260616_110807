    private static Map<String, Object> phase12ValidateUnifiedRepayment(Delegator delegator, GenericValue loan,
            String loanScheduleId, String borrowerPartyId, String repaymentMethodEnumId,
            BigDecimal amountApplied, String externalReference) throws GenericEntityException {
        String loanStatusId = trimToNull(loan.getString("loanStatusId"));
        if (!(LOAN_ACTIVE.equals(loanStatusId) || LOAN_PARTIAL.equals(loanStatusId))) {
            return ServiceUtil.returnError("Loan must be active/partial before repayment. Current status: " + loanStatusId);
        }

        String loanPartyId = trimToNull(loan.getString("partyId"));
        if (UtilValidate.isNotEmpty(borrowerPartyId) && UtilValidate.isNotEmpty(loanPartyId)
                && !borrowerPartyId.equals(loanPartyId)) {
            return ServiceUtil.returnError("borrowerPartyId does not match loan partyId. borrowerPartyId="
                    + borrowerPartyId + ", loan partyId=" + loanPartyId);
        }

        if ("LNPM_PAYROLL".equals(repaymentMethodEnumId) && !"Y".equals(loan.getString("payrollEligibleFlag"))) {
            return ServiceUtil.returnError("Payroll repayment method is not allowed for this loan");
        }

        BigDecimal outstanding = loan.getBigDecimal("outstandingAmount") == null ? BigDecimal.ZERO : loan.getBigDecimal("outstandingAmount");
        if (amountApplied.compareTo(outstanding) > 0 && !"LNPM_SETTLEMENT".equals(repaymentMethodEnumId)) {
            return ServiceUtil.returnError("Repayment amount cannot exceed loan outstanding amount unless settlement method is used");
        }

        if (UtilValidate.isNotEmpty(externalReference)) {
            List<EntityCondition> conds = new ArrayList<EntityCondition>();
            conds.add(EntityCondition.makeCondition("loanId", loan.getString("loanId")));
            conds.add(EntityCondition.makeCondition("externalReference", externalReference));
            conds.add(EntityCondition.makeCondition("repaymentMethodEnumId", repaymentMethodEnumId));
            long count = EntityQuery.use(delegator)
                    .from("PartyLoanRepayment")
                    .where(EntityCondition.makeCondition(conds, EntityOperator.AND))
                    .queryCount();
            if (count > 0) {
                return ServiceUtil.returnError("Duplicate repayment externalReference for loan/method: " + externalReference);
            }
        }

        if (UtilValidate.isNotEmpty(loanScheduleId)) {
            GenericValue schedule = EntityQuery.use(delegator)
                    .from("PartyLoanSchedule")
                    .where("loanScheduleId", loanScheduleId)
                    .queryOne();
            if (schedule == null) {
                return ServiceUtil.returnError("PartyLoanSchedule not found: " + loanScheduleId);
            }
            if (!loan.getString("loanId").equals(schedule.getString("loanId"))) {
                return ServiceUtil.returnError("loanScheduleId does not belong to loanId");
            }
        }

        Map<String, Object> ok = ServiceUtil.returnSuccess();
        ok.put("validated", "Y");
        return ok;
    }

    private static GenericValue phase12FindNextOpenSchedule(Delegator delegator, String loanId) throws GenericEntityException {
        List<String> openStatuses = Arrays.asList("LNS_DUE", "LNS_PENDING", "LNS_PARTIAL");
        return EntityQuery.use(delegator)
                .from("PartyLoanSchedule")
                .where(EntityCondition.makeCondition(
                        EntityCondition.makeCondition("loanId", loanId),
                        EntityOperator.AND,
                        EntityCondition.makeCondition("scheduleStatusId", EntityOperator.IN, openStatuses)))
                .orderBy("dueDate", "installmentSeqNum", "loanScheduleId")
                .queryFirst();
    }

    private static String phase12SourceFromMethod(String repaymentMethodEnumId) {
        if ("LNPM_PAYROLL".equals(repaymentMethodEnumId)) return "LNRS_PAYROLL";
        if ("LNPM_SETTLEMENT".equals(repaymentMethodEnumId)) return "LNRS_MANUAL";
        return "LNRS_MANUAL";
    }

    private static String normalizeFlagDefaultY(String value) {
        if (UtilValidate.isEmpty(value)) return "Y";
        return "Y".equalsIgnoreCase(value) ? "Y" : "N";
    }

    private static String normalizeFlagDefaultN(String value) {
        if (UtilValidate.isEmpty(value)) return "N";
        return "Y".equalsIgnoreCase(value) ? "Y" : "N";
    }

  private static String firstNonEmpty(String... values) {
        if (values == null) {
            return null;
        }

        for (String value : values) {
            if (UtilValidate.isNotEmpty(value)) {
                return value;
            }
        }

        return null;
    }

    private static String userLoginId(GenericValue userLogin) {
