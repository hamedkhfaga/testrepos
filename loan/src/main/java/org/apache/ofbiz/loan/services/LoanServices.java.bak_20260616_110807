    public static Map<String, Object> ensureLoanRepaymentBalancedAccountingV1(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        LocalDispatcher dispatcher = dctx.getDispatcher();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        String loanId = trimToNull((String) context.get("loanId"));
        String loanRepaymentId = trimToNull((String) context.get("loanRepaymentId"));
        String paymentIdFilter = trimToNull((String) context.get("paymentId"));
        String organizationPartyId = trimToNull((String) context.get("organizationPartyId"));
        String dryRun = normalizeFlagDefaultN((String) context.get("dryRun"));

        try {
            if (UtilValidate.isEmpty(loanId) && UtilValidate.isEmpty(loanRepaymentId) && UtilValidate.isEmpty(paymentIdFilter)) {
                return ServiceUtil.returnError("At least one of loanId, loanRepaymentId, paymentId is required");
            }

            List<EntityCondition> conds = new ArrayList<EntityCondition>();
            if (UtilValidate.isNotEmpty(loanId)) conds.add(EntityCondition.makeCondition("loanId", loanId));
            if (UtilValidate.isNotEmpty(loanRepaymentId)) conds.add(EntityCondition.makeCondition("loanRepaymentId", loanRepaymentId));
            if (UtilValidate.isNotEmpty(paymentIdFilter)) conds.add(EntityCondition.makeCondition("paymentId", paymentIdFilter));

            List<GenericValue> repayments = EntityQuery.use(delegator)
                    .from("PartyLoanRepayment")
                    .where(EntityCondition.makeCondition(conds, EntityOperator.AND))
                    .orderBy("loanRepaymentId")
                    .queryList();

            int checkedRepaymentCount = 0;
            int repairedPaymentCount = 0;
            int errorCount = 0;
            List<Map<String, Object>> actions = new ArrayList<Map<String, Object>>();

            for (GenericValue repayment : repayments) {
                checkedRepaymentCount++;
                String currentLoanId = repayment.getString("loanId");
                String currentLoanRepaymentId = repayment.getString("loanRepaymentId");
                String paymentId = trimToNull(repayment.getString("paymentId"));
                BigDecimal amountApplied = repayment.getBigDecimal("amountApplied");
                String sourceEnumId = firstNonEmpty(trimToNull(repayment.getString("repaymentSourceEnumId")), "LNRS_MANUAL");

                Map<String, Object> action = new LinkedHashMap<String, Object>();
                action.put("loanId", currentLoanId);
                action.put("loanRepaymentId", currentLoanRepaymentId);
                action.put("paymentId", paymentId);

                if (UtilValidate.isEmpty(paymentId)) {
                    action.put("status", "SKIPPED");
                    action.put("reason", "Repayment has no paymentId");
                    actions.add(action);
                    continue;
                }

                GenericValue loan = requireLoan(delegator, currentLoanId);
                String resolvedOrgId = firstNonEmpty(organizationPartyId, trimToNull(loan.getString("organizationPartyId")));

                if ("Y".equals(dryRun)) {
                    action.put("status", "DRY_RUN");
                    action.put("reason", "Would ensure PaymentApplication and balanced 3-transaction accounting model");
                    actions.add(action);
                    continue;
                }

                Map<String, Object> appCtx = new HashMap<String, Object>();
                appCtx.put("loanId", currentLoanId);
                appCtx.put("loanRepaymentId", currentLoanRepaymentId);
                appCtx.put("paymentId", paymentId);
                appCtx.put("organizationPartyId", resolvedOrgId);
                appCtx.put("dryRun", "N");
                appCtx.put("createInvoiceIfMissing", "Y");
                appCtx.put("userLogin", userLogin);
                Map<String, Object> appResult = dispatcher.runSync("backfillLoanRepaymentPaymentApplicationV1", appCtx);

                List<Map<String, Object>> accountingResults = new ArrayList<Map<String, Object>>();
                phase12bEnsureIncomingPaymentAccountingSafe(dispatcher, delegator, accountingResults, paymentId, resolvedOrgId, amountApplied, sourceEnumId, null, null, userLogin);
                phase12bEnsureAccountingMarkerSafe(delegator, accountingResults, paymentId, resolvedOrgId, "PAYMENT_APPL", "Payment application accounting transaction");
                phase12bEnsureAccountingMarkerSafe(delegator, accountingResults, paymentId, resolvedOrgId, "PAYMENT_ACCTG_TRANS", "Payment accounting transaction");

                repairedPaymentCount++;
                action.put("status", "DONE");
                action.put("paymentApplicationRepair", appResult);
                action.put("accountingResults", accountingResults);
                actions.add(action);
            }

            Map<String, Object> data = new LinkedHashMap<String, Object>();
            data.put("loanId", loanId);
            data.put("loanRepaymentId", loanRepaymentId);
            data.put("paymentId", paymentIdFilter);
            data.put("organizationPartyId", organizationPartyId);
            data.put("dryRun", dryRun);
            data.put("checkedRepaymentCount", Integer.valueOf(checkedRepaymentCount));
            data.put("repairedPaymentCount", Integer.valueOf(repairedPaymentCount));
            data.put("errorCount", Integer.valueOf(errorCount));
            data.put("actions", actions);

            return buildStandardSuccess("Balanced loan repayment accounting ensured successfully", data);
        } catch (Exception e) {
            Debug.logError(e, "Error ensuring balanced loan repayment accounting", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }


