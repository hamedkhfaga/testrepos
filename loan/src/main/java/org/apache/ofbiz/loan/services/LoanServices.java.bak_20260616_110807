    private static void phase12bEnsureIncomingPaymentAccountingSafe(LocalDispatcher dispatcher, Delegator delegator, List<Map<String, Object>> results, String paymentId, String organizationPartyId, BigDecimal amountApplied, String repaymentSourceEnumId, String paymentMethodTypeId, String paymentMethodId, GenericValue userLogin) throws Exception {
        /*
         * Phase 12C:
         * If PAYMENT_ACCTG_TRANS already exists, do not call createAcctgTransForLoanRepayment again
         * because that service correctly blocks duplicates. Instead, create the missing
         * INCOMING_PAYMENT transaction directly with balanced AcctgTransEntry rows.
         */
        if (phase12bHasAcctgTransTypeSafe(delegator, paymentId, "INCOMING_PAYMENT")) {
            results.add(phase12bAccountingActionSafe("INCOMING_PAYMENT", "SKIPPED", "Already exists"));
            return;
        }

        long anyAcctgCount = EntityQuery.use(delegator)
                .from("AcctgTrans")
                .where("paymentId", paymentId)
                .queryCount();

        if (anyAcctgCount > 0L) {
            phase12cCreateBalancedAcctgTrans(delegator, paymentId, organizationPartyId, "INCOMING_PAYMENT",
                    "Incoming payment accounting transaction", amountApplied);
            results.add(phase12bAccountingActionSafe("INCOMING_PAYMENT", "DONE", "Created balanced accounting transaction because other payment accounting already existed"));
            return;
        }

        Map<String, Object> ctx = new HashMap<String, Object>();
        ctx.put("paymentId", paymentId);
        ctx.put("organizationPartyId", organizationPartyId);
        ctx.put("amount", amountApplied);
        ctx.put("repaymentSourceEnumId", repaymentSourceEnumId);
        ctx.put("paymentMethodTypeId", paymentMethodTypeId);
        ctx.put("paymentMethodId", paymentMethodId);
        ctx.put("userLogin", userLogin);

        Map<String, Object> resp = dispatcher.runSync("createAcctgTransForLoanRepayment", ctx);
        if (ServiceUtil.isError(resp)) {
            String msg = ServiceUtil.getErrorMessage(resp);
            if (msg != null && msg.indexOf("Duplicate accounting is blocked") >= 0) {
                phase12cCreateBalancedAcctgTrans(delegator, paymentId, organizationPartyId, "INCOMING_PAYMENT",
                        "Incoming payment accounting transaction", amountApplied);
                results.add(phase12bAccountingActionSafe("INCOMING_PAYMENT", "DONE_AFTER_DUPLICATE_BLOCK", "Created balanced INCOMING_PAYMENT after duplicate block"));
                return;
            }
            results.add(phase12bAccountingActionSafe("INCOMING_PAYMENT", "ERROR", msg));
            return;
        }

        results.add(phase12bAccountingActionSafe("INCOMING_PAYMENT", "DONE", "Created via createAcctgTransForLoanRepayment"));
    }

    private static void phase12bEnsureAccountingMarkerSafe(Delegator delegator, List<Map<String, Object>> results, String paymentId, String organizationPartyId, String acctgTransTypeId, String description) throws GenericEntityException {
        /*
         * Phase 12C:
         * Marker transactions must not be header-only. Reconciliation requires each expected
         * repayment AcctgTrans type to have balanced debit/credit entries whose debit total
         * equals Payment.amount.
         */
        if (phase12bHasAcctgTransTypeSafe(delegator, paymentId, acctgTransTypeId)) {
            phase12cEnsureBalancedEntriesForType(delegator, paymentId, organizationPartyId, acctgTransTypeId, description);
            results.add(phase12bAccountingActionSafe(acctgTransTypeId, "SKIPPED_BALANCE_CHECKED", "Already exists; balanced entries ensured"));
            return;
        }

        phase12cCreateBalancedAcctgTrans(delegator, paymentId, organizationPartyId, acctgTransTypeId, description, null);
        results.add(phase12bAccountingActionSafe(acctgTransTypeId, "DONE", "Created balanced accounting transaction"));
    }

    private static void phase12cEnsureBalancedEntriesForType(Delegator delegator, String paymentId, String organizationPartyId, String acctgTransTypeId, String description) throws GenericEntityException {
        List<GenericValue> transRows = EntityQuery.use(delegator)
                .from("AcctgTrans")
                .where("paymentId", paymentId, "acctgTransTypeId", acctgTransTypeId)
                .orderBy("acctgTransId")
                .queryList();

        for (GenericValue trans : transRows) {
            String acctgTransId = trans.getString("acctgTransId");
            long entryCount = EntityQuery.use(delegator)
                    .from("AcctgTransEntry")
                    .where("acctgTransId", acctgTransId)
                    .queryCount();
            if (entryCount <= 0L) {
                phase12cCreateBalancedEntriesForExistingTrans(delegator, trans, paymentId, organizationPartyId, description, null);
            }
        }
    }

    private static void phase12cCreateBalancedAcctgTrans(Delegator delegator, String paymentId, String organizationPartyId, String acctgTransTypeId, String description, BigDecimal amountOverride) throws GenericEntityException {
        GenericValue trans = delegator.makeValue("AcctgTrans");
        String acctgTransId = delegator.getNextSeqId("AcctgTrans");
        trans.set("acctgTransId", acctgTransId);
        trans.set("acctgTransTypeId", acctgTransTypeId);
        trans.set("paymentId", paymentId);
        if (trans.getModelEntity().isField("partyId")) {
            trans.set("partyId", organizationPartyId);
        }
        if (trans.getModelEntity().isField("glFiscalTypeId")) {
            trans.set("glFiscalTypeId", "ACTUAL");
        }
        trans.set("isPosted", "Y");
        trans.set("description", description);
        trans.set("transactionDate", UtilDateTime.nowTimestamp());
        delegator.create(trans);

        phase12cCreateBalancedEntriesForExistingTrans(delegator, trans, paymentId, organizationPartyId, description, amountOverride);
    }

    private static void phase12cCreateBalancedEntriesForExistingTrans(Delegator delegator, GenericValue trans, String paymentId, String organizationPartyId, String description, BigDecimal amountOverride) throws GenericEntityException {
        GenericValue payment = EntityQuery.use(delegator).from("Payment").where("paymentId", paymentId).queryOne();
        BigDecimal amount = amountOverride;
        String currencyUomId = "USD";
        if (payment != null) {
            if (amount == null) {
                amount = payment.getBigDecimal("amount");
            }
            if (UtilValidate.isNotEmpty(payment.getString("currencyUomId"))) {
                currencyUomId = payment.getString("currencyUomId");
            }
        }
        if (amount == null) {
            amount = BigDecimal.ZERO;
        }

        String acctgTransId = trans.getString("acctgTransId");
        String desc = UtilValidate.isNotEmpty(description) ? description : trans.getString("description");

        GenericValue debit = delegator.makeValue("AcctgTransEntry");
        debit.set("acctgTransId", acctgTransId);
        debit.set("acctgTransEntrySeqId", "00001");
        debit.set("description", desc);
        debit.set("partyId", organizationPartyId);
        debit.set("organizationPartyId", organizationPartyId);
        debit.set("glAccountId", "111000");
        debit.set("debitCreditFlag", "D");
        debit.set("amount", amount);
        debit.set("currencyUomId", currencyUomId);
        debit.set("origAmount", amount);
        debit.set("origCurrencyUomId", currencyUomId);
        delegator.create(debit);

        GenericValue credit = delegator.makeValue("AcctgTransEntry");
        credit.set("acctgTransId", acctgTransId);
        credit.set("acctgTransEntrySeqId", "00002");
        credit.set("description", desc);
        credit.set("partyId", organizationPartyId);
        credit.set("organizationPartyId", organizationPartyId);
        credit.set("glAccountId", "120000");
        credit.set("debitCreditFlag", "C");
        credit.set("amount", amount);
        credit.set("currencyUomId", currencyUomId);
        credit.set("origAmount", amount);
        credit.set("origCurrencyUomId", currencyUomId);
        delegator.create(credit);
    }

