    private static Map<String, Object> phase13ResolveRepaymentMethodConfig(Delegator delegator, String organizationPartyId, String repaymentMethodEnumId) throws GenericEntityException {
        Map<String, Object> cfg = new LinkedHashMap<String, Object>();
        cfg.put("repaymentMethodEnumId", repaymentMethodEnumId);
        cfg.put("mappingSource", "DEFAULT");

        if (UtilValidate.isNotEmpty(organizationPartyId) && UtilValidate.isNotEmpty(repaymentMethodEnumId) && hasEntity(delegator, "LoanRepaymentMethodConfig")) {
            List<GenericValue> rows = EntityQuery.use(delegator)
                    .from("LoanRepaymentMethodConfig")
                    .where("organizationPartyId", organizationPartyId, "repaymentMethodEnumId", repaymentMethodEnumId, "isActive", "Y")
                    .orderBy("-fromDate", "-loanRepaymentMethodConfigId")
                    .queryList();
            Timestamp nowTs = UtilDateTime.nowTimestamp();
            for (GenericValue row : rows) {
                Timestamp fromDate = row.getTimestamp("fromDate");
                Timestamp thruDate = row.getTimestamp("thruDate");
                if (fromDate != null && fromDate.after(nowTs)) {
                    continue;
                }
                if (thruDate != null && !thruDate.after(nowTs)) {
                    continue;
                }
                cfg.put("paymentMethodTypeId", trimToNull(row.getString("paymentMethodTypeId")));
                cfg.put("paymentMethodId", trimToNull(row.getString("paymentMethodId")));
                cfg.put("finAccountId", trimToNull(row.getString("finAccountId")));
                cfg.put("requiresExternalReference", phase13NormalizeFlag(row.getString("requiresExternalReference")));
                cfg.put("requiresBankReference", phase13NormalizeFlag(row.getString("requiresBankReference")));
                cfg.put("requiresReceivedByUser", phase13NormalizeFlag(row.getString("requiresReceivedByUser")));
                cfg.put("isPayrollMethod", phase13NormalizeFlag(row.getString("isPayrollMethod")));
                cfg.put("mappingSource", "CONFIG");
                return cfg;
            }
        }

        String paymentMethodTypeId = null;
        String requiresExternalReference = "N";
        String requiresBankReference = "N";
        String requiresReceivedByUser = "N";
        String isPayrollMethod = "N";

        if ("LNPM_CASH".equals(repaymentMethodEnumId) || "LNPM_MANUAL".equals(repaymentMethodEnumId)) {
            paymentMethodTypeId = "CASH";
            requiresReceivedByUser = "Y";
        } else if ("LNPM_BANK_TRANSFER".equals(repaymentMethodEnumId)) {
            paymentMethodTypeId = "EFT_ACCOUNT";
            requiresExternalReference = "Y";
            requiresBankReference = "Y";
        } else if ("LNPM_CHECK".equals(repaymentMethodEnumId)) {
            paymentMethodTypeId = "COMPANY_CHECK";
            requiresExternalReference = "Y";
        } else if ("LNPM_CARD".equals(repaymentMethodEnumId)) {
            paymentMethodTypeId = "CREDIT_CARD";
            requiresExternalReference = "Y";
        } else if ("LNPM_MOBILE_WALLET".equals(repaymentMethodEnumId)) {
            paymentMethodTypeId = "FIN_ACCOUNT";
            requiresExternalReference = "Y";
            requiresBankReference = "Y";
        } else if ("LNPM_DIRECT_DEBIT".equals(repaymentMethodEnumId)) {
            paymentMethodTypeId = "EFT_ACCOUNT";
            requiresExternalReference = "Y";
            requiresBankReference = "Y";
        } else if ("LNPM_PAYROLL".equals(repaymentMethodEnumId)) {
            isPayrollMethod = "Y";
        }

        cfg.put("paymentMethodTypeId", paymentMethodTypeId);
        cfg.put("paymentMethodId", null);
        cfg.put("finAccountId", null);
        cfg.put("requiresExternalReference", requiresExternalReference);
        cfg.put("requiresBankReference", requiresBankReference);
        cfg.put("requiresReceivedByUser", requiresReceivedByUser);
        cfg.put("isPayrollMethod", isPayrollMethod);
        return cfg;
    }

    private static void phase13ValidateRepaymentMethodRequirements(Map<String, Object> cfg, String externalReference, String bankReference, GenericValue userLogin) {
        String method = (String) cfg.get("repaymentMethodEnumId");
