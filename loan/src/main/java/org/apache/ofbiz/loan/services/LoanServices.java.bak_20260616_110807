    private static String resolveLoanDisbursementDebitGlAccountId(Delegator delegator,
                                                                  String organizationPartyId,
                                                                  Timestamp whenTs) throws GenericEntityException {
        if (UtilValidate.isEmpty(organizationPartyId)) {
            throw new GenericEntityException("organizationPartyId is required to resolve loan disbursement debit GL");
        }
        if (whenTs == null) {
            whenTs = UtilDateTime.nowTimestamp();
        }

        GenericValue header = EntityQuery.use(delegator)
                .from("LoanAcctgCfg")
                .where("organizationPartyId", organizationPartyId, "isActive", "Y")
                .orderBy("-fromDate")
                .queryFirst();
        if (header == null) {
            throw new GenericEntityException("No active LoanAcctgCfg found for organizationPartyId=" + organizationPartyId);
        }

        Timestamp fromDate = header.getTimestamp("fromDate");
        Timestamp thruDate = header.getTimestamp("thruDate");
        if (fromDate != null && fromDate.after(whenTs)) {
            throw new GenericEntityException("LoanAcctgCfg is not yet active for organizationPartyId=" + organizationPartyId);
        }
        if (thruDate != null && !thruDate.after(whenTs)) {
            throw new GenericEntityException("LoanAcctgCfg is expired for organizationPartyId=" + organizationPartyId);
        }

        GenericValue detail = EntityQuery.use(delegator)
                .from("LoanAcctgCfgDtl")
                .where("loanAcctgCfgId", header.getString("loanAcctgCfgId"),
                        "repaymentSourceEnumId", DISBURSEMENT_CFG_ENUM_ID)
                .queryOne();
        if (detail == null) {
            throw new GenericEntityException("No LoanAcctgCfgDtl found for loanAcctgCfgId="
                    + header.getString("loanAcctgCfgId")
                    + " and repaymentSourceEnumId=" + DISBURSEMENT_CFG_ENUM_ID);
        }

        String debitGlAccountId = trimToNull(detail.getString("debitGlAccountId"));
        if (UtilValidate.isEmpty(debitGlAccountId)) {
            throw new GenericEntityException("debitGlAccountId is empty in LoanAcctgCfgDtl for "
                    + DISBURSEMENT_CFG_ENUM_ID);
        }

        requireActiveGlAccountForOrganization(delegator, debitGlAccountId, organizationPartyId, "debitGlAccountId");
        return debitGlAccountId;
    }

    private static void requireActiveGlAccountForOrganization(Delegator delegator,
                                                              String glAccountId,
                                                              String organizationPartyId,
                                                              String fieldName) throws GenericEntityException {
        if (UtilValidate.isEmpty(glAccountId)) {
            throw new GenericEntityException(fieldName + " is empty");
        }

        GenericValue gl = EntityQuery.use(delegator)
                .from("GlAccount")
                .where("glAccountId", glAccountId)
                .queryOne();
        if (gl == null) {
            throw new GenericEntityException(fieldName + " not found in GlAccount: " + glAccountId);
        }

        GenericValue orgLink = EntityQuery.use(delegator)
                .from("GlAccountOrganization")
                .where("glAccountId", glAccountId, "organizationPartyId", organizationPartyId)
                .filterByDate()
                .queryFirst();
        if (orgLink == null) {
            throw new GenericEntityException(fieldName + " is not active for organizationPartyId="
                    + organizationPartyId + ": " + glAccountId);
        }
    }

