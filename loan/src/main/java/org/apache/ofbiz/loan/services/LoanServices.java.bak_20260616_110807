    /**
     * Phase 13B - Disbursement Finance Orchestration.
     *
     * Loan remains business owner; finance/accounting owns accounting rows.
     * This service orchestrates:
     * 1) create disbursement accounting if missing
     * 2) post the accounting transaction
     * 3) finalize the loan disbursement
     */
    public static Map<String, Object> orchestrateLoanDisbursementFinanceV1(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        LocalDispatcher dispatcher = dctx.getDispatcher();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String organizationPartyId = trimToNull((String) context.get("organizationPartyId"));
            String loanId = trimToNull((String) context.get("loanId"));
            String paymentId = trimToNull((String) context.get("paymentId"));
            String acctgTransId = trimToNull((String) context.get("acctgTransId"));
            String dryRun = normalizeFlagDefaultN((String) context.get("dryRun"));

            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }

            GenericValue loan = requireLoan(delegator, loanId);
            organizationPartyId = firstNonEmpty(organizationPartyId, trimToNull(loan.getString("organizationPartyId")));
            paymentId = firstNonEmpty(paymentId, trimToNull(loan.getString("disbursementPaymentId")));

            if (UtilValidate.isEmpty(organizationPartyId)) {
                return ServiceUtil.returnError("organizationPartyId is required");
            }
            if (UtilValidate.isEmpty(paymentId)) {
                return ServiceUtil.returnError("paymentId is required or must exist on PartyLoan.disbursementPaymentId");
            }
            if (!organizationPartyId.equals(loan.getString("organizationPartyId"))) {
                return ServiceUtil.returnError("organizationPartyId mismatch for loanId: " + loanId);
            }

            GenericValue payment = validateExistingPayment(delegator, paymentId);
            if (payment == null) {
                return ServiceUtil.returnError("Payment not found: " + paymentId);
            }

            String paymentStatusId = trimToNull(payment.getString("statusId"));
            if ("PMNT_NOT_PAID".equals(paymentStatusId) || UtilValidate.isEmpty(paymentStatusId)) {
                return ServiceUtil.returnError("Payment must be sent/finalized before disbursement finance orchestration. paymentId="
                        + paymentId + ", statusId=" + paymentStatusId);
            }

            BigDecimal amount = loan.getBigDecimal("principalAmount");
            String currencyUomId = firstNonEmpty(trimToNull(loan.getString("currencyUomId")), trimToNull(payment.getString("currencyUomId")));

            Map<String, Object> data = new LinkedHashMap<String, Object>();
            data.put("organizationPartyId", organizationPartyId);
            data.put("loanId", loanId);
            data.put("paymentId", paymentId);
            data.put("paymentStatusId", paymentStatusId);
            data.put("amount", amount);
            data.put("currencyUomId", currencyUomId);
            data.put("dryRun", dryRun);

            if (UtilValidate.isEmpty(acctgTransId)) {
                acctgTransId = findAcctgTransIdByPaymentId(delegator, paymentId);
            }

            Map<String, Object> createAcctgResult = null;
            if (UtilValidate.isEmpty(acctgTransId)) {
                if ("Y".equals(dryRun)) {
                    data.put("wouldCreateAcctgTrans", "Y");
                } else {
                    Map<String, Object> acctgCtx = new HashMap<String, Object>();
                    acctgCtx.put("organizationPartyId", organizationPartyId);
                    acctgCtx.put("loanId", loanId);
                    acctgCtx.put("paymentId", paymentId);
                    acctgCtx.put("amount", amount);
                    acctgCtx.put("currencyUomId", currencyUomId);
                    acctgCtx.put("userLogin", userLogin);

                    createAcctgResult = dispatcher.runSync("createAcctgTransForLoanDisbursementV1", acctgCtx);
                    if (ServiceUtil.isError(createAcctgResult)) {
                        return ServiceUtil.returnError("Failed to create disbursement accounting: "
                                + ServiceUtil.getErrorMessage(createAcctgResult));
                    }

                    acctgTransId = trimToNull((String) createAcctgResult.get("acctgTransId"));
                    if (UtilValidate.isEmpty(acctgTransId) && createAcctgResult.get("data") instanceof Map) {
                        acctgTransId = trimToNull((String) ((Map) createAcctgResult.get("data")).get("acctgTransId"));
                    }
                    if (UtilValidate.isEmpty(acctgTransId)) {
                        acctgTransId = findAcctgTransIdByPaymentId(delegator, paymentId);
                    }
                    if (UtilValidate.isEmpty(acctgTransId)) {
                        return ServiceUtil.returnError("Disbursement accounting was created but acctgTransId could not be resolved for paymentId: " + paymentId);
                    }
                }
            } else {
                data.put("existingAcctgTransId", acctgTransId);
            }

            Map<String, Object> postResult = null;
            if (UtilValidate.isNotEmpty(acctgTransId)) {
                GenericValue acctgTrans = EntityQuery.use(delegator)
                        .from("AcctgTrans")
                        .where("acctgTransId", acctgTransId)
                        .queryOne();
                if (acctgTrans == null) {
                    return ServiceUtil.returnError("AcctgTrans not found: " + acctgTransId);
                }
                if (!paymentId.equals(trimToNull(acctgTrans.getString("paymentId")))) {
                    return ServiceUtil.returnError("AcctgTrans paymentId mismatch. acctgTransId="
                            + acctgTransId + ", expected paymentId=" + paymentId
                            + ", actual paymentId=" + acctgTrans.getString("paymentId"));
                }

                String isPosted = trimToNull(acctgTrans.getString("isPosted"));
                if (!"Y".equals(isPosted)) {
                    if ("Y".equals(dryRun)) {
                        data.put("wouldPostAcctgTrans", "Y");
                    } else {
                        postResult = phase13bPostAcctgTrans(dispatcher, delegator, acctgTransId, userLogin);
                        if (ServiceUtil.isError(postResult)) {
                            return ServiceUtil.returnError("Failed to post disbursement accounting: "
                                    + ServiceUtil.getErrorMessage(postResult));
                        }
                    }
                } else {
                    data.put("alreadyPosted", "Y");
                }
            }

            data.put("acctgTransId", acctgTransId);
            data.put("createAcctgResult", createAcctgResult);
            data.put("postResult", postResult);
            data.put("nextAction", "CALL_FINALIZE_LOAN_DISBURSEMENT");
            data.put("nextServiceName", "finalizeLoanDisbursementV1");
            data.put("nextOrganizationPartyId", organizationPartyId);
            data.put("nextLoanId", loanId);
            data.put("nextPaymentId", paymentId);
            data.put("nextAcctgTransId", acctgTransId);

            if ("Y".equals(dryRun)) {
                data.put("finalStatus", "DRY_RUN");
                return buildStandardSuccess("Loan disbursement finance orchestration dry-run completed successfully", data);
            }

            data.put("finalStatus", "DISBURSEMENT_ACCOUNTING_POSTED");
            return buildStandardSuccess("Loan disbursement accounting created/posted successfully; call finalizeLoanDisbursementV1 next", data);
        } catch (Exception e) {
            Debug.logError(e, "Error orchestrating loan disbursement finance", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }

    private static Map<String, Object> phase13bPostAcctgTrans(LocalDispatcher dispatcher, Delegator delegator, String acctgTransId, GenericValue userLogin) throws Exception {
        Map<String, Object> postCtx = new HashMap<String, Object>();
        postCtx.put("acctgTransId", acctgTransId);
        postCtx.put("userLogin", userLogin);

        try {
            Map<String, Object> serviceResult = dispatcher.runSync("postAcctgTrans", postCtx);
            if (!ServiceUtil.isError(serviceResult)) {
                return serviceResult;
            }
        } catch (Exception ignored) {
            // Fallback below for demo/local setups where the OFBiz posting service is not exposed/registered as expected.
        }

        GenericValue acctgTrans = EntityQuery.use(delegator)
                .from("AcctgTrans")
                .where("acctgTransId", acctgTransId)
                .queryOne();
        if (acctgTrans == null) {
            return ServiceUtil.returnError("AcctgTrans not found: " + acctgTransId);
        }
        acctgTrans.set("isPosted", "Y");
        if (acctgTrans.getModelEntity().isField("postedDate")) {
            acctgTrans.set("postedDate", UtilDateTime.nowTimestamp());
        }
        acctgTrans.store();

        Map<String, Object> out = ServiceUtil.returnSuccess("AcctgTrans posted by Phase 13B fallback update");
        out.put("acctgTransId", acctgTransId);
        out.put("postingStrategy", "FALLBACK_UPDATE");
        return out;
    }


    public static Map<String, Object> orchestrateLoanRepaymentAccountingV1(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        LocalDispatcher dispatcher = dctx.getDispatcher();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String organizationPartyId = trimToNull((String) context.get("organizationPartyId"));
            String loanId = trimToNull((String) context.get("loanId"));
            String loanRepaymentId = trimToNull((String) context.get("loanRepaymentId"));
            String paymentId = trimToNull((String) context.get("paymentId"));
            String repaymentSourceEnumId = trimToNull((String) context.get("repaymentSourceEnumId"));
            String dryRun = normalizeFlagDefaultN((String) context.get("dryRun"));

            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }

            GenericValue loan = requireLoan(delegator, loanId);
            organizationPartyId = firstNonEmpty(organizationPartyId, trimToNull(loan.getString("organizationPartyId")));
            if (UtilValidate.isEmpty(organizationPartyId)) {
                return ServiceUtil.returnError("organizationPartyId is required");
            }
            if (!organizationPartyId.equals(loan.getString("organizationPartyId"))) {
                return ServiceUtil.returnError("organizationPartyId mismatch for loanId: " + loanId);
            }

            GenericValue repayment = null;
            if (UtilValidate.isNotEmpty(loanRepaymentId)) {
                repayment = EntityQuery.use(delegator).from("PartyLoanRepayment").where("loanRepaymentId", loanRepaymentId).queryOne();
                if (repayment == null) {
                    return ServiceUtil.returnError("PartyLoanRepayment not found: " + loanRepaymentId);
                }
                if (!loanId.equals(trimToNull(repayment.getString("loanId")))) {
                    return ServiceUtil.returnError("loanRepaymentId does not belong to loanId. loanRepaymentId=" + loanRepaymentId);
                }
                paymentId = firstNonEmpty(paymentId, trimToNull(repayment.getString("paymentId")));
                repaymentSourceEnumId = firstNonEmpty(repaymentSourceEnumId, trimToNull(repayment.getString("repaymentSourceEnumId")));
            } else if (UtilValidate.isEmpty(paymentId)) {
                return ServiceUtil.returnError("loanRepaymentId or paymentId is required");
            }

            if (UtilValidate.isEmpty(paymentId)) {
                return ServiceUtil.returnError("paymentId is required or must exist on PartyLoanRepayment");
            }
            if (UtilValidate.isEmpty(repaymentSourceEnumId)) {
                repaymentSourceEnumId = "LNRS_MANUAL";
            }

            GenericValue payment = validateExistingPayment(delegator, paymentId);
            if (payment == null) {
                return ServiceUtil.returnError("Payment not found: " + paymentId);
            }

            BigDecimal amount = (BigDecimal) context.get("amount");
            if (amount == null || amount.compareTo(BigDecimal.ZERO) <= 0) {
                amount = payment.getBigDecimal("amount");
            }
            if ((amount == null || amount.compareTo(BigDecimal.ZERO) <= 0) && repayment != null) {
                amount = repayment.getBigDecimal("amountApplied");
            }
            if (amount == null || amount.compareTo(BigDecimal.ZERO) <= 0) {
                return ServiceUtil.returnError("amount is required or must be resolvable from Payment/PartyLoanRepayment");
            }

            List<GenericValue> beforeRows = EntityQuery.use(delegator).from("AcctgTrans").where("paymentId", paymentId).queryList();
            boolean beforePaymentAcctg = false;
            boolean beforeIncoming = false;
            boolean beforeAppl = false;
            for (GenericValue row : beforeRows) {
                String type = trimToNull(row.getString("acctgTransTypeId"));
                if ("PAYMENT_ACCTG_TRANS".equals(type)) beforePaymentAcctg = true;
                if ("INCOMING_PAYMENT".equals(type)) beforeIncoming = true;
                if ("PAYMENT_APPL".equals(type)) beforeAppl = true;
            }

            Map<String, Object> data = new LinkedHashMap<String, Object>();
            data.put("organizationPartyId", organizationPartyId);
            data.put("loanId", loanId);
            data.put("loanRepaymentId", loanRepaymentId);
            data.put("paymentId", paymentId);
            data.put("repaymentSourceEnumId", repaymentSourceEnumId);
            data.put("amount", amount);
            data.put("dryRun", dryRun);
            data.put("beforeAcctgTransCount", Integer.valueOf(beforeRows.size()));
            data.put("beforeHasPaymentAcctgTrans", Boolean.valueOf(beforePaymentAcctg));
            data.put("beforeHasIncomingPaymentTrans", Boolean.valueOf(beforeIncoming));
            data.put("beforeHasPaymentApplicationTrans", Boolean.valueOf(beforeAppl));

            boolean completeBefore = beforePaymentAcctg && beforeIncoming && beforeAppl;
            Map<String, Object> repairResult = null;

            if (!completeBefore) {
                if ("Y".equals(dryRun)) {
                    data.put("wouldRepairMissing3TxnModel", "Y");
                } else {
                    Map<String, Object> repairCtx = new HashMap<String, Object>();
                    repairCtx.put("organizationPartyId", organizationPartyId);
                    repairCtx.put("loanId", loanId);
                    repairCtx.put("loanRepaymentId", loanRepaymentId);
                    repairCtx.put("paymentId", paymentId);
                    repairCtx.put("dryRun", "N");
                    repairCtx.put("createFinAccountTrans", "N");
                    repairCtx.put("userLogin", userLogin);

                    repairResult = dispatcher.runSync("backfillLoanRepaymentAccountingV1", repairCtx);
                    if (ServiceUtil.isError(repairResult)) {
                        return ServiceUtil.returnError("Failed to complete repayment 3-transaction accounting model: " + ServiceUtil.getErrorMessage(repairResult));
                    }
                }
            }

            List<GenericValue> afterRows = EntityQuery.use(delegator).from("AcctgTrans").where("paymentId", paymentId).orderBy("acctgTransId").queryList();
            boolean afterPaymentAcctg = false;
            boolean afterIncoming = false;
            boolean afterAppl = false;
            String acctgTransId = null;
            String paymentAcctgTransId = null;
            String incomingPaymentAcctgTransId = null;
            String paymentApplicationAcctgTransId = null;

            for (GenericValue row : afterRows) {
                if (UtilValidate.isEmpty(acctgTransId)) acctgTransId = row.getString("acctgTransId");
                String type = trimToNull(row.getString("acctgTransTypeId"));
                if ("PAYMENT_ACCTG_TRANS".equals(type)) {
                    afterPaymentAcctg = true;
                    paymentAcctgTransId = row.getString("acctgTransId");
                }
                if ("INCOMING_PAYMENT".equals(type)) {
                    afterIncoming = true;
                    incomingPaymentAcctgTransId = row.getString("acctgTransId");
                }
                if ("PAYMENT_APPL".equals(type)) {
                    afterAppl = true;
                    paymentApplicationAcctgTransId = row.getString("acctgTransId");
                }
            }

            boolean completeAfter = afterPaymentAcctg && afterIncoming && afterAppl;

            data.put("repairResult", repairResult);
            data.put("afterAcctgTransCount", Integer.valueOf(afterRows.size()));
            data.put("afterHasPaymentAcctgTrans", Boolean.valueOf(afterPaymentAcctg));
            data.put("afterHasIncomingPaymentTrans", Boolean.valueOf(afterIncoming));
            data.put("afterHasPaymentApplicationTrans", Boolean.valueOf(afterAppl));
            data.put("paymentAcctgTransId", paymentAcctgTransId);
            data.put("incomingPaymentAcctgTransId", incomingPaymentAcctgTransId);
            data.put("paymentApplicationAcctgTransId", paymentApplicationAcctgTransId);
            data.put("acctgTransId", acctgTransId);
            data.put("nextAction", "CALL_RECONCILE_LOAN_ACCOUNTING");
            data.put("nextServiceName", "reconcileLoanAccountingV1");
            data.put("nextOrganizationPartyId", organizationPartyId);
            data.put("nextLoanId", loanId);
            data.put("nextPaymentId", paymentId);
            data.put("nextLoanRepaymentId", loanRepaymentId);
            data.put("nextAcctgTransId", acctgTransId);

            if ("Y".equals(dryRun)) {
                data.put("finalStatus", "DRY_RUN");
                return buildStandardSuccess("Loan repayment accounting orchestration dry-run completed successfully", data);
            }

            if (!completeAfter) {
                data.put("finalStatus", "REPAYMENT_ACCOUNTING_INCOMPLETE");
                return ServiceUtil.returnError("Repayment payment still does not have the complete accepted 3-transaction accounting model after orchestration. paymentId=" + paymentId);
            }

            data.put("finalStatus", completeBefore ? "REPAYMENT_ACCOUNTING_ALREADY_COMPLETE" : "REPAYMENT_ACCOUNTING_COMPLETED_3TXN_MODEL");
            return buildStandardSuccess("Loan repayment accounting 3-transaction model completed; call reconcileLoanAccountingV1 next", data);
        } catch (Exception e) {
            Debug.logError(e, "Error orchestrating loan repayment accounting", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }

