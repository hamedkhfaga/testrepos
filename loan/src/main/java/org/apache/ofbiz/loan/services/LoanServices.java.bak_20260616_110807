                methodList.add(phase13MethodOption("LNPM_CASH", "CASH", null, null, "N", "N", "Y", "N", "Cash", "DEFAULT"));
                methodList.add(phase13MethodOption("LNPM_BANK_TRANSFER", "EFT_ACCOUNT", null, null, "Y", "Y", "N", "N", "Bank Transfer", "DEFAULT"));
