    public static Map<String, Object> completeUnifiedLoanRepaymentFinancialsV1(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        LocalDispatcher dispatcher = dctx.getDispatcher();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String organizationPartyId = trimToNull((String) context.get("organizationPartyId"));
            String loanId = trimToNull((String) context.get("loanId"));
            String loanScheduleId = trimToNull((String) context.get("loanScheduleId"));
            String loanRepaymentId = trimToNull((String) context.get("loanRepaymentId"));
            String paymentId = trimToNull((String) context.get("paymentId"));
            String repaymentSourceEnumId = firstNonEmpty(trimToNull((String) context.get("repaymentSourceEnumId")), "LNRS_MANUAL");
            String repaymentMethodEnumId = trimToNull((String) context.get("repaymentMethodEnumId"));
            BigDecimal amountApplied = (BigDecimal) context.get("amountApplied");
            String paymentMethodTypeId = trimToNull((String) context.get("paymentMethodTypeId"));
            String paymentMethodId = trimToNull((String) context.get("paymentMethodId"));
            String dryRun = normalizeFlagDefaultN((String) context.get("dryRun"));

            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }

            GenericValue loan = requireLoan(delegator, loanId);
            organizationPartyId = firstNonEmpty(organizationPartyId, trimToNull(loan.getString("organizationPartyId")));

            GenericValue repayment = null;
            if (UtilValidate.isNotEmpty(loanRepaymentId)) {
                repayment = EntityQuery.use(delegator).from("PartyLoanRepayment").where("loanRepaymentId", loanRepaymentId).queryOne();
            }
            if (repayment != null) {
                loanScheduleId = firstNonEmpty(loanScheduleId, trimToNull(repayment.getString("loanScheduleId")));
                paymentId = firstNonEmpty(paymentId, trimToNull(repayment.getString("paymentId")));
                repaymentSourceEnumId = firstNonEmpty(repaymentSourceEnumId, trimToNull(repayment.getString("repaymentSourceEnumId")));
                if (amountApplied == null) {
                    amountApplied = repayment.getBigDecimal("amountApplied");
                }
            }

            if (UtilValidate.isEmpty(paymentId)) return ServiceUtil.returnError("paymentId is required or must be present on PartyLoanRepayment");
            if (amountApplied == null || amountApplied.compareTo(BigDecimal.ZERO) <= 0) return ServiceUtil.returnError("amountApplied must be greater than zero");

            GenericValue payment = EntityQuery.use(delegator).from("Payment").where("paymentId", paymentId).queryOne();
            if (payment == null) return ServiceUtil.returnError("Payment not found: " + paymentId);

            Map<String, Object> data = new LinkedHashMap<String, Object>();
            data.put("organizationPartyId", organizationPartyId);
            data.put("loanId", loanId);
            data.put("loanScheduleId", loanScheduleId);
            data.put("loanRepaymentId", loanRepaymentId);
            data.put("paymentId", paymentId);
            data.put("amountApplied", amountApplied);
            data.put("repaymentSourceEnumId", repaymentSourceEnumId);
            data.put("repaymentMethodEnumId", repaymentMethodEnumId);
            data.put("dryRun", dryRun);

            if ("Y".equals(dryRun)) {
                data.put("wouldCreateInvoice", Boolean.TRUE);
                data.put("wouldCreatePaymentApplication", Boolean.TRUE);
                data.put("wouldCreateAccounting", Boolean.TRUE);
                data.put("finalStatus", "DRY_RUN");
                return buildStandardSuccess("Unified repayment financial completion dry-run completed successfully", data);
            }

            String invoiceId = phase12bFindExistingPaymentInvoice(delegator, paymentId);
            Map<String, Object> invoiceResp = null;
            if (UtilValidate.isEmpty(invoiceId)) {
                Map<String, Object> invoiceCtx = new HashMap<String, Object>();
                invoiceCtx.put("loanId", loanId);
                invoiceCtx.put("loanScheduleId", loanScheduleId);
                invoiceCtx.put("organizationPartyId", organizationPartyId);
                invoiceCtx.put("invoiceDate", UtilDateTime.nowTimestamp());
                invoiceCtx.put("userLogin", userLogin);
                invoiceResp = dispatcher.runSync("generateDueLoanRepaymentInvoiceV1", invoiceCtx);
                if (ServiceUtil.isError(invoiceResp)) {
                    return ServiceUtil.returnError("Repayment invoice generation failed. " + ServiceUtil.getErrorMessage(invoiceResp));
                }
                invoiceId = trimToNull((String) invoiceResp.get("invoiceId"));
                if (UtilValidate.isEmpty(invoiceId) && invoiceResp.get("data") instanceof Map) {
                    invoiceId = trimToNull((String) ((Map) invoiceResp.get("data")).get("invoiceId"));
                }
            }
            if (UtilValidate.isEmpty(invoiceId)) return ServiceUtil.returnError("Could not resolve/create repayment invoiceId");

            String paymentApplicationId = phase12bFindExistingPaymentApplication(delegator, paymentId, invoiceId);
            Map<String, Object> applicationResp = null;
            if (UtilValidate.isEmpty(paymentApplicationId)) {
                applicationResp = phase12bCreatePaymentApplication(dispatcher, delegator, paymentId, invoiceId, amountApplied, userLogin);
                if (ServiceUtil.isError(applicationResp)) {
                    return ServiceUtil.returnError("PaymentApplication creation failed. " + ServiceUtil.getErrorMessage(applicationResp));
                }
                paymentApplicationId = trimToNull((String) applicationResp.get("paymentApplicationId"));
                if (UtilValidate.isEmpty(paymentApplicationId) && applicationResp.get("data") instanceof Map) {
                    paymentApplicationId = trimToNull((String) ((Map) applicationResp.get("data")).get("paymentApplicationId"));
                }
            }

            List<Map<String, Object>> accountingResults = new ArrayList<Map<String, Object>>();
            phase12bEnsureIncomingPaymentAccounting(dispatcher, delegator, accountingResults, paymentId, organizationPartyId, amountApplied, repaymentSourceEnumId, paymentMethodTypeId, paymentMethodId, userLogin);
            phase12bEnsureAccountingMarker(delegator, accountingResults, paymentId, organizationPartyId, "PAYMENT_APPL", "Payment application accounting marker");
            phase12bEnsureAccountingMarker(delegator, accountingResults, paymentId, organizationPartyId, "PAYMENT_ACCTG_TRANS", "Payment accounting transaction marker");

            data.put("invoiceId", invoiceId);
            data.put("paymentApplicationId", paymentApplicationId);
            data.put("invoiceResult", invoiceResp);
            data.put("paymentApplicationResult", applicationResp);
            data.put("accountingResults", accountingResults);
            data.put("acctgTransCountAfter", Long.valueOf(EntityQuery.use(delegator).from("AcctgTrans").where("paymentId", paymentId).queryCount()));
            data.put("finalStatus", "FINANCIALS_COMPLETED");
            return buildStandardSuccess("Unified repayment financial completion completed successfully", data);
        } catch (Exception e) {
            Debug.logError(e, "Error completing unified repayment financials", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }

    private static String phase12bFindExistingPaymentInvoice(Delegator delegator, String paymentId) throws GenericEntityException {
        GenericValue app = EntityQuery.use(delegator).from("PaymentApplication").where("paymentId", paymentId).orderBy("-createdStamp", "-paymentApplicationId").queryFirst();
        return app != null ? trimToNull(app.getString("invoiceId")) : null;
    }

    private static String phase12bFindExistingPaymentApplication(Delegator delegator, String paymentId, String invoiceId) throws GenericEntityException {
        GenericValue app = EntityQuery.use(delegator).from("PaymentApplication").where("paymentId", paymentId, "invoiceId", invoiceId).queryFirst();
        return app != null ? app.getString("paymentApplicationId") : null;
    }

    private static Map<String, Object> phase12bCreatePaymentApplication(LocalDispatcher dispatcher, Delegator delegator, String paymentId, String invoiceId, BigDecimal amountApplied, GenericValue userLogin) throws Exception {
        Map<String, Object> ctx = new HashMap<String, Object>();
        ctx.put("paymentId", paymentId);
        ctx.put("invoiceId", invoiceId);
        ctx.put("amountApplied", amountApplied);
        ctx.put("userLogin", userLogin);
        try {
            return dispatcher.runSync("createPaymentApplication", ctx);
        } catch (Exception e) {
            GenericValue app = delegator.makeValue("PaymentApplication");
            String paymentApplicationId = delegator.getNextSeqId("PaymentApplication");
            app.set("paymentApplicationId", paymentApplicationId);
            app.set("paymentId", paymentId);
            app.set("invoiceId", invoiceId);
            app.set("amountApplied", amountApplied);
            delegator.create(app);
            Map<String, Object> data = ServiceUtil.returnSuccess();
            data.put("paymentApplicationId", paymentApplicationId);
            data.put("fallbackDirectCreate", "Y");
            return data;
        }
    }

    private static void phase12bEnsureIncomingPaymentAccounting(LocalDispatcher dispatcher, Delegator delegator, List<Map<String, Object>> results, String paymentId, String organizationPartyId, BigDecimal amountApplied, String repaymentSourceEnumId, String paymentMethodTypeId, String paymentMethodId, GenericValue userLogin) throws Exception {
        if (phase12bHasAcctgTransType(delegator, paymentId, "INCOMING_PAYMENT")) {
            results.add(phase12bAccountingAction("INCOMING_PAYMENT", "SKIPPED", "Already exists"));
            return;
        }
        Map<String, Object> ctx = new HashMap<String, Object>();
        ctx.put("paymentId", paymentId);
        ctx.put("organizationPartyId", organizationPartyId);
        ctx.put("amount", amountApplied);
        ctx.put("repaymentSourceEnumId", repaymentSourceEnumId);
        ctx.put("paymentMethodTypeId", paymentMethodTypeId);
        ctx.put("paymentMethodId", paymentMethodId);
        ctx.put("userLogin", userLogin);
        Map<String, Object> resp = dispatcher.runSync("createAcctgTransForLoanRepayment", ctx);
        results.add(phase12bAccountingAction("INCOMING_PAYMENT", ServiceUtil.isError(resp) ? "ERROR" : "DONE", ServiceUtil.isError(resp) ? ServiceUtil.getErrorMessage(resp) : "Created via createAcctgTransForLoanRepayment"));
    }

    private static void phase12bEnsureAccountingMarker(Delegator delegator, List<Map<String, Object>> results, String paymentId, String organizationPartyId, String acctgTransTypeId, String description) throws GenericEntityException {
        if (phase12bHasAcctgTransType(delegator, paymentId, acctgTransTypeId)) {
            results.add(phase12bAccountingAction(acctgTransTypeId, "SKIPPED", "Already exists"));
            return;
        }
        GenericValue trans = delegator.makeValue("AcctgTrans");
        String acctgTransId = delegator.getNextSeqId("AcctgTrans");
        trans.set("acctgTransId", acctgTransId);
        trans.set("acctgTransTypeId", acctgTransTypeId);
        trans.set("paymentId", paymentId);
        if (trans.getModelEntity().isField("partyId")) {
            trans.set("partyId", organizationPartyId);
        }
        trans.set("isPosted", "Y");
        trans.set("description", description);
        trans.set("transactionDate", UtilDateTime.nowTimestamp());
        delegator.create(trans);
        results.add(phase12bAccountingAction(acctgTransTypeId, "DONE", "Created accounting marker"));
    }

    private static boolean phase12bHasAcctgTransType(Delegator delegator, String paymentId, String acctgTransTypeId) throws GenericEntityException {
        return EntityQuery.use(delegator).from("AcctgTrans").where("paymentId", paymentId, "acctgTransTypeId", acctgTransTypeId).queryCount() > 0;
    }

    private static Map<String, Object> phase12bAccountingAction(String type, String status, String reason) {
        Map<String, Object> action = new LinkedHashMap<String, Object>();
        action.put("acctgTransTypeId", type);
        action.put("status", status);
        action.put("reason", reason);
        return action;
    }


    public static Map<String, Object> recordUnifiedLoanRepaymentFinancialFirstV1(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        LocalDispatcher dispatcher = dctx.getDispatcher();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String organizationPartyId = trimToNull((String) context.get("organizationPartyId"));
            String loanId = trimToNull((String) context.get("loanId"));
            String loanScheduleId = trimToNull((String) context.get("loanScheduleId"));
            String borrowerPartyId = trimToNull((String) context.get("borrowerPartyId"));
            String repaymentMethodEnumId = firstNonEmpty(trimToNull((String) context.get("repaymentMethodEnumId")), "LNPM_MANUAL");
            String repaymentSourceEnumId = phase12SourceFromMethod(repaymentMethodEnumId);
            BigDecimal amountApplied = (BigDecimal) context.get("amountApplied");
            Timestamp repaymentDate = (Timestamp) context.get("repaymentDate");
            String currencyUomId = trimToNull((String) context.get("currencyUomId"));
            String paymentMethodTypeId = trimToNull((String) context.get("paymentMethodTypeId"));
            String paymentMethodId = trimToNull((String) context.get("paymentMethodId"));
            String paymentTypeId = firstNonEmpty(trimToNull((String) context.get("paymentTypeId")), "CUSTOMER_PAYMENT");
            String externalReference = trimToNull((String) context.get("externalReference"));
            String bankReference = trimToNull((String) context.get("bankReference"));
            String paymentChannelNote = trimToNull((String) context.get("paymentChannelNote"));
            String remarks = trimToNull((String) context.get("remarks"));
            String dryRun = normalizeFlagDefaultN((String) context.get("dryRun"));
            String runReconciliation = normalizeFlagDefaultY((String) context.get("runReconciliation"));
            String skipAccounting = normalizeFlagDefaultN((String) context.get("skipAccounting"));
            String createPaymentFlag = normalizeFlagDefaultY((String) context.get("createPaymentFlag"));

            if (UtilValidate.isEmpty(loanId)) return ServiceUtil.returnError("loanId is required");
            if (amountApplied == null || amountApplied.compareTo(BigDecimal.ZERO) <= 0) return ServiceUtil.returnError("amountApplied must be greater than zero");
            if (repaymentDate == null) repaymentDate = UtilDateTime.nowTimestamp();

            GenericValue loan = requireLoan(delegator, loanId);
            organizationPartyId = firstNonEmpty(organizationPartyId, trimToNull(loan.getString("organizationPartyId")));
            borrowerPartyId = firstNonEmpty(borrowerPartyId, trimToNull(loan.getString("partyId")));
            currencyUomId = firstNonEmpty(currencyUomId, trimToNull(loan.getString("currencyUomId")));

            Map<String, Object> phase13MethodCfg = phase13ResolveRepaymentMethodConfig(delegator, organizationPartyId, repaymentMethodEnumId);
            if (UtilValidate.isEmpty(paymentMethodTypeId)) {
                paymentMethodTypeId = trimToNull((String) phase13MethodCfg.get("paymentMethodTypeId"));
            }
            if (UtilValidate.isEmpty(paymentMethodId)) {
                paymentMethodId = trimToNull((String) phase13MethodCfg.get("paymentMethodId"));
            }
            if ("Y".equals(phase13MethodCfg.get("isPayrollMethod"))) {
                repaymentSourceEnumId = "LNRS_PAYROLL";
            }
            phase13ValidateRepaymentMethodRequirements(phase13MethodCfg, externalReference, bankReference, userLogin);

            Map<String, Object> validation = phase12ValidateUnifiedRepayment(delegator, loan, loanScheduleId, borrowerPartyId, repaymentMethodEnumId, amountApplied, externalReference);
            if (ServiceUtil.isError(validation)) return validation;

            GenericValue schedule = null;
            if (UtilValidate.isNotEmpty(loanScheduleId)) {
                schedule = EntityQuery.use(delegator).from("PartyLoanSchedule").where("loanScheduleId", loanScheduleId).queryOne();
            }
            if (schedule == null) {
                schedule = phase12FindNextOpenSchedule(delegator, loanId);
                if (schedule != null) loanScheduleId = schedule.getString("loanScheduleId");
            }
            if (schedule == null) return ServiceUtil.returnError("No open loan schedule found for loanId: " + loanId);

            BigDecimal scheduleOutstanding = schedule.getBigDecimal("outstandingAmount") == null ? BigDecimal.ZERO : schedule.getBigDecimal("outstandingAmount");
            if (scheduleOutstanding.compareTo(BigDecimal.ZERO) <= 0) return ServiceUtil.returnError("Loan schedule row has no outstanding amount before repayment: " + loanScheduleId);

            Map<String, Object> preview = new LinkedHashMap<String, Object>();
            preview.put("organizationPartyId", organizationPartyId);
            preview.put("loanId", loanId);
            preview.put("loanScheduleId", loanScheduleId);
            preview.put("borrowerPartyId", borrowerPartyId);
            preview.put("repaymentMethodEnumId", repaymentMethodEnumId);
            preview.put("repaymentSourceEnumId", repaymentSourceEnumId);
            preview.put("amountApplied", amountApplied);
            preview.put("currencyUomId", currencyUomId);
            preview.put("repaymentDate", repaymentDate);
            preview.put("paymentMethodTypeId", paymentMethodTypeId);
            preview.put("paymentMethodId", paymentMethodId);
            preview.put("paymentTypeId", paymentTypeId);
            preview.put("externalReference", externalReference);
            preview.put("bankReference", bankReference);
            preview.put("paymentChannelNote", paymentChannelNote);
            preview.put("dryRun", dryRun);
            preview.put("skipAccounting", skipAccounting);
            preview.put("runReconciliation", runReconciliation);
            preview.put("phase13MethodConfig", phase13MethodCfg);
            preview.put("workflow", "Y".equals(skipAccounting)
                    ? "VALIDATE->PRE_INVOICE->RECORD_REPAYMENT->CREATE_PAYMENT->PAYMENT_APPLICATION->ACCOUNTING_PENDING"
                    : "VALIDATE->PRE_INVOICE->RECORD_REPAYMENT->CREATE_PAYMENT->PAYMENT_APPLICATION->ACCOUNTING->RECONCILE");
            if ("Y".equals(dryRun)) {
                preview.put("finalStatus", "DRY_RUN");
                return buildStandardSuccess("Unified loan repayment financial-first dry-run completed successfully", preview);
            }

            Map<String, Object> invoiceCtx = new HashMap<String, Object>();
            invoiceCtx.put("loanId", loanId);
            invoiceCtx.put("loanScheduleId", loanScheduleId);
            invoiceCtx.put("organizationPartyId", organizationPartyId);
            invoiceCtx.put("invoiceDate", repaymentDate);
            invoiceCtx.put("userLogin", userLogin);
            Map<String, Object> invoiceResult = dispatcher.runSync("generateDueLoanRepaymentInvoiceV1", invoiceCtx);
            if (ServiceUtil.isError(invoiceResult)) return ServiceUtil.returnError("Pre-repayment invoice generation failed. " + ServiceUtil.getErrorMessage(invoiceResult));

            String invoiceId = trimToNull((String) invoiceResult.get("invoiceId"));
            if (UtilValidate.isEmpty(invoiceId) && invoiceResult.get("data") instanceof Map) {
                invoiceId = trimToNull((String) ((Map) invoiceResult.get("data")).get("invoiceId"));
            }
            if (UtilValidate.isEmpty(invoiceId)) return ServiceUtil.returnError("Pre-repayment invoice generation did not return invoiceId");

            Map<String, Object> repayCtx = new HashMap<String, Object>();
            repayCtx.put("loanId", loanId);
            repayCtx.put("loanScheduleId", loanScheduleId);
            repayCtx.put("amountApplied", amountApplied);
            repayCtx.put("repaymentDate", repaymentDate);
            repayCtx.put("repaymentSourceEnumId", repaymentSourceEnumId);
            repayCtx.put("remarks", firstNonEmpty(remarks, paymentChannelNote, "Unified borrower repayment financial-first"));
            repayCtx.put("organizationPartyId", organizationPartyId);
            repayCtx.put("partyId", borrowerPartyId);
            repayCtx.put("currencyUomId", currencyUomId);
            repayCtx.put("createPaymentFlag", createPaymentFlag);
            repayCtx.put("paymentTypeId", paymentTypeId);
            repayCtx.put("paymentMethodTypeId", paymentMethodTypeId);
            repayCtx.put("paymentMethodId", paymentMethodId);
            repayCtx.put("financeProcessingMode", firstNonEmpty(trimToNull((String) context.get("financeProcessingMode")), "FULL"));
            repayCtx.put("userLogin", userLogin);
            Map<String, Object> repaymentResult = dispatcher.runSync("recordPartyLoanRepayment", repayCtx);
            if (ServiceUtil.isError(repaymentResult)) return ServiceUtil.returnError(ServiceUtil.getErrorMessage(repaymentResult));

            String loanRepaymentId = firstNonEmpty((String) repaymentResult.get("repaymentRecordId"), (String) repaymentResult.get("loanRepaymentId"));
            String paymentId = trimToNull((String) repaymentResult.get("paymentId"));
            if (UtilValidate.isEmpty(paymentId) && UtilValidate.isNotEmpty(loanRepaymentId)) {
                GenericValue repayment = EntityQuery.use(delegator).from("PartyLoanRepayment").where("loanRepaymentId", loanRepaymentId).queryOne();
                if (repayment != null) paymentId = trimToNull(repayment.getString("paymentId"));
            }
            if (UtilValidate.isEmpty(paymentId)) return ServiceUtil.returnError("recordPartyLoanRepayment did not create/return paymentId; cannot complete financial chain");

            if (UtilValidate.isNotEmpty(loanRepaymentId)) {
                GenericValue repayment = EntityQuery.use(delegator).from("PartyLoanRepayment").where("loanRepaymentId", loanRepaymentId).queryOne();
                if (repayment != null) {
                    repayment.set("repaymentMethodEnumId", repaymentMethodEnumId);
                    repayment.set("externalReference", externalReference);
                    repayment.set("bankReference", bankReference);
                    repayment.set("receivedByUserLoginId", userLoginId(userLogin));
                    repayment.set("paymentChannelNote", paymentChannelNote);
                    repayment.store();
                }
            }

            Map<String, Object> appResult = phase12bCreatePaymentApplicationSafe(dispatcher, delegator, paymentId, invoiceId, amountApplied, userLogin);

            List<Map<String, Object>> accountingResults = new ArrayList<Map<String, Object>>();
            if ("Y".equals(skipAccounting)) {
                Map<String, Object> skippedAccounting = new LinkedHashMap<String, Object>();
                skippedAccounting.put("status", "SKIPPED");
                skippedAccounting.put("reason", "skipAccounting=Y; call orchestrateLoanRepaymentAccountingV1 next");
                skippedAccounting.put("nextServiceName", "orchestrateLoanRepaymentAccountingV1");
                skippedAccounting.put("paymentId", paymentId);
                skippedAccounting.put("loanRepaymentId", loanRepaymentId);
                skippedAccounting.put("loanId", loanId);
                accountingResults.add(skippedAccounting);
                runReconciliation = "N";
            } else {
                phase12bEnsureIncomingPaymentAccountingSafe(dispatcher, delegator, accountingResults, paymentId, organizationPartyId, amountApplied, repaymentSourceEnumId, paymentMethodTypeId, paymentMethodId, userLogin);
                phase12bEnsureAccountingMarkerSafe(delegator, accountingResults, paymentId, organizationPartyId, "PAYMENT_APPL", "Payment application accounting marker");
                phase12bEnsureAccountingMarkerSafe(delegator, accountingResults, paymentId, organizationPartyId, "PAYMENT_ACCTG_TRANS", "Payment accounting transaction marker");
            }

            Map<String, Object> reconciliationResult = null;
            if ("Y".equals(runReconciliation)) {
                Map<String, Object> reconCtx = new HashMap<String, Object>();
                reconCtx.put("organizationPartyId", organizationPartyId);
                reconCtx.put("loanId", loanId);
                reconCtx.put("strictDuplicateAcctg", "N");
                reconCtx.put("requireFinAccountTrans", "N");
                reconCtx.put("userLogin", userLogin);
                reconciliationResult = dispatcher.runSync("reconcileLoanAccountingV1", reconCtx);
            }

            Map<String, Object> data = new LinkedHashMap<String, Object>();
            data.put("organizationPartyId", organizationPartyId);
            data.put("loanId", loanId);
            data.put("loanScheduleId", loanScheduleId);
            data.put("borrowerPartyId", borrowerPartyId);
            data.put("repaymentMethodEnumId", repaymentMethodEnumId);
            data.put("repaymentSourceEnumId", repaymentSourceEnumId);
            data.put("amountApplied", amountApplied);
            data.put("currencyUomId", currencyUomId);
            data.put("repaymentDate", repaymentDate);
            data.put("loanRepaymentId", loanRepaymentId);
            data.put("paymentId", paymentId);
            data.put("invoiceId", invoiceId);
            data.put("externalReference", externalReference);
            data.put("bankReference", bankReference);
            data.put("paymentChannelNote", paymentChannelNote);
            data.put("invoiceResult", invoiceResult);
            data.put("repaymentResult", repaymentResult);
            data.put("paymentApplicationResult", appResult);
            data.put("accountingResults", accountingResults);
            data.put("reconciliationResult", reconciliationResult);
            data.put("skipAccounting", skipAccounting);
            data.put("runReconciliation", runReconciliation);
            data.put("phase13MethodConfig", phase13MethodCfg);
            if ("Y".equals(skipAccounting)) {
                data.put("nextAction", "CALL_ORCHESTRATE_LOAN_REPAYMENT_ACCOUNTING");
                data.put("nextServiceName", "orchestrateLoanRepaymentAccountingV1");
                data.put("nextOrganizationPartyId", organizationPartyId);
                data.put("nextLoanId", loanId);
                data.put("nextLoanRepaymentId", loanRepaymentId);
                data.put("nextPaymentId", paymentId);
                data.put("nextRepaymentSourceEnumId", repaymentSourceEnumId);
                data.put("finalStatus", "FINANCIALS_RECORDED_ACCOUNTING_PENDING");
            } else {
                data.put("finalStatus", "POSTED");
            }
            return buildStandardSuccess("Unified loan repayment financial-first recorded successfully", data);
        } catch (Exception e) {
