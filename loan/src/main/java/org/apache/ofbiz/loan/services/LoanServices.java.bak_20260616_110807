                methodList.add(phase13MethodOption("LNPM_CARD", "CREDIT_CARD", null, null, "Y", "N", "N", "N", "Card", "DEFAULT"));
                methodList.add(phase13MethodOption("LNPM_MOBILE_WALLET", "FIN_ACCOUNT", null, null, "Y", "Y", "N", "N", "Mobile Wallet", "DEFAULT"));
                methodList.add(phase13MethodOption("LNPM_DIRECT_DEBIT", "EFT_ACCOUNT", null, null, "Y", "Y", "N", "N", "Direct Debit", "DEFAULT"));
                methodList.add(phase13MethodOption("LNPM_PAYROLL", null, null, null, "N", "N", "N", "Y", "Payroll Deduction", "DEFAULT"));
