    public static Map<String, Object> applyPayrollDeductionToPartyLoan(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String loanId = (String) context.get("loanId");
            String loanScheduleId = (String) context.get("loanScheduleId");
            String payrollRunId = (String) context.get("payrollRunId");
            String payrollResultId = (String) context.get("payrollResultId");
            String remarks = (String) context.get("remarks");
            BigDecimal amountApplied = (BigDecimal) context.get("amountApplied");
            Timestamp repaymentDate = (Timestamp) context.get("repaymentDate");

            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }
            if (UtilValidate.isEmpty(loanScheduleId)) {
                return ServiceUtil.returnError("loanScheduleId is required");
            }
            if (UtilValidate.isEmpty(payrollRunId)) {
                return ServiceUtil.returnError("payrollRunId is required");
            }
            if (amountApplied == null || amountApplied.compareTo(BigDecimal.ZERO) <= 0) {
                return ServiceUtil.returnError("amountApplied must be greater than zero");
            }
            if (repaymentDate == null) {
                repaymentDate = UtilDateTime.nowTimestamp();
            }

            GenericValue loan = requireLoan(delegator, loanId);
            Map<String, Object> statusValidation = validateLoanStatus(
                    loan, "applyPayrollDeductionToPartyLoan", LOAN_ACTIVE, LOAN_PARTIAL);
            if (ServiceUtil.isError(statusValidation)) {
                return statusValidation;
            }

            try {
    ensurePayrollRunEditableForLoanAction(delegator, payrollRunId);
} catch (Exception e) {
    logLoanAudit(dctx, context,
            "PAY_ACT_LOAN_APPLY",
            "ACT_FAIL",
            "applyPayrollDeductionToPartyLoan blocked: " + e.getMessage());
    throw e;
}

            GenericValue row = EntityQuery.use(delegator)
                    .from("PartyLoanSchedule")
                    .where("loanScheduleId", loanScheduleId)
                    .queryOne();

            if (row == null) {
                return ServiceUtil.returnError("Loan schedule row not found: " + loanScheduleId);
            }
            if (!loanId.equals(row.getString("loanId"))) {
                return ServiceUtil.returnError("loanScheduleId does not belong to loanId. loanId=" + loanId + ", loanScheduleId=" + loanScheduleId);
            }

            BigDecimal outstandingBefore = safeAmount(row.getBigDecimal("outstandingAmount"));
            if (outstandingBefore.compareTo(BigDecimal.ZERO) <= 0) {
                return ServiceUtil.returnError("Loan schedule row has no outstanding amount: " + loanScheduleId);
            }

            BigDecimal loanOutstandingBefore = safeAmount(loan.getBigDecimal("outstandingAmount"));
            if (loanOutstandingBefore.compareTo(BigDecimal.ZERO) <= 0) {
                return ServiceUtil.returnError("Loan has no outstanding amount available for repayment: " + loanId);
            }

            if (UtilValidate.isNotEmpty(payrollRunId) && UtilValidate.isNotEmpty(payrollResultId)) {
                GenericValue duplicateRepayment = findExistingPayrollRepayment(
                        delegator, loanId, loanScheduleId, payrollRunId, payrollResultId);
                if (duplicateRepayment != null) {
                    return ServiceUtil.returnError(
                            "Duplicate payroll repayment application is not allowed for loanScheduleId="
                                    + loanScheduleId + ", payrollRunId=" + payrollRunId + ", payrollResultId=" + payrollResultId);
                }
            }

            boolean alreadyPayrollProcessed = UtilValidate.isNotEmpty(row.getString("processedPayrollRunId"))
                    || UtilValidate.isNotEmpty(row.getString("processedPayrollResultId"));
            boolean partialContinuationAllowed = SCH_PARTIAL.equals(row.getString("scheduleStatusId"))
                    && outstandingBefore.compareTo(BigDecimal.ZERO) > 0;

            if (alreadyPayrollProcessed && !partialContinuationAllowed) {
                return ServiceUtil.returnError("Loan schedule row already processed by payroll: " + loanScheduleId);
            }

            BigDecimal maxAllowed = minAmount(outstandingBefore, loanOutstandingBefore);
            if (amountApplied.compareTo(maxAllowed) > 0) {
                return ServiceUtil.returnError(
                        "Requested payroll deduction exceeds allowed outstanding amount for loanScheduleId="
                                + loanScheduleId + ". requestedAmount=" + amountApplied + ", maxAllowed=" + maxAllowed);
            }

            applyToScheduleRow(
                    delegator,
                    loan,
                    row,
                    amountApplied,
                    repaymentDate,
                    "LNRS_PAYROLL",
                    null,
                    payrollRunId,
                    payrollResultId,
                    remarks,
                    userLogin != null ? userLogin.getString("userLoginId") : null
            );

            refreshLoanTotals(delegator, loanId);

            GenericValue refreshedLoan = requireLoan(delegator, loanId);
            GenericValue refreshedRow = EntityQuery.use(delegator)
                    .from("PartyLoanSchedule")
                    .where("loanScheduleId", loanScheduleId)
                    .queryOne();

            Map<String, Object> data = new HashMap<String, Object>();
            data.put("loanId", loanId);
            data.put("loanScheduleId", loanScheduleId);
            data.put("amountApplied", amountApplied);
            data.put("outstandingAmountAfter",
                    refreshedRow != null && refreshedRow.getBigDecimal("outstandingAmount") != null
                            ? refreshedRow.getBigDecimal("outstandingAmount") : BigDecimal.ZERO);
            data.put("scheduleStatusId", refreshedRow != null ? refreshedRow.getString("scheduleStatusId") : null);
            data.put("loanStatusIdAfter", refreshedLoan.getString("loanStatusId"));
            data.put("repaymentSourceEnumId", "LNRS_PAYROLL");
            data.put("payrollRunId", payrollRunId);
            data.put("payrollResultId", payrollResultId);

            return buildStandardSuccess("Payroll loan deduction applied successfully", data);

        } catch (Exception e) {
            Debug.logError(e, "Error applying payroll deduction", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }

