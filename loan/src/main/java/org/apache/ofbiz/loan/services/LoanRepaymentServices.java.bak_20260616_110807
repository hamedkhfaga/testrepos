    private static String createRepaymentPayment(
            DispatchContext dctx,
            GenericValue loan,
            BigDecimal amountApplied,
            Timestamp repaymentDate,
            String sourceEnumId,
            String paymentTypeId,
            String paymentMethodTypeId,
            String paymentMethodId,
            String payrollRunId,
            String payrollResultId,
            String remarks,
            GenericValue userLogin) throws Exception {

        if (loan == null) {
            throw new GenericEntityException("Loan record is required to create repayment Payment");
        }
        if (amountApplied == null || amountApplied.compareTo(BigDecimal.ZERO) <= 0) {
            throw new GenericEntityException("amountApplied must be greater than zero to create repayment Payment");
        }

        LocalDispatcher dispatcher = dctx.getDispatcher();
        if (dispatcher == null) {
            throw new GenericEntityException("Dispatcher is required to create repayment Payment");
        }
        if (repaymentDate == null) {
            repaymentDate = UtilDateTime.nowTimestamp();
        }

        String borrowerPartyId = loan.getString("partyId");
        String organizationPartyId = loan.getString("organizationPartyId");
        String currencyUomId = loan.getString("currencyUomId");
        if (UtilValidate.isEmpty(borrowerPartyId) || UtilValidate.isEmpty(organizationPartyId)) {
            throw new GenericEntityException("Loan partyId and organizationPartyId are required to create repayment Payment");
        }
        if (UtilValidate.isEmpty(currencyUomId)) {
            throw new GenericEntityException("Loan currencyUomId is required to create repayment Payment");
        }

        Map<String, Object> paymentCtx = new HashMap<String, Object>();
        paymentCtx.put("paymentTypeId", UtilValidate.isNotEmpty(paymentTypeId) ? paymentTypeId : "CUSTOMER_PAYMENT");
        paymentCtx.put("partyIdFrom", borrowerPartyId);
        paymentCtx.put("partyIdTo", organizationPartyId);
        paymentCtx.put("amount", amountApplied);
        paymentCtx.put("currencyUomId", currencyUomId);
        paymentCtx.put("effectiveDate", repaymentDate);
        paymentCtx.put("paymentMethodTypeId", paymentMethodTypeId);
        paymentCtx.put("paymentMethodId", paymentMethodId);
        paymentCtx.put("comments", buildRepaymentPaymentComment(loan, sourceEnumId, payrollRunId, payrollResultId, remarks));
        paymentCtx.put("userLogin", userLogin);

        Map<String, Object> paymentResp = dispatcher.runSync("createPayment", paymentCtx);
        if (ServiceUtil.isError(paymentResp)) {
            throw new GenericEntityException(
                    "Failed to create OFBiz Payment for loan repayment: "
                            + ServiceUtil.getErrorMessage(paymentResp));
        }

        String createdPaymentId = (String) paymentResp.get("paymentId");
        if (UtilValidate.isEmpty(createdPaymentId)) {
            throw new GenericEntityException("createPayment succeeded but returned no paymentId for loan repayment");
        }

        GenericValue payment = validateExistingPayment(dctx.getDelegator(), createdPaymentId);
        if (payment == null) {
            throw new GenericEntityException(
                    "createPayment returned paymentId but Payment record was not found: " + createdPaymentId);
        }

        return createdPaymentId;
    }

    private static String buildRepaymentPaymentComment(
            GenericValue loan,
            String sourceEnumId,
            String payrollRunId,
            String payrollResultId,
            String remarks) {
        StringBuilder sb = new StringBuilder();
        sb.append("Loan repayment");
        if (loan != null && UtilValidate.isNotEmpty(loan.getString("loanId"))) {
            sb.append(" loanId=").append(loan.getString("loanId"));
