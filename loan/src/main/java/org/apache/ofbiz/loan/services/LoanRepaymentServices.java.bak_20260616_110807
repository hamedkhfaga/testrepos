    public static final String SCH_PAID = "LNS_PAID";
    public static final String REP_POSTED = "LNR_POSTED";
    public static final String LOAN_ACTIVE = "LN_ACTIVE";
    public static final String LOAN_PARTIAL = "LN_PARTIAL";
    public static final String LOAN_CLOSED = "LN_CLOSED";

    private LoanRepaymentServices() {}

    
public static Map<String, Object> recordPartyLoanRepayment(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String loanId = (String) context.get("loanId");
            String loanScheduleId = (String) context.get("loanScheduleId");
            BigDecimal amountApplied = (BigDecimal) context.get("amountApplied");
            Timestamp repaymentDate = (Timestamp) context.get("repaymentDate");
            String sourceEnumId = (String) context.get("repaymentSourceEnumId");
            String paymentId = (String) context.get("paymentId");
            String createPaymentFlag = normalizeFlag((String) context.get("createPaymentFlag"));
            String paymentTypeId = trimToNull((String) context.get("paymentTypeId"));
            String paymentMethodTypeId = trimToNull((String) context.get("paymentMethodTypeId"));
            String paymentMethodId = trimToNull((String) context.get("paymentMethodId"));
            String payrollRunId = (String) context.get("payrollRunId");
            String payrollResultId = (String) context.get("payrollResultId");
            String finAccountId = trimToNull((String) context.get("finAccountId"));
            String organizationPartyId = trimToNull((String) context.get("organizationPartyId"));
            String remarks = (String) context.get("remarks");

            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }
            if (amountApplied == null || amountApplied.compareTo(BigDecimal.ZERO) <= 0) {
                return ServiceUtil.returnError("amountApplied must be greater than zero");
            }
            if (repaymentDate == null) {
                repaymentDate = UtilDateTime.nowTimestamp();
            }
            if (UtilValidate.isEmpty(sourceEnumId)) {
                sourceEnumId = "LNRS_MANUAL";
            }
            if ("LNRS_PAYROLL".equals(sourceEnumId) && UtilValidate.isEmpty(createPaymentFlag)) {
                createPaymentFlag = "Y";
            }

            GenericValue loan = requireLoan(delegator, loanId);
            if (UtilValidate.isEmpty(organizationPartyId)) {
                organizationPartyId = loan.getString("organizationPartyId");
            }
            if (UtilValidate.isEmpty(finAccountId)) {
                finAccountId = trimToNull(loan.getString("finAccountId"));
            }

            if ("LNRS_PAYROLL".equals(sourceEnumId)) {
                try {
                    ensurePayrollRunEditableForLoanAction(delegator, payrollRunId);
                } catch (Exception e) {
                    logLoanAudit(dctx, context,
                            "PAY_ACT_LOAN_RECORD",
                            "ACT_FAIL",
                            "recordPartyLoanRepayment blocked: " + e.getMessage());
                    throw e;
                }
            }

            Map<String, Object> statusValidation = validateLoanStatus(
                    loan, "recordPartyLoanRepayment", LOAN_ACTIVE, LOAN_PARTIAL);
            if (ServiceUtil.isError(statusValidation)) {
                return statusValidation;
            }

            if ("LNRS_PAYROLL".equals(sourceEnumId)
                    && !"Y".equalsIgnoreCase(loan.getString("payrollEligibleFlag"))) {
                return ServiceUtil.returnError(
                        "Payroll-source repayment is not allowed for loanId: "
                                + loanId + " because payrollEligibleFlag != Y");
            }

            BigDecimal loanOutstandingBefore = safeAmount(loan.getBigDecimal("outstandingAmount"));
            if (loanOutstandingBefore.compareTo(BigDecimal.ZERO) <= 0) {
                return ServiceUtil.returnError("Loan has no outstanding amount available for repayment: " + loanId);
            }

            List<GenericValue> dueRows;
            if (UtilValidate.isNotEmpty(loanScheduleId)) {
                GenericValue targetedRow = EntityQuery.use(delegator)
                        .from("PartyLoanSchedule")
                        .where("loanScheduleId", loanScheduleId)
                        .queryOne();

                if (targetedRow == null) {
                    return ServiceUtil.returnError("Loan schedule row not found: " + loanScheduleId);
                }
                if (!loanId.equals(targetedRow.getString("loanId"))) {
                    return ServiceUtil.returnError("loanScheduleId does not belong to loanId. loanId="
                            + loanId + ", loanScheduleId=" + loanScheduleId);
                }
                if (safeAmount(targetedRow.getBigDecimal("outstandingAmount")).compareTo(BigDecimal.ZERO) <= 0) {
                    return ServiceUtil.returnError("Loan schedule row has no outstanding amount: " + loanScheduleId);
                }

                dueRows = new ArrayList<GenericValue>();
                dueRows.add(targetedRow);
            } else {
                dueRows = resolveRepaymentTargetRows(delegator, loanId, null);
                if (UtilValidate.isEmpty(dueRows)) {
                    return ServiceUtil.returnError(
                            "No outstanding repayment schedule rows were available for allocation for loanId: " + loanId);
                }
            }

            if ("LNRS_PAYROLL".equals(sourceEnumId)
                    && UtilValidate.isNotEmpty(payrollRunId)
                    && UtilValidate.isNotEmpty(payrollResultId)) {

                GenericValue duplicateRepayment = findExistingPayrollRepayment(
                        delegator,
                        loanId,
                        loanScheduleId,
                        payrollRunId,
                        payrollResultId
                );

                if (duplicateRepayment != null) {
                    Map<String, Object> data = new HashMap<String, Object>();
                    data.put("loanId", loanId);
                    data.put("loanScheduleId", duplicateRepayment.getString("loanScheduleId"));
                    data.put("requestedAmountApplied", amountApplied);
                    data.put("totalApplied", BigDecimal.ZERO);
                    data.put("unappliedAmount", amountApplied);
                    data.put("allocationCount", Integer.valueOf(0));
                    data.put("repaymentDate", duplicateRepayment.getTimestamp("repaymentDate"));
                    data.put("repaymentSourceEnumId", sourceEnumId);
                    data.put("paymentId", duplicateRepayment.getString("paymentId"));
                    data.put("payrollRunId", payrollRunId);
                    data.put("payrollResultId", payrollResultId);
                    data.put("repaymentRecordId", duplicateRepayment.getString("loanRepaymentId"));
                    data.put("duplicateSkipped", "Y");
                    data.put("loanStatusIdAfter", loan.getString("loanStatusId"));
                    data.put("outstandingAmountAfter", loanOutstandingBefore);
                    return buildStandardSuccess("Duplicate payroll repayment skipped", data);
                }
            }

            if (UtilValidate.isNotEmpty(paymentId) && "Y".equals(createPaymentFlag)) {
                return ServiceUtil.returnError("Provide either paymentId or createPaymentFlag=Y, but not both");
            }

            if (UtilValidate.isNotEmpty(paymentId)) {
                GenericValue payment = validateExistingPayment(delegator, paymentId);
                if (payment == null) {
                    return ServiceUtil.returnError("Invalid paymentId; Payment not found: " + paymentId);
                }
            } else if ("Y".equals(createPaymentFlag)) {
                String createdPaymentId = createRepaymentPayment(
                        dctx,
                        loan,
                        amountApplied,
                        repaymentDate,
                        sourceEnumId,
                        paymentTypeId,
                        paymentMethodTypeId,
                        paymentMethodId,
                        payrollRunId,
                        payrollResultId,
                        remarks,
                        userLogin
                );
                if (UtilValidate.isEmpty(createdPaymentId)) {
                    return ServiceUtil.returnError("Failed to create OFBiz Payment for loan repayment");
                }
                paymentId = createdPaymentId;
            }

            BigDecimal requestedAmount = amountApplied;
            BigDecimal remainingApply = requestedAmount.min(loanOutstandingBefore);
            BigDecimal totalApplied = BigDecimal.ZERO;
            int allocationCount = 0;
            String lastAppliedLoanScheduleId = null;

            for (GenericValue row : dueRows) {
                BigDecimal outstanding = safeAmount(row.getBigDecimal("outstandingAmount"));
                if (outstanding.compareTo(BigDecimal.ZERO) <= 0) {
                    continue;
                }
                if (remainingApply.compareTo(BigDecimal.ZERO) <= 0) {
                    break;
                }

                BigDecimal applied = remainingApply.min(outstanding);
                if (applied.compareTo(BigDecimal.ZERO) <= 0) {
                    continue;
                }

                applyToScheduleRow(
                        delegator,
                        loan,
                        row,
                        applied,
                        repaymentDate,
                        sourceEnumId,
                        paymentId,
                        payrollRunId,
                        payrollResultId,
                        remarks,
                        userLogin != null ? userLogin.getString("userLoginId") : null
                );

                remainingApply = remainingApply.subtract(applied);
                totalApplied = totalApplied.add(applied);
                allocationCount++;
                lastAppliedLoanScheduleId = row.getString("loanScheduleId");
            }

            if (allocationCount == 0 || totalApplied.compareTo(BigDecimal.ZERO) <= 0) {
                if (UtilValidate.isNotEmpty(loanScheduleId)) {
                    return ServiceUtil.returnError("Loan schedule row has no outstanding amount: " + loanScheduleId);
                }
                return ServiceUtil.returnError(
                        "No outstanding repayment schedule rows were available for allocation for loanId: " + loanId);
            }

            refreshLoanTotals(delegator, loanId);

            GenericValue refreshedLoan = requireLoan(delegator, loanId);

            if (UtilValidate.isNotEmpty(paymentId)) {
                postLoanRepaymentFinancials(
                        dctx,
                        loan,
                        paymentId,
                        totalApplied,
                        repaymentDate,
                        sourceEnumId,
                        organizationPartyId,
                        finAccountId,
                        payrollRunId,
                        payrollResultId,
                        remarks,
                        userLogin
                );
            }

            BigDecimal unappliedAmount = requestedAmount.subtract(totalApplied);
            if (unappliedAmount.compareTo(BigDecimal.ZERO) < 0) {
                unappliedAmount = BigDecimal.ZERO;
            }

            BigDecimal outstandingAmountAfter = safeAmount(refreshedLoan.getBigDecimal("outstandingAmount"));
            String loanStatusIdAfter = refreshedLoan.getString("loanStatusId");

            String repaymentRecordId = null;
            GenericValue latestRepayment = EntityQuery.use(delegator)
                    .from("PartyLoanRepayment")
                    .where("loanId", loanId)
                    .orderBy("-createdStamp")
                    .queryFirst();
            if (latestRepayment != null) {
                repaymentRecordId = latestRepayment.getString("loanRepaymentId");
            }

            Map<String, Object> data = new HashMap<String, Object>();
            data.put("loanId", loanId);
            data.put("loanScheduleId", UtilValidate.isNotEmpty(loanScheduleId) ? loanScheduleId : lastAppliedLoanScheduleId);
            data.put("requestedAmountApplied", requestedAmount);
            data.put("totalApplied", totalApplied);
            data.put("unappliedAmount", unappliedAmount);
            data.put("allocationCount", Integer.valueOf(allocationCount));
            data.put("repaymentDate", repaymentDate);
            data.put("repaymentSourceEnumId", sourceEnumId);
            data.put("paymentId", org.apache.ofbiz.base.util.UtilValidate.isNotEmpty(paymentId) ? paymentId : "");
            data.put("createPaymentFlag", createPaymentFlag);
            data.put("payrollRunId", org.apache.ofbiz.base.util.UtilValidate.isNotEmpty(payrollRunId) ? payrollRunId : "");
            data.put("payrollResultId", org.apache.ofbiz.base.util.UtilValidate.isNotEmpty(payrollResultId) ? payrollResultId : "");
            data.put("repaymentRecordId", repaymentRecordId);
            data.put("outstandingAmountAfter", outstandingAmountAfter);
            data.put("loanStatusIdAfter", loanStatusIdAfter);

            return buildStandardSuccess("Loan repayment recorded successfully", data);

        } catch (Exception e) {
            Debug.logError(e, "Error recording loan repayment", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }


    public static Map<String, Object> captureLoanRepaymentPaymentV1(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        LocalDispatcher dispatcher = dctx.getDispatcher();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String loanId = (String) context.get("loanId");
            String loanScheduleId = trimToNull((String) context.get("loanScheduleId"));
            String invoiceId = trimToNull((String) context.get("invoiceId"));
            String organizationPartyId = trimToNull((String) context.get("organizationPartyId"));
            BigDecimal amountApplied = (BigDecimal) context.get("amountApplied");
            Timestamp repaymentDate = (Timestamp) context.get("repaymentDate");
            String repaymentSourceEnumId = trimToNull((String) context.get("repaymentSourceEnumId"));
            String remarks = (String) context.get("remarks");
            String paymentId = trimToNull((String) context.get("paymentId"));
            String createPaymentFlag = (String) context.get("createPaymentFlag");
            String paymentTypeId = trimToNull((String) context.get("paymentTypeId"));
            String paymentMethodTypeId = trimToNull((String) context.get("paymentMethodTypeId"));
            String paymentMethodId = trimToNull((String) context.get("paymentMethodId"));
            String payrollRunId = (String) context.get("payrollRunId");
            String payrollResultId = (String) context.get("payrollResultId");
            String finAccountId = trimToNull((String) context.get("finAccountId"));
            String financeProcessingMode = trimToNull((String) context.get("financeProcessingMode"));
            String paymentTargetStatusId = trimToNull((String) context.get("paymentTargetStatusId"));
            String invoiceApprovedStatusId = trimToNull((String) context.get("invoiceApprovedStatusId"));
            String invoiceReadyStatusId = trimToNull((String) context.get("invoiceReadyStatusId"));
            String invoicePaidStatusId = trimToNull((String) context.get("invoicePaidStatusId"));

            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }
            if (UtilValidate.isEmpty(invoiceId)) {
                return ServiceUtil.returnError("invoiceId is required");
            }
            if (amountApplied == null || amountApplied.compareTo(BigDecimal.ZERO) <= 0) {
                return ServiceUtil.returnError("amountApplied must be greater than zero");
            }

            GenericValue loan = requireLoan(delegator, loanId);
            Map<String, Object> statusValidation = validateLoanStatus(
                    loan, "captureLoanRepaymentPaymentV1", LOAN_ACTIVE, LOAN_PARTIAL);
            if (ServiceUtil.isError(statusValidation)) {
                return statusValidation;
            }
            if (UtilValidate.isEmpty(organizationPartyId)) {
                organizationPartyId = loan.getString("organizationPartyId");
            }
            if (UtilValidate.isEmpty(organizationPartyId)) {
                return ServiceUtil.returnError("organizationPartyId is required");
            }
            if (!organizationPartyId.equals(loan.getString("organizationPartyId"))) {
                return ServiceUtil.returnError("organizationPartyId mismatch for loanId: " + loanId);
            }

            GenericValue invoice = requireRepaymentInvoiceForLoan(
                    delegator, loan, invoiceId, organizationPartyId, loanScheduleId);

            GenericValue existingApp = findExistingPaymentApplicationForInvoice(delegator, invoiceId);
            if (existingApp != null) {
                GenericValue refreshedLoan = requireLoan(delegator, loanId);
                Map<String, Object> result = ServiceUtil.returnSuccess(
                        "Loan repayment payment already captured for invoice; existing application reused");
                result.put("loanId", loanId);
                result.put("loanScheduleId", loanScheduleId);
                result.put("repaymentRecordId", null);
                result.put("paymentId", existingApp.getString("paymentId"));
                result.put("invoiceId", invoiceId);
                result.put("paymentApplicationId", existingApp.getString("paymentApplicationId"));
                result.put("amountApplied", existingApp.getBigDecimal("amountApplied"));
                result.put("paymentStatusId", fetchPaymentStatusId(delegator, existingApp.getString("paymentId")));
                result.put("invoiceStatusId", invoice.getString("statusId"));
                result.put("loanStatusIdAfter", refreshedLoan.getString("loanStatusId"));
                result.put("outstandingAmountAfter", safeAmount(refreshedLoan.getBigDecimal("outstandingAmount")));
                result.put("financeProcessingMode", UtilValidate.isNotEmpty(financeProcessingMode) ? financeProcessingMode : "FINANCE_MANAGED");
                result.put("duplicateSkipped", "Y");
                result.put("idempotentReplay", "Y");
                return result;
            }

            if (UtilValidate.isEmpty(repaymentSourceEnumId)) {
                repaymentSourceEnumId = "LNRS_MANUAL";
            }
            if (UtilValidate.isEmpty(createPaymentFlag) && UtilValidate.isEmpty(paymentId)) {
                createPaymentFlag = "Y";
            }
            if (UtilValidate.isEmpty(financeProcessingMode)) {
                financeProcessingMode = "FINANCE_MANAGED";
            }

            Map<String, Object> repayCtx = new HashMap<String, Object>();
            repayCtx.put("loanId", loanId);
            repayCtx.put("loanScheduleId", loanScheduleId);
            repayCtx.put("amountApplied", amountApplied);
            repayCtx.put("repaymentDate", repaymentDate);
            repayCtx.put("repaymentSourceEnumId", repaymentSourceEnumId);
            repayCtx.put("remarks", remarks);
            repayCtx.put("organizationPartyId", organizationPartyId);
            repayCtx.put("paymentId", paymentId);
            repayCtx.put("createPaymentFlag", createPaymentFlag);
            repayCtx.put("paymentTypeId", paymentTypeId);
            repayCtx.put("paymentMethodTypeId", paymentMethodTypeId);
            repayCtx.put("paymentMethodId", paymentMethodId);
            repayCtx.put("payrollRunId", payrollRunId);
            repayCtx.put("payrollResultId", payrollResultId);
            repayCtx.put("finAccountId", finAccountId);
            repayCtx.put("billingAccountId", loan.getString("billingAccountId"));
            repayCtx.put("financeProcessingMode", financeProcessingMode);
            repayCtx.put("userLogin", userLogin);

            Map<String, Object> repayResp = dispatcher.runSync("recordPartyLoanRepayment", repayCtx);
            if (ServiceUtil.isError(repayResp)) {
                return ServiceUtil.returnError(ServiceUtil.getErrorMessage(repayResp));
            }

            @SuppressWarnings("unchecked")
            Map<String, Object> repayData = (Map<String, Object>) repayResp.get("data");
            String resolvedPaymentId = paymentId;
            if (repayData != null && UtilValidate.isEmpty(resolvedPaymentId)) {
                resolvedPaymentId = trimToNull((String) repayData.get("paymentId"));
            }
            if (UtilValidate.isEmpty(resolvedPaymentId)) {
                resolvedPaymentId = trimToNull((String) repayResp.get("paymentId"));
            }
            if (UtilValidate.isEmpty(resolvedPaymentId)) {
                return ServiceUtil.returnError("Payment capture succeeded but returned no paymentId");
            }

            Map<String, Object> applyCtx = new HashMap<String, Object>();
            applyCtx.put("loanId", loanId);
            applyCtx.put("paymentId", resolvedPaymentId);
            applyCtx.put("invoiceId", invoiceId);
            applyCtx.put("organizationPartyId", organizationPartyId);
            applyCtx.put("amountApplied", amountApplied);
            if (UtilValidate.isNotEmpty(paymentTargetStatusId)) applyCtx.put("paymentTargetStatusId", paymentTargetStatusId);
            if (UtilValidate.isNotEmpty(invoiceApprovedStatusId)) applyCtx.put("invoiceApprovedStatusId", invoiceApprovedStatusId);
            if (UtilValidate.isNotEmpty(invoiceReadyStatusId)) applyCtx.put("invoiceReadyStatusId", invoiceReadyStatusId);
            if (UtilValidate.isNotEmpty(invoicePaidStatusId)) applyCtx.put("invoicePaidStatusId", invoicePaidStatusId);
            applyCtx.put("userLogin", userLogin);

            Map<String, Object> applyResp = dispatcher.runSync("applyLoanRepaymentPaymentToInvoiceV1", applyCtx);
            if (ServiceUtil.isError(applyResp)) {
                return ServiceUtil.returnError(ServiceUtil.getErrorMessage(applyResp));
            }

            Map<String, Object> result = ServiceUtil.returnSuccess("Loan repayment payment captured and applied successfully");
            result.put("loanId", loanId);
            result.put("loanScheduleId", repayData != null ? repayData.get("loanScheduleId") : loanScheduleId);
            result.put("repaymentRecordId", repayData != null ? repayData.get("repaymentRecordId") : null);
            result.put("paymentId", resolvedPaymentId);
            result.put("invoiceId", invoiceId);
            result.put("paymentApplicationId", applyResp.get("paymentApplicationId"));
            result.put("amountApplied", applyResp.get("amountApplied"));
            result.put("paymentStatusId", applyResp.get("paymentStatusId"));
            result.put("invoiceStatusId", applyResp.get("invoiceStatusId"));
            result.put("loanStatusIdAfter", repayData != null ? repayData.get("loanStatusIdAfter") : null);
            result.put("outstandingAmountAfter", repayData != null ? repayData.get("outstandingAmountAfter") : null);
            result.put("financeProcessingMode", financeProcessingMode);
            result.put("duplicateSkipped", "N");
            return result;

        } catch (Exception e) {
            Debug.logError(e, "Error capturing loan repayment payment", MODULE);
            return ServiceUtil.returnError(e.getMessage());
        }
    }

    public static Map<String, Object> settlePartyLoanEarly(DispatchContext dctx, Map<String, ?> context) {
        Delegator delegator = dctx.getDelegator();
        GenericValue userLogin = (GenericValue) context.get("userLogin");

        try {
            String loanId = (String) context.get("loanId");
            String paymentId = (String) context.get("paymentId");
            String createPaymentFlag = normalizeFlag((String) context.get("createPaymentFlag"));
            String paymentTypeId = trimToNull((String) context.get("paymentTypeId"));
            String paymentMethodTypeId = trimToNull((String) context.get("paymentMethodTypeId"));
            String paymentMethodId = trimToNull((String) context.get("paymentMethodId"));
            String payrollRunId = (String) context.get("payrollRunId");
            String payrollResultId = (String) context.get("payrollResultId");
            String remarks = (String) context.get("remarks");

            if (UtilValidate.isEmpty(loanId)) {
                return ServiceUtil.returnError("loanId is required");
            }

            GenericValue loan = requireLoan(delegator, loanId);

            ensurePayrollRunEditableForLoanAction(delegator, payrollRunId);

            Map<String, Object> statusValidation = validateLoanStatus(
                    loan, "settlePartyLoanEarly", LOAN_ACTIVE, LOAN_PARTIAL);
            if (ServiceUtil.isError(statusValidation)) {
                return statusValidation;
            }

            List<GenericValue> dueRows = EntityQuery.use(delegator)
                    .from("PartyLoanSchedule")
                    .where("loanId", loanId)
                    .orderBy("installmentSeqNum")
                    .queryList();
            if (UtilValidate.isEmpty(dueRows)) {
                return ServiceUtil.returnError(
                        "Loan schedule not generated for loanId: " + loanId + ". Generate schedule first.");
            }

            if (UtilValidate.isNotEmpty(paymentId)) {
                GenericValue payment = validateExistingPayment(delegator, paymentId);
                if (payment == null) {
                    return ServiceUtil.returnError("Invalid paymentId; Payment not found: " + paymentId);
                }
            }

            BigDecimal settlementAmount = loan.getBigDecimal("outstandingAmount");
            if (settlementAmount == null) {
                settlementAmount = BigDecimal.ZERO;
            }
            if (settlementAmount.compareTo(BigDecimal.ZERO) <= 0) {
                return ServiceUtil.returnError("Loan outstandingAmount must be greater than zero for early settlement");
            }

            Map<String, Object> repayCtx = new HashMap<String, Object>();
            for (Map.Entry<String, ?> entry : context.entrySet()) {
                repayCtx.put(entry.getKey(), entry.getValue());
            }
            repayCtx.put("loanId", loanId);
            repayCtx.put("amountApplied", settlementAmount);
            repayCtx.put("paymentId", paymentId);
            repayCtx.put("remarks", remarks);

            Map<String, Object> repayResp = recordPartyLoanRepayment(dctx, repayCtx);
            if (ServiceUtil.isError(repayResp)) {
                return repayResp;
            }

            refreshLoanTotals(delegator, loanId);

            loan = requireLoan(delegator, loanId);

            BigDecimal outstandingAmountAfter = loan.getBigDecimal("outstandingAmount");
            if (outstandingAmountAfter == null) {
                outstandingAmountAfter = BigDecimal.ZERO;
            }

            String loanStatusIdAfter = loan.getString("loanStatusId");
            if (outstandingAmountAfter.compareTo(BigDecimal.ZERO) == 0) {
                loan.set("loanStatusId", LOAN_CLOSED);
                loan.store();
                loanStatusIdAfter = LOAN_CLOSED;
            }

            createLoanEvent(
                    delegator,
                    loanId,
                    null,
                    null,
                    "LNE_EARLY_SETTLE",
                    UtilDateTime.nowTimestamp(),
                    userLogin != null ? userLogin.getString("userLoginId") : null,
                    UtilValidate.isNotEmpty(remarks) ? remarks : "Loan settled early",
                    paymentId
            );

            Integer generatedRepaymentCount = null;
            String repaymentRecordId = null;

            Object repaymentDataObj = repayResp.get("data");
            if (repaymentDataObj instanceof Map) {
                @SuppressWarnings("unchecked")
                Map<String, Object> repaymentData = (Map<String, Object>) repaymentDataObj;
                Object countObj = repaymentData.get("allocationCount");
                if (countObj instanceof Integer) {
                    generatedRepaymentCount = (Integer) countObj;
                } else if (countObj != null) {
                    generatedRepaymentCount = Integer.valueOf(countObj.toString());
                }
                repaymentRecordId = (String) repaymentData.get("repaymentRecordId");
            }

            if (generatedRepaymentCount == null) {
                Object countObj = repayResp.get("allocationCount");
                if (countObj instanceof Integer) {
                    generatedRepaymentCount = (Integer) countObj;
                } else if (countObj != null) {
                    generatedRepaymentCount = Integer.valueOf(countObj.toString());
                }
            }
            if (repaymentRecordId == null) {
                repaymentRecordId = (String) repayResp.get("repaymentRecordId");
            }

            Map<String, Object> data = new HashMap<String, Object>();
            data.put("loanId", loanId);
            data.put("settlementAmount", settlementAmount);
            data.put("paymentId", org.apache.ofbiz.base.util.UtilValidate.isNotEmpty(paymentId) ? paymentId : "");
            data.put("payrollRunId", org.apache.ofbiz.base.util.UtilValidate.isNotEmpty(payrollRunId) ? payrollRunId : "");
            data.put("payrollResultId", org.apache.ofbiz.base.util.UtilValidate.isNotEmpty(payrollResultId) ? payrollResultId : "");
