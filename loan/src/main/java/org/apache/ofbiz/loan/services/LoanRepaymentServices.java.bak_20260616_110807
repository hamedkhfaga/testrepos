        if (UtilValidate.isNotEmpty(payrollRunId)) {
            sb.append(" payrollRunId=").append(payrollRunId);
        }
        if (UtilValidate.isNotEmpty(payrollResultId)) {
            sb.append(" payrollResultId=").append(payrollResultId);
        }
        if (UtilValidate.isNotEmpty(remarks)) {
            sb.append(" - ").append(remarks);
        }
        return sb.toString();
    }

