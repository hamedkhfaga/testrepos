    private static Map<String, Object> validateLoanStatus(GenericValue loan, String serviceName, String... allowedStatuses) {
        if (loan == null) {
            return ServiceUtil.returnError(serviceName + " failed because loan record is missing");
        }

        String currentStatusId = loan.getString("loanStatusId");
        if (UtilValidate.isEmpty(currentStatusId)) {
            return ServiceUtil.returnError(serviceName + " failed because loanStatusId is empty for loanId: "
                    + loan.getString("loanId"));
        }

        for (String allowed : allowedStatuses) {
            if (allowed.equals(currentStatusId)) {
                return ServiceUtil.returnSuccess();
            }
        }

        return ServiceUtil.returnError(
                serviceName + " not allowed for loanId: " + loan.getString("loanId")
                        + ". Current status is " + currentStatusId);
    }

