            throw new GenericEntityException("Invoice not found: " + invoiceId);
        }
        String invoiceTypeId = trimToNull(invoice.getString("invoiceTypeId"));
        if (UtilValidate.isNotEmpty(invoiceTypeId) && !"LOAN_REPAYMENT".equals(invoiceTypeId)) {
            throw new GenericEntityException("Invoice is not a repayment invoice: " + invoiceId);
        }
        if (!organizationPartyId.equals(invoice.getString("partyIdFrom"))) {
            throw new GenericEntityException("Invoice organizationPartyId mismatch for invoiceId: " + invoiceId);
        }
        String borrowerPartyId = trimToNull(loan.getString("partyId"));
        if (UtilValidate.isNotEmpty(borrowerPartyId)
                && UtilValidate.isNotEmpty(invoice.getString("partyId"))
                && !borrowerPartyId.equals(invoice.getString("partyId"))) {
            throw new GenericEntityException("Invoice borrower mismatch for invoiceId: " + invoiceId);
        }
        String expectedReference = buildRepaymentInvoiceReference(loan.getString("loanId"), loanScheduleId);
        String actualReference = trimToNull(invoice.getString("referenceNumber"));
        if (UtilValidate.isNotEmpty(actualReference)
                && !expectedReference.equals(actualReference)
                && !loan.getString("loanId").equals(actualReference)) {
            throw new GenericEntityException("Invoice reference does not belong to requested loan/schedule. invoiceId="
                    + invoiceId + ", referenceNumber=" + actualReference);
        }
        return invoice;
    }

    private static GenericValue findExistingPaymentApplicationForInvoice(Delegator delegator, String invoiceId)
            throws GenericEntityException {
        if (UtilValidate.isEmpty(invoiceId)) {
            return null;
        }
        return EntityQuery.use(delegator)
                .from("PaymentApplication")
                .where("invoiceId", invoiceId)
                .orderBy("-createdStamp", "-paymentApplicationId")
                .queryFirst();
    }

    private static String fetchPaymentStatusId(Delegator delegator, String paymentId) throws GenericEntityException {
        GenericValue payment = validateExistingPayment(delegator, paymentId);
        return payment != null ? payment.getString("statusId") : null;
    }

    private static String buildRepaymentInvoiceReference(String loanId, String loanScheduleId) {
        if (UtilValidate.isEmpty(loanId)) {
            return null;
        }
        return UtilValidate.isNotEmpty(loanScheduleId) ? (loanId + "::" + loanScheduleId) : loanId;
    }

    private static GenericValue validateExistingPayment(Delegator delegator, String paymentId)
            throws GenericEntityException {
        if (UtilValidate.isEmpty(paymentId)) {
            return null;
        }
        return EntityQuery.use(delegator)
                .from("Payment")
                .where("paymentId", paymentId)
                .queryOne();
    }

    private static Map<String, Object> buildStandardSuccess(String successMessage, Map<String, Object> data) {
        Map<String, Object> out = ServiceUtil.returnSuccess(successMessage);

        Map<String, Object> safeData = new HashMap<String, Object>();
        if (data != null) {
            safeData.putAll(data);
            out.putAll(data);
        }

        out.put("data", safeData);
        out.put("legacyData", new HashMap<String, Object>(safeData));
        return out;
    }

    private static BigDecimal safeAmount(BigDecimal value) {
        return value != null ? value : BigDecimal.ZERO;
    }

    private static BigDecimal minAmount(BigDecimal... values) {
        BigDecimal min = null;
        if (values == null || values.length == 0) {
            return BigDecimal.ZERO;
        }
        for (BigDecimal value : values) {
            BigDecimal safe = safeAmount(value);
            if (min == null || safe.compareTo(min) < 0) {
                min = safe;
            }
        }
        return min != null ? min : BigDecimal.ZERO;
    }

