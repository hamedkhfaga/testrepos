    private static void applyToScheduleRow(
            Delegator delegator,
            GenericValue loan,
            GenericValue row,
            BigDecimal applied,
            Timestamp repaymentDate,
            String sourceEnumId,
            String paymentId,
            String payrollRunId,
            String payrollResultId,
            String remarks,
            String userLoginId) throws GenericEntityException {

        if (loan == null) {
            throw new GenericEntityException("Loan record is required");
        }
        if (row == null) {
            throw new GenericEntityException("Loan schedule row is required");
        }
        if (applied == null || applied.compareTo(BigDecimal.ZERO) <= 0) {
            throw new GenericEntityException("Applied amount must be greater than zero");
        }
        if (repaymentDate == null) {
            repaymentDate = UtilDateTime.nowTimestamp();
        }
        if (UtilValidate.isEmpty(sourceEnumId)) {
            sourceEnumId = "LNRS_MANUAL";
        }

        BigDecimal outstanding = row.getBigDecimal("outstandingAmount");
        if (outstanding == null) {
            outstanding = BigDecimal.ZERO;
        }
        if (outstanding.compareTo(BigDecimal.ZERO) <= 0) {
            throw new GenericEntityException("Cannot apply repayment to schedule row with zero outstanding amount");
        }

        BigDecimal paid = row.getBigDecimal("paidAmount");
        if (paid == null) {
            paid = BigDecimal.ZERO;
        }

        BigDecimal principalAmount = row.getBigDecimal("principalAmount");
        if (principalAmount == null) {
            principalAmount = BigDecimal.ZERO;
        }

        BigDecimal interestAmount = row.getBigDecimal("interestAmount");
        if (interestAmount == null) {
            interestAmount = BigDecimal.ZERO;
        }

        BigDecimal feeAmount = row.getBigDecimal("feeAmount");
        if (feeAmount == null) {
            feeAmount = BigDecimal.ZERO;
        }

        BigDecimal penaltyAmount = row.getBigDecimal("penaltyAmount");
        if (penaltyAmount == null) {
            penaltyAmount = BigDecimal.ZERO;
        }

        BigDecimal appliedCapped = applied.min(outstanding);
        if (appliedCapped.compareTo(BigDecimal.ZERO) <= 0) {
            throw new GenericEntityException("Applied amount became zero after outstanding cap");
        }

        BigDecimal newPaid = paid.add(appliedCapped);
        BigDecimal newOutstanding = outstanding.subtract(appliedCapped);
        if (newOutstanding.compareTo(BigDecimal.ZERO) < 0) {
            newOutstanding = BigDecimal.ZERO;
        }

        row.set("paidAmount", newPaid);
        row.set("outstandingAmount", newOutstanding);
        row.set("repaymentSourceEnumId", sourceEnumId);

        if (UtilValidate.isNotEmpty(payrollRunId)) {
            row.set("processedPayrollRunId", payrollRunId);
        }
        if (UtilValidate.isNotEmpty(payrollResultId)) {
            row.set("processedPayrollResultId", payrollResultId);
        }

        row.set("scheduleStatusId", newOutstanding.compareTo(BigDecimal.ZERO) == 0 ? SCH_PAID : SCH_PARTIAL);
        row.store();

        BigDecimal remainingAllocation = appliedCapped;

        BigDecimal principalApplied = remainingAllocation.min(principalAmount);
        remainingAllocation = remainingAllocation.subtract(principalApplied);

        BigDecimal interestApplied = remainingAllocation.min(interestAmount);
        remainingAllocation = remainingAllocation.subtract(interestApplied);

        BigDecimal feeApplied = remainingAllocation.min(feeAmount);
        remainingAllocation = remainingAllocation.subtract(feeApplied);

        BigDecimal penaltyApplied = remainingAllocation.min(penaltyAmount);

        String loanRepaymentId = delegator.getNextSeqId("PartyLoanRepayment");
        GenericValue repayment = delegator.makeValue("PartyLoanRepayment");

        repayment.set("loanRepaymentId", loanRepaymentId);
        repayment.set("loanId", loan.getString("loanId"));
        repayment.set("loanScheduleId", row.getString("loanScheduleId"));
        repayment.set("repaymentDate", repaymentDate);
        repayment.set("amountApplied", appliedCapped);
        repayment.set("principalApplied", principalApplied);
        repayment.set("interestApplied", interestApplied);
        repayment.set("feeApplied", feeApplied);
        repayment.set("penaltyApplied", penaltyApplied);
        repayment.set("repaymentSourceEnumId", sourceEnumId);
        repayment.set("repaymentStatusId", REP_POSTED);
        repayment.set("remarks", remarks);

        if (UtilValidate.isNotEmpty(paymentId)) {
            repayment.set("paymentId", paymentId);
        }
        if (UtilValidate.isNotEmpty(payrollRunId)) {
            repayment.set("payrollRunId", payrollRunId);
        }
        if (UtilValidate.isNotEmpty(payrollResultId)) {
            repayment.set("payrollResultId", payrollResultId);
        }

        delegator.create(repayment);

        String eventReferenceId = null;
        if (UtilValidate.isNotEmpty(paymentId)) {
            eventReferenceId = paymentId;
        } else if (UtilValidate.isNotEmpty(payrollRunId)) {
            eventReferenceId = payrollRunId;
        }

        String eventRemarks = UtilValidate.isNotEmpty(remarks)
                ? remarks
                : "Loan repayment applied to schedule row " + row.getString("loanScheduleId");

        createLoanEvent(
                delegator,
                loan.getString("loanId"),
                row.getString("loanScheduleId"),
                loanRepaymentId,
                "LNE_REPAY",
                repaymentDate,
                userLoginId,
                eventRemarks,
                eventReferenceId
        );
    }

    private static void refreshLoanTotals(Delegator delegator, String loanId) throws GenericEntityException {
        GenericValue loan = requireLoan(delegator, loanId);

        List<GenericValue> repayments = EntityQuery.use(delegator)
                .from("PartyLoanRepayment")
                .where("loanId", loanId)
                .queryList();

        BigDecimal totalPaid = BigDecimal.ZERO;
        for (GenericValue row : repayments) {
            BigDecimal amountApplied = row.getBigDecimal("amountApplied");
            totalPaid = totalPaid.add(amountApplied == null ? BigDecimal.ZERO : amountApplied);
        }

        BigDecimal totalRepayableAmount = loan.getBigDecimal("totalRepayableAmount");
        if (totalRepayableAmount == null) {
            totalRepayableAmount = BigDecimal.ZERO;
        }

        BigDecimal outstanding = totalRepayableAmount.subtract(totalPaid);
        if (outstanding.compareTo(BigDecimal.ZERO) < 0) {
            outstanding = BigDecimal.ZERO;
        }

        loan.set("paidAmount", totalPaid);
        loan.set("outstandingAmount", outstanding);

        if (outstanding.compareTo(BigDecimal.ZERO) == 0) {
            loan.set("loanStatusId", LOAN_CLOSED);
        } else if (totalPaid.compareTo(BigDecimal.ZERO) > 0) {
            loan.set("loanStatusId", LOAN_PARTIAL);
        }

        loan.store();
    }



    private static void logLoanAudit(DispatchContext dctx,
                                     Map<String, ?> context,
                                     String actionTypeId,
                                     String status,
                                     String message) {
        try {
            LocalDispatcher dispatcher = dctx.getDispatcher();
            GenericValue userLogin = (GenericValue) context.get("userLogin");
            if (dispatcher == null || userLogin == null) {
                return;
            }

            String payrollRunId = (String) context.get("payrollRunId");
            String payrollPeriodId = (String) context.get("payrollPeriodId");
            String organizationPartyId = (String) context.get("organizationPartyId");
            String partyId = (String) context.get("partyId");

            if (UtilValidate.isEmpty(organizationPartyId) && UtilValidate.isNotEmpty(payrollRunId)) {
                GenericValue payrollRun = dctx.getDelegator().findOne("PayrollRun", false, "payrollRunId", payrollRunId);
                if (payrollRun != null) {
                    organizationPartyId = payrollRun.getString("organizationPartyId");
                    if (UtilValidate.isEmpty(payrollPeriodId)) {
                        payrollPeriodId = payrollRun.getString("payrollPeriodId");
                    }
                }
            }

            dispatcher.runSync("createPayrollActionAudit", UtilMisc.toMap(
                    "organizationPartyId", organizationPartyId,
                    "payrollRunId", payrollRunId,
                    "payrollPeriodId", payrollPeriodId,
                    "partyId", partyId,
                    "actionTypeId", actionTypeId,
                    "actionStatusId", status,
                    "messageText", message,
                    "userLogin", userLogin
            ));
        } catch (Exception ignored) {
        }
    }

