<ofbiz-component name="loan"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">
    <!-- define resource loaders; most common is to use the component resource loader -->
    <resource-loader name="main" type="component"/>

    <!-- place the config directory on the classpath to access configuration files -->
    <classpath type="dir" location="config"/>
    <!-- entity resources: model(s), eca(s), group, and data definitions -->
    <entity-resource type="model" reader-name="main" loader="main" location="entitydef/entitymodel.xml"/>
    <!-- <entity-resource type="eca" reader-name="main" loader="main" location="entitydef/eecas.xml"/> -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/LoanSecurityPermissionSeedData.xml"/>
    <entity-resource type="data" reader-name="demo" loader="main" location="data/LoanSecurityGroupDemoData.xml"/>
    <!-- Foundational enumerations/statuses required for the loan engine to function (loan types,
         interest methods, allocation order, statuses). Loaded as "seed" because the service layer
         depends on these records existing, not just demo convenience data. -->
    
    <!-- Organization-specific GL account mapping and repayment-method configuration for the
         demo "Company" party. Loaded as "demo" since real deployments will replace these with
     <entity-resource type="data" reader-name="seed" loader="main" location="data/LoanTypeData.xml"/>
    <entity-resource type="data" reader-name="seed" loader="main" location="data/LoanStatusData.xml"/>
    <entity-resource type="data" reader-name="demo" loader="main" location="data/LoanDemoData.xml"/>
    <entity-resource type="data" reader-name="demo" loader="main" location="data/LoanRepaymentMethodConfigData.xml"/>
    their own organization's GL account IDs. -->
    <!-- service resources: model(s), eca(s) and group definitions -->
    <service-resource type="model" loader="main" location="servicedef/services.xml"/>

    <test-suite loader="main" location="testdef/LoanTests.xml"/>

    <!-- web applications; will be mounted when using the embedded container -->
    <webapp name="loan"
        title="Loan"
        server="default-server"
        location="webapp/loan"
        base-permission="OFBTOOLS,LOAN"
        mount-point="/loan"/>
</ofbiz-component>
