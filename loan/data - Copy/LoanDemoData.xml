<?xml version="1.0" encoding="UTF-8"?>
<entity-engine-xml>



    <!-- Activate employee loan receivable GL for Company -->
    <GlAccountOrganization
            glAccountId="124100"
            organizationPartyId="Company"
            fromDate="2001-01-01 00:00:00.000" />

    <!-- Optional but recommended: keep bank GL explicitly active too -->
    <GlAccountOrganization
            glAccountId="111100"
            organizationPartyId="Company"
            fromDate="2001-01-01 00:00:00.000" />


 
    <LoanAcctgCfg loanAcctgCfgId="LNACFG_COMPANY"
                  organizationPartyId="Company"
                  description="Company loan accounting config"
                  fromDate="2026-01-01 00:00:00.0"
                  isActive="Y"/>

    <!-- Manual repayment:
         Debit = cash/bank receipt
         Credit = employee loan receivable -->
    <LoanAcctgCfgDtl loanAcctgCfgId="LNACFG_COMPANY"
                     repaymentSourceEnumId="LNRS_MANUAL"
                     acctgTransTypeId="PAYMENT_ACCTG_TRANS"
                     glFiscalTypeId="ACTUAL"
                     debitGlAccountId="111000"
                     creditGlAccountId="124100"
                     finAccountTransTypeId="DEPOSIT"
                     sequenceNum="1"/>

    <!-- Payroll repayment:
         Debit = payroll clearing / payroll cash control
         Credit = employee loan receivable -->
    <LoanAcctgCfgDtl loanAcctgCfgId="LNACFG_COMPANY"
                     repaymentSourceEnumId="LNRS_PAYROLL"
                     acctgTransTypeId="PAYMENT_ACCTG_TRANS"
                     glFiscalTypeId="ACTUAL"
                     debitGlAccountId="111200"
                     creditGlAccountId="124100"
                     finAccountTransTypeId="DEPOSIT"
                     sequenceNum="2"/>
 
    <!-- Disbursement accounting config:
         Debit = employee loan receivable
         Credit = resolved dynamically from payment/fin account -->
    <LoanAcctgCfgDtl loanAcctgCfgId="LNACFG_COMPANY"
                     repaymentSourceEnumId="LNACFG_DISBURSEMENT"
                     acctgTransTypeId="OUTGOING_PAYMENT"
                     glFiscalTypeId="ACTUAL"
                     debitGlAccountId="124100"
                     finAccountTransTypeId="WITHDRAWAL"
                     sequenceNum="3"/>

 
    <!-- Phase 6D fix: allow payroll repayment debit GL 111200 for Company -->
    <GlAccountOrganization
        glAccountId="111200"
        organizationPartyId="Company"
        fromDate="2026-04-29 00:00:00.000"/>


    <!-- Phase 13: Enterprise repayment method mapping - config driven only -->
    <LoanRepaymentMethodConfig loanRepaymentMethodConfigId="LRPMC_COMP_CASH"
                               organizationPartyId="Company"
                               repaymentMethodEnumId="LNPM_CASH"
                               paymentMethodTypeId="CASH"
                               requiresExternalReference="N"
                               requiresBankReference="N"
                               requiresReceivedByUser="Y"
                               isPayrollMethod="N"
                               isActive="Y"
                               description="Cash repayment mapped to OFBiz CASH"
                               fromDate="2026-01-01 00:00:00.000"/>

    <LoanRepaymentMethodConfig loanRepaymentMethodConfigId="LRPMC_COMP_BANK"
