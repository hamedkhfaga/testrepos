<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf" 
        xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">

    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>

<handler name="service" type="request" class="org.apache.ofbiz.webapp.event.ServiceEventHandler"/>
<handler name="screen" type="view" class="org.apache.ofbiz.widget.renderer.macro.MacroScreenViewHandler"/>

    <handler name="screenfop" type="view" class="org.apache.ofbiz.widget.renderer.macro.MacroScreenViewHandler"/>

    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

<request-map uri="pingBiometricDevice">
    <security https="true" auth="true"/>
    <event type="service" invoke="pingBiometricDeviceService"/>
    <response name="success" type="request-redirect" value="main"/>
    <response name="error" type="request-redirect" value="main"/>
</request-map>


   
<request-map uri="">
    <security https="true" auth="true"/>
    <response name="success" type="request" value="main"/>
</request-map>
    <request-map uri="index"><security https="true" auth="true"/><response name="success" type="request" value="main"/></request-map>

    <request-map uri="BiometricDeviceList"><security https="true" auth="true"/><response name="success" type="view" value="BiometricDeviceList"/></request-map>
    <request-map uri="BiometricDeviceCreate"><security https="true" auth="true"/><response name="success" type="view" value="BiometricDeviceCreate"/></request-map>
    <request-map uri="createBiometricDevice">
        <security https="true" auth="true"/>
        <event type="service" invoke="createBiometricDevice"/>
        <response name="success" type="view" value="BiometricDeviceList"/>
        <response name="error" type="view" value="BiometricDeviceCreate"/>
    </request-map>

    <request-map uri="BiometricDeviceUserList"><security https="true" auth="true"/><response name="success" type="view" value="BiometricDeviceUserList"/></request-map>
    <request-map uri="createBiometricDeviceUser">
        <security https="true" auth="true"/>
        <event type="service" invoke="createBiometricDeviceUser"/>
        <response name="success" type="view" value="BiometricDeviceUserList"/>
        <response name="error" type="view" value="BiometricDeviceUserList"/>
    </request-map>
    <request-map uri="EditBiometricDeviceUser"><security https="true" auth="true"/><response name="success" type="view" value="EditBiometricDeviceUser"/></request-map>
    <request-map uri="updateBiometricDeviceUser">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateBiometricDeviceUser"/>
        <response name="success" type="view" value="BiometricDeviceUserList"/>
    </request-map>
    <request-map uri="deleteBiometricDeviceUser">
        <security https="true" auth="true"/>
        <event type="service" invoke="deleteBiometricDeviceUser"/>
        <response name="success" type="view" value="BiometricDeviceUserList"/>
    </request-map>

    <request-map uri="WorkShiftList"><security https="true" auth="true"/><response name="success" type="view" value="WorkShiftList"/></request-map>
    <request-map uri="createWorkShift">
        <security https="true" auth="true"/>
        <event type="service" invoke="createWorkShift"/>
        <response name="success" type="view" value="WorkShiftList"/>
    </request-map>

    <request-map uri="AttendancePolicyList"><security https="true" auth="true"/><response name="success" type="view" value="AttendancePolicyList"/></request-map>
    <request-map uri="CreateAttendancePolicy"><security https="true" auth="true"/><response name="success" type="view" value="CreateAttendancePolicyView"/></request-map>
    <request-map uri="createAttendancePolicy">
        <security https="true" auth="true"/>
        <event type="service" invoke="createAttendancePolicy"/> 
        <response name="success" type="view" value="AttendancePolicyList"/>
        <response name="error" type="view" value="CreateAttendancePolicyView"/>
    </request-map>

    <request-map uri="BiometricEventLogList"><security https="true" auth="true"/><response name="success" type="view" value="BiometricEventLogList"/></request-map>
    <request-map uri="AttendanceDaySummaryList"><security https="true" auth="true"/><response name="success" type="view" value="AttendanceDaySummaryList"/></request-map>
    <request-map uri="AttendanceDaySummaryDetails"><security https="true" auth="true"/><response name="success" type="view" value="AttendanceDaySummaryDetails"/></request-map>
    
    <request-map uri="AttendanceExceptionList"><security https="true" auth="true"/><response name="success" type="view" value="AttendanceExceptionList"/></request-map>
    <request-map uri="AttendanceExceptionDetails"><security https="true" auth="true"/><response name="success" type="view" value="AttendanceExceptionDetails"/></request-map>
    <request-map uri="updateAttendanceException">
        <security https="true" auth="true"/>
        <event type="service" invoke="resolveAttendanceException"/> 
        <response name="success" type="request-redirect" value="AttendanceExceptionList"/>
        <response name="error" type="view" value="AttendanceExceptionList"/>
    </request-map>

    <request-map uri="AttendanceSummary.xls"><security https="true" auth="true"/><response name="success" type="view" value="AttendanceSummaryExcel"/></request-map>
    <request-map uri="BiometricDeviceUserListCsv"><security https="true" auth="true"/><response name="success" type="view" value="BiometricDeviceUserListCsv"/></request-map>
    <request-map uri="BiometricDeviceUserListPdf"><security https="true" auth="true"/><response name="success" type="view" value="BiometricDeviceUserListPdf"/></request-map>
    <request-map uri="FindEmployeesPdf"><security https="true" auth="true"/><response name="success" type="view" value="FindEmployeesPdf"/></request-map>
    <request-map uri="FindEmployeesCsv"><security https="true" auth="true"/><response name="success" type="view" value="FindEmployeesCsv"/></request-map>
     
    <request-map uri="api/biometric/event">
        <security https="true" auth="false"/>
        <event type="service" invoke="createBiometricEventLog"/>
        <response name="success" type="request" value="json"/>
        <response name="error" type="request" value="json"/>
    </request-map>
    <request-map uri="api/attendance/pair">
        <security https="true" auth="true"/>
        <event type="service" invoke="pairAttendancePunches"/>
        <response name="success" type="request" value="json"/>
    </request-map>
	<!-- deepseek start -->
	<request-map uri="BiometricDashboard">
    <security https="true" auth="false"/> <!-- Set to true for production -->
    <response name="success" type="view" value="BiometricDashboard"/>
    </request-map>


    <view-map name="DeviceStatusPortletView" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#DeviceStatusPortlet"/>
    <view-map name="main" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#main"/>
     

    <view-map name="BiometricDashboard" type="screen"  page="component://fingerprint/widget/FingerprintScreens.xml#main"/>
    <!-- deepseek end  -->
    <view-map name="BiometricDeviceList" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#BiometricDeviceList"/>
    <view-map name="BiometricDeviceCreate" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#BiometricDeviceCreate"/>
    <view-map name="BiometricDeviceUserList" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#BiometricDeviceUserList"/>
    <view-map name="EditBiometricDeviceUser" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#EditBiometricDeviceUser"/>
    <view-map name="BiometricEventLogList" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#BiometricEventLogList"/>
    
    <view-map name="WorkShiftList" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#WorkShiftList"/>
    <view-map name="AttendancePolicyList" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#AttendancePolicyList"/>
    <view-map name="CreateAttendancePolicyView" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#CreateAttendancePolicy"/>
    
    <view-map name="AttendanceDaySummaryList" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#AttendanceDaySummaryList"/>
    <view-map name="AttendanceDaySummaryDetails" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#AttendanceDaySummaryDetails"/>
    <view-map name="AttendanceExceptionList" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#AttendanceExceptionList"/>
    <view-map name="AttendanceExceptionDetails" type="screen" page="component://fingerprint/widget/FingerprintScreens.xml#AttendanceExceptionDetails"/>
    
    <view-map name="AttendanceSummaryExcel" type="screen" content-type="application/vnd.ms-excel" page="component://fingerprint/widget/FingerprintScreens.xml#AttendanceSummaryExcelScreen"/>
    <view-map name="BiometricDeviceUserListCsv" type="screencsv" page="component://fingerprint/widget/FingerprintScreens.xml#BiometricDeviceUserListCsv" content-type="text/csv" encoding="UTF-8"/>
    <view-map name="BiometricDeviceUserListPdf" type="screenfop" page="component://fingerprint/widget/FingerprintScreens.xml#BiometricDeviceUserListPdf" content-type="application/pdf" encoding="UTF-8"/>
     
    <view-map name="error" type="screen" page="component://common/widget/CommonScreens.xml#Error"/>

</site-conf>