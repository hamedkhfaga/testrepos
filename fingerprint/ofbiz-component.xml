<ofbiz-component name="fingerprint"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">

    <!-- define resource loaders; most common is to use the component resource loader -->
    <resource-loader name="main" type="component"/>

    <!-- place the config directory on the classpath to access configuration files -->
    <classpath type="dir" location="config"/>

    <!-- UI Labels (REQUIRED) -->
    <resource type="uiLabel" loader="main" location="config/FingerprintUiLabels.xml"/>

    <!-- entity resources: model(s), eca(s), group, and data definitions -->
    <entity-resource type="model" reader-name="main" loader="main" location="entitydef/entitymodel.xml"/>
    <!-- <entity-resource type="eca" reader-name="main" loader="main" location="entitydef/eecas.xml"/> -->

    <!-- ================================================= -->
    <!-- SEED DATA (must load before demo data)             -->
    <!-- ================================================= -->

    <!-- 1) Enumerations / Types (parents for enumId FKs) -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/FingerprintEnumerationSeedData.xml"/>

    <!-- 2) Status Types (parents for StatusItem.statusTypeId) -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/FingerprintStatusTypeSeedData.xml"/>

    <!-- 3) Status Items (parents for statusId FKs مثل DEV_ACT) -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/FingerprintStatusItemSeedData.xml"/>

    <!-- 4) Any additional type/master seed data (device types, etc.) -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/FingerprintTypeData.xml"/>

    <!-- 5) Security permissions must exist before security groups reference them -->
    <entity-resource type="data" reader-name="seed" loader="main" location="data/FingerprintSecurityPermissionSeedData.xml"/>

    <!-- ================================================= -->
    <!-- DEMO DATA (depends on seed above)                  -->
    <!-- ================================================= -->

    <!-- 6) Security groups (often depend on permissions) -->
    <entity-resource type="data" reader-name="demo" loader="main" location="data/FingerprintSecurityGroupDemoData.xml"/>

    <!-- 7) Demo operational data (devices/users/fingerprints...) -->
    <entity-resource type="data" reader-name="demo" loader="main" location="data/FingerprintDemoData.xml"/>
	
	<entity-resource type="data" reader-name="seed" loader="main" location="data/FingerprintPortalData.xml"/>
  
    <!-- service resources: model(s), eca(s) and group definitions -->

  <!--	<widget-resource name="fingerprint-portlets" 
                 type="portal-portlet" 
                 reader-name="main" 
                 location="widget/FingerprintPortlets.xml"/>     -->
				 
    <service-resource type="model" loader="main" location="servicedef/services.xml"/>
    <service-resource type="model" loader="main" location="servicedef/biometric-services.xml"/>
    <service-resource type="model" loader="main" location="servicedef/attendance-services.xml"/>

    <test-suite loader="main" location="testdef/FingerprintTests.xml"/>

    <!-- web applications; will be mounted when using the embedded container -->
    <webapp name="fingerprint"
        title="Fingerprint"
        server="default-server"
        location="webapp/fingerprint"
        base-permission="OFBTOOLS,FINGERPRINT"
        mount-point="/fingerprint"/>
</ofbiz-component>
