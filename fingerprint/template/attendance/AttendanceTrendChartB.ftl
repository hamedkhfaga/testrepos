<#-- Generate a unique ID for this specific instance of the chart -->
<#assign instanceId = StringUtil.wrapString(Static["org.apache.ofbiz.base.util.UtilHttp"].getNextUniqueId(request))>
<#assign dailyStats = requestAttributes.dailyStats![]>

<#-- 1. The HTML Canvas with a UNIQUE ID -->
<canvas id="attendanceChart_${instanceId}" width="400" height="150"></canvas>

<#-- 2. Load Chart.js only once if multiple instances exist -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
(function() {
    var chartData = [
        <#list dailyStats as stat>
            { date: "${stat.date}", present: ${stat.presentCount!0}, late: ${stat.lateCount!0} }<#if stat_has_next>,</#if>
        </#list>
    ];

    // Use the unique ID generated by FreeMarker
    var canvasId = 'attendanceChart_${instanceId}';
    var ctx = document.getElementById(canvasId).getContext('2d');
    
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: [<#list dailyStats as stat>'${stat.date}',</#list>],
            datasets: [{
                label: 'Present',
                data: [<#list dailyStats as stat>${stat.presentCount!0},</#list>],
                borderColor: 'rgba(75, 192, 192, 1)',
                backgroundColor: 'rgba(75, 192, 192, 0.2)',
                fill: true,
                tension: 0.3
            }, {
                label: 'Late',
                data: [<#list dailyStats as stat>${stat.lateCount!0},</#list>],
                borderColor: 'rgba(255, 99, 132, 1)',
                backgroundColor: 'rgba(255, 99, 132, 0.2)',
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
})();
</script>