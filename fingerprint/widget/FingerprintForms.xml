                <entity-constraint name="enumTypeId" value="ATT_EXC_SEVERITY"/>
                <entity-order-by field-name="description"/>
            </entity-options>
        </drop-down>
    </field>

    <field name="exceptionStatusId" title="Status">
        <drop-down allow-empty="true">
            <entity-options entity-name="StatusItem" key-field-name="statusId" description="${description}">
                <entity-constraint name="statusTypeId" value="ATT_EXC_STATUS"/>
                <entity-order-by field-name="description"/>
            </entity-options>
        </drop-down>
    </field>

    <field name="noConditionFind"><hidden value="Y"/></field>
    <field name="submitButton" title="Search" widget-style="smallSubmit"><submit/></field>
</form>

<form name="AttendanceExceptionList" type="list" list-name="listIt" paginate-target="AttendanceExceptionList"
    default-table-style="basic-table hover-bar" header-row-style="header-row-2">
    <actions>
        <service service-name="performFind" result-map="resultMlt">
            <field-map field-name="entityName" value="AttendanceException"/>
            <field-map field-name="inputFields" from-field="parameters"/>
            <field-map field-name="noConditionFind" value="Y"/>
            <field-map field-name="orderBy" value="-workDate"/>
        </service>
        <set field="listIt" from-field="resultMlt.listIt"/>
    </actions>
    <field name="workDate" title="Date" sort-field="true"><display type="date"/></field>
    <field name="partyId" title="Employee"><display/></field>
    
    <field name="exceptionTypeEnumId" title="Type">
        <display-entity entity-name="Enumeration" key-field-name="enumId"/>
    </field>
    
    <field name="severityEnumId" title="Severity">
        <display-entity entity-name="Enumeration" key-field-name="enumId"/>
    </field>

    <field name="exceptionStatusId" title="Status">
        <display-entity entity-name="StatusItem" key-field-name="statusId" description="${description}"/>
    </field>

    <field name="resolvedByUserLoginId" title="Resolved By"><display/></field>

    <field name="detailsLink" title=" " widget-style="buttontext">
        <hyperlink description="Resolve" target="AttendanceExceptionDetails">
            <parameter param-name="attendanceExceptionId"/>
        </hyperlink>
    </field>
</form>

<form name="AttendanceExceptionResolveForm" type="single" target="updateAttendanceException" default-map-name="attendanceException">
    <field name="attendanceExceptionId"><hidden/></field>
    <field name="organizationPartyId"><hidden/></field>
    <field name="partyId" title="Employee">
        <display-entity entity-name="PartyNameView" description="${firstName} ${lastName} ${groupName}"/>
    </field>
    <field name="workDate" title="Work Date"><display type="date"/></field>
    
    <field name="exceptionTypeEnumId" title="Exception Type">
        <display-entity entity-name="Enumeration" key-field-name="enumId" description="${description}"/>
    </field>

    <field name="exceptionStatusId" title="Resolution Status">
        <drop-down allow-empty="false">
            <entity-options entity-name="StatusItem" key-field-name="statusId" description="${description}">
                <entity-constraint name="statusTypeId" value="ATT_EXC_STATUS"/>
                <entity-order-by field-name="sequenceId"/>
            </entity-options>
        </drop-down>
    </field>
    
    <field name="resolutionNote" title="Resolution Note" required-field="true">
        <textarea rows="3" cols="50"/>
    </field>

    <field name="resolvedByUserLoginId"><hidden value="${userLogin.userLoginId}"/></field>
    <field name="resolvedDateTime"><hidden value="${nowTimestamp}"/></field>
    <field name="lastModifiedByUserLoginId"><hidden value="${userLogin.userLoginId}"/></field>

    <field name="submitButton" title="Update &amp; Resolve" widget-style="smallSubmit">
        <submit button-type="button"/>
    </field>
    <field name="cancelButton" title=" " widget-style="buttontext">
        <hyperlink target="AttendanceExceptionList" description="Back to List"/>
    </field>
</form>
