<form name="FindWorkShifts" type="single" target="WorkShiftList" default-map-name="parameters">
    <field name="shiftName" title="Shift Name"><text-find ignore-case="true"/></field>
    <field name="organizationPartyId" title="Organization ID"><text-find/></field>
    <field name="shiftStatusId" title="Status">
    <drop-down allow-empty="true">
        <entity-options entity-name="StatusItem" key-field-name="statusId" description="${description}">
            <entity-order-by field-name="description"/>
        </entity-options>
    </drop-down>
</field>
    <field name="noConditionFind"><hidden value="Y"/></field>
    <field name="submitButton" title="Search" widget-style="smallSubmit"><submit/></field>
</form>



<form name="WorkShiftList" type="list" list-name="listIt" paginate-target="WorkShiftList"
      default-table-style="basic-table hover-bar" header-row-style="header-row-2">
    <actions>
        <service service-name="performFind" result-map="resultMlt">
            <field-map field-name="entityName" value="WorkShift"/>
            <field-map field-name="inputFields" from-field="parameters"/>
            <field-map field-name="noConditionFind" value="Y"/>
            <field-map field-name="orderBy" value="shiftName"/>
        </service>
        <set field="listIt" from-field="resultMlt.listIt"/>
    </actions>

    <field name="shiftId" title="ID" sort-field="true"><display/></field>
    <field name="shiftName" title="Shift Name" sort-field="true"><display/></field>
    <field name="organizationPartyId" title="Org"><display/></field>
    
    <field name="startTime" title="Start"><display type="date-time" /></field>
    <field name="endTime" title="End"><display   type="date-time"  /></field>
    
    <field name="crossMidnightFlag" title="Cross Midnight"><display/></field>
    <field name="graceInMinutes" title="Grace In"><display/></field>
    <field name="breakMinutes" title="Break"><display/></field>
    
    <field name="shiftStatusId" title="Status">
        <display-entity entity-name="StatusItem" key-field-name="statusId" description="${description}"/>
    </field>

    <field name="editLink" title=" " widget-style="buttontext">
        <hyperlink description="Edit" target="EditWorkShift">
            <parameter param-name="shiftId"/>
        </hyperlink>
    </field>
</form>
