    <field name="deviceTypeEnumId" title="${uiLabelMap['Entity.BiometricDevice.deviceTypeEnumId']}"><text/></field>
    <field name="ipAddress" position="2" title="${uiLabelMap['Entity.BiometricDevice.ipAddress']}"><text/></field>
    <field name="port"   title="${uiLabelMap['Entity.BiometricDevice.port']}"><text/></field>
    <field name="timeZoneId" position="2" title="${uiLabelMap['Entity.BiometricDevice.timeZoneId']}"><text/></field>
    <field name="facilityId" title="${uiLabelMap['Entity.BiometricDevice.facilityId']}"><text/></field>
    <field name="geoPointId" position="2" title="${uiLabelMap['Entity.BiometricDevice.geoPointId']}"><text/></field>
    <field name="statusId"  title="${uiLabelMap['Entity.BiometricDevice.statusId']}"><text/></field>   
    <field name="fromDate" title="${uiLabelMap.Common.FromDate}"><date-time/></field>
    <field name="thruDate" position="2" title="${uiLabelMap.Common.ThruDate}"><date-time/></field>    
    <field name="submitButton" title="${uiLabelMap['Common.Create']}" widget-style="span-all"><submit button-type="button"/></field>
</form>
    
	
	
