    <field name="ipAddress" title="IP Address"><display/></field>
    <field name="statusId" title="Status">
        <display description="${statusId == 'DEVICE_ENABLED' ? 'Active ●' : 'Offline ●'}"/>
    </field>
<field name="pingAction" title=" " widget-style="buttontext">
    <hyperlink target="pingBiometricDevice" description="Ping" link-type="anchor">
        <parameter param-name="biometricDeviceId"/>
    </hyperlink>
</field>

</form>

<form name="RecentPunches" type="list" list-name="recentPunches"
      odd-row-style="alternate-row" default-table-style="basic-table hover-bar">
    <actions>
        <entity-condition entity-name="BiometricEventLog">
            <order-by field-name="-eventDateTime"/>
            <limit-range start="0" size="10"/>
        </entity-condition>
    </actions>
    <field name="eventDateTime" title="Time"><display/></field>
    
    <field name="partyId" title="Employee">
        <hyperlink description="${partyId}" target="/partymgr/control/viewprofile" target-type="inter-app">
            <parameter param-name="partyId"/>
        </hyperlink>
    </field>

    <field name="punchTypeStatusId" title="Type">
        <display description="${punchTypeStatusId == 'PUNCH_IN' ? 'CHECK-IN ↓' : 'CHECK-OUT ↑'}"/>
    </field>
</form>



</forms>
