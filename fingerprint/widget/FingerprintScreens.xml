<screen name="BiometricDeviceUserList">
    <section>
        <actions>
            <set field="mainDecoratorLocation" value="component://fingerprint/widget/CommonScreens.xml" global="false"/>
            <set field="decoratorName" value="CommonAppDecorator" global="false"/>
            
            <set field="exportParameters" from-field="parameters"/>
        </actions>
        <widgets>
            <decorator-screen name="${decoratorName}" location="${mainDecoratorLocation}">
                <decorator-section name="body">
                    <screenlet title="${uiLabelMap['Entity.BiometricDeviceUser']}">
                        <container style="button-bar">
                            <link target="BiometricDeviceUserListCsv" text="Export CSV" style="buttontext create">
                                <parameter param-name="viewSize" value="9999"/>
                            </link>
                            <link target="BiometricDeviceUserListPdf" text="Export PDF" style="buttontext create">
                                <parameter param-name="viewSize" value="9999"/>
                            </link>
                        </container>

                        <include-form name="BiometricDeviceUserListForm"
                                      location="component://fingerprint/widget/FingerprintForms.xml"/>
                    </screenlet>
                </decorator-section>
            </decorator-screen>
        </widgets>
    </section>
</screen>
