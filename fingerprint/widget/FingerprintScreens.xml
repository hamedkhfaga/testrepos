<screen name="mainFingerprintDashboard">
    <section>
        <actions>
            <set field="headerItem" value="main"/>
            <script location="component://fingerprint/groovyScripts/FingerprintDashboard.groovy"/>
        </actions>
        <widgets>
            <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                <decorator-section name="body">
                    <container style="container-fluid">
                        
                        <container style="row text-center" id="dashboard-counters">
                            <container style="col-md-3">
                                <label style="h2" text="${totalEmployees!0}"/>
                                <label style="h5" text="Staff"/>
                            </container>
                            <container style="col-md-3">
                                <label style="h2" text="${presentToday!0}"/>
                                <label style="h5" text="Present"/>
                            </container>
                            <container style="col-md-3">
                                <label style="h2" text="${lateToday!0}"/>
                                <label style="h5" text="Late"/>
                            </container>
                            <container style="col-md-3">
                                <label style="h2" text="${pendingExceptions!0}"/>
                                <label style="h5" text="Pending"/>
								
                            </container>
                        </container>
                        <horizontal-separator/>

                        <container style="row">
                            <container style="col-md-12">
                                <screenlet title="Attendance Trend (Last 30 Days)">
                                    <platform-specific>
                                        <html><html-template location="component://fingerprint/template/attendance/AttendanceTrendChart.ftl"/></html>
                                    </platform-specific>
                                </screenlet>
                            </container>
                        </container>

                        <container style="row">
                            <container style="col-md-6">
                                <screenlet title="Active Devices">
                                    <include-form name="ListActiveDevices" location="component://fingerprint/widget/FingerprintForms.xml"/>
                                </screenlet>
                            </container>
                            <container style="col-md-6">
                                <screenlet title="Recent Punches">
                                    <include-form name="RecentPunches" location="component://fingerprint/widget/FingerprintForms.xml"/>
                                </screenlet>
                            </container>
                        </container>
                        
                    </container>
                </decorator-section>
            </decorator-screen>
        </widgets>
    </section>
</screen>
