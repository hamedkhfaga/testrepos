<screen name="AttendanceCounters">
    <section>
        <actions>
            <set field="totalEmployees" from-field="requestAttributes.totalEmployees" default-value="0"/>
            <set field="presentToday" from-field="requestAttributes.presentToday" default-value="0"/>
            <set field="lateToday" from-field="requestAttributes.lateToday" default-value="0"/>
            <set field="pendingExceptions" from-field="requestAttributes.pendingExceptions" default-value="0"/>
        </actions>
        <widgets>
            <container style="row">
                <container style="col-md-3">
                    <screenlet title="Total Staff">
                        <container style="text-center">
                            <label style="h1" text="${totalEmployees}"/>
                        </container>
                    </screenlet>
                </container>
                
                <container style="col-md-3">
                    <screenlet title="Present Today">
                        <container style="text-center">
                            <label style="h1" text="${presentToday}"/>
                        </container>
                    </screenlet>
                </container>
                
                <container style="col-md-3">
                    <screenlet title="Late Arrivals">
                        <container style="text-center">
                            <label style="h1" text="${lateToday}"/>
                        </container>
                    </screenlet>
                </container>
                
                <container style="col-md-3">
                    <screenlet title="Exceptions">
                        <container style="text-center">
                            <label style="h1" text="${pendingExceptions}"/>
                        </container>
                    </screenlet>
                </container>
            </container>
        </widgets>
    </section>
</screen>


