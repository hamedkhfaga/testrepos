    <!-- ================================================= -->
    <!-- BiometricEventLog List (read-only skeleton) -->
    <!-- ================================================= -->
<screen name="BiometricEventLogList">
    <section>
        <actions>
            <!-- Decorator -->
            <set field="mainDecoratorLocation"
                 value="component://fingerprint/widget/CommonScreens.xml"
                 global="false"/>
            <set field="decoratorName"
                 value="CommonAppDecorator"
                 global="false"/>

            <!-- Pagination defaults -->
            <set field="viewIndex" from-field="parameters.VIEW_INDEX" default-value="0"/>
            <set field="viewSize"  from-field="parameters.VIEW_SIZE"  default-value="20"/>

            <!-- performFind input -->
            <set field="pfIn.entityName" value="BiometricEventLog"/>
            <set field="pfIn.orderBy" value="eventDateTime DESC"/>
            <set field="pfIn.viewIndex" from-field="viewIndex"/>
            <set field="pfIn.viewSize" from-field="viewSize"/>

            <!-- IMPORTANT: allow list without filters -->
            <set field="pfIn.noConditionFind" value="Y"/>

            <!-- If you want filters later, map from parameters here:
                 <set field="pfIn.inputFields.biometricDeviceId" from-field="parameters.biometricDeviceId"/>
                 <set field="pfIn.inputFields.processStatusId"   from-field="parameters.processStatusId"/>
            -->

            <!-- Call standard OFBiz service -->
            <call-service service-name="performFind" in-map-name="pfIn" out-map-name="pfOut"/>

            <!-- Put results into the list name your form expects -->
            <set field="biometricEventLogList" from-field="pfOut.listIt"/>
            <set field="biometricEventLogListSize" from-field="pfOut.listSize"/>
        </actions>

        <widgets>
            <decorator-screen name="${decoratorName}" location="${mainDecoratorLocation}">
                <decorator-section name="body">
                    <screenlet title="${uiLabelMap['Entity.BiometricEventLog']}">
                        <include-form name="BiometricEventLogListForm"
                                      location="component://fingerprint/widget/FingerprintForms.xml"/>
                    </screenlet>
                </decorator-section>
            </decorator-screen>
        </widgets>
    </section>
</screen>





</screens>
