        <attribute name="principalAmount" type="BigDecimal" mode="IN" optional="false"/>
        <attribute name="interestRate" type="BigDecimal" mode="IN" optional="false"><description>annual, e.g. 0.08</description></attribute>
        <attribute name="termMonths" type="Long" mode="IN" optional="false"/>
        <attribute name="startDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="currencyUomId" type="String" mode="IN" optional="true"/>
        <attribute name="asseterpHirePurchaseId" type="String" mode="OUT" optional="false"/>
        <attribute name="monthlyInstallment" type="BigDecimal" mode="OUT" optional="true"/>
    </service>

    <service name="asseterpPayHirePurchaseInstallment" engine="java" auth="true" export="true" action="POST"
