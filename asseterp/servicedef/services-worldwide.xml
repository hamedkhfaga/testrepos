    <!-- ===================== Java workflow services ===================== -->

    <service name="asseterpCreateLease" engine="java" auth="true" export="true" action="POST"
            location="org.apache.ofbiz.asseterp.AsseterpWorldwideServices" invoke="asseterpCreateLease">
        <description>Recognize an IFRS 16 lease: PV of payments, ROU asset, full payment schedule, initial GL (Dr ROU / Cr Lease Liability)</description>
        <permission-service service-name="asseterpPermissionCheck" main-action="CREATE"/>
        <attribute name="fixedAssetId" type="String" mode="IN" optional="false"/>
        <attribute name="lessorPartyId" type="String" mode="IN" optional="false"/>
        <attribute name="partyId" type="String" mode="IN" optional="false"><description>Lessee organization (GL org)</description></attribute>
        <attribute name="leaseTypeId" type="String" mode="IN" optional="true"/>
        <attribute name="leaseStartDate" type="Timestamp" mode="IN" optional="false"/>
        <attribute name="termMonths" type="Long" mode="IN" optional="false"/>
        <attribute name="monthlyPayment" type="BigDecimal" mode="IN" optional="false"/>
        <attribute name="annualDiscountRate" type="BigDecimal" mode="IN" optional="false"><description>e.g. 0.06 for 6%</description></attribute>
        <attribute name="currencyUomId" type="String" mode="IN" optional="true"/>
        <attribute name="postNow" type="String" mode="IN" optional="true"/>
        <attribute name="asseterpLeaseId" type="String" mode="OUT" optional="false"/>
        <attribute name="presentValueLiability" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="acctgTransId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="asseterpPostLeasePayment" engine="java" auth="true" export="true" action="POST"
            location="org.apache.ofbiz.asseterp.AsseterpWorldwideServices" invoke="asseterpPostLeasePayment">
        <description>Post one lease schedule row: Dr Interest + Dr Liability / Cr Cash</description>
        <permission-service service-name="asseterpPermissionCheck" main-action="UPDATE"/>
        <attribute name="asseterpLeaseScheduleId" type="String" mode="IN" optional="false"/>
        <attribute name="postNow" type="String" mode="IN" optional="true"/>
        <attribute name="acctgTransId" type="String" mode="OUT" optional="true"/>
    </service>

    <service name="asseterpTerminateLease" engine="java" auth="true" export="true" action="POST"
