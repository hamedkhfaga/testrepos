            location="org.apache.ofbiz.asseterp.AsseterpWorldwideServices" invoke="asseterpAssignLicenseSeat">
        <description>Assign a seat; refuses when totalSeats are exhausted</description>
        <permission-service service-name="asseterpPermissionCheck" main-action="UPDATE"/>
        <attribute name="asseterpSoftwareLicenseId" type="String" mode="IN" optional="false"/>
        <attribute name="assignedToPartyId" type="String" mode="IN" optional="true"/>
        <attribute name="deviceFixedAssetId" type="String" mode="IN" optional="true"/>
        <attribute name="asseterpLicenseSeatId" type="String" mode="OUT" optional="false"/>
    </service>

    <service name="asseterpReleaseLicenseSeat" engine="java" auth="true" export="true" action="POST"
            location="org.apache.ofbiz.asseterp.AsseterpWorldwideServices" invoke="asseterpReleaseLicenseSeat">
        <permission-service service-name="asseterpPermissionCheck" main-action="UPDATE"/>
        <attribute name="asseterpLicenseSeatId" type="String" mode="IN" optional="false"/>
    </service>

</services>
