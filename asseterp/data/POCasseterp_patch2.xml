<?xml version="1.0" encoding="UTF-8"?>
<!--
    POCasseterp_patch2.xml — AcctgTransEntry.organizationPartyId fix
    Problem: All AcctgTransEntry records in POCasseterp.xml were seeded without
             organizationPartyId="Company". OFBiz standard Accounting searches
             filter on AcctgTransEntry.organizationPartyId, so all ASSETERP
             depreciation journals were invisible in the Finance module.
    Fix:     Re-upsert every AcctgTransEntry with organizationPartyId="Company".
             OFBiz entity-engine-xml import uses PK for upsert — the PK for
             AcctgTransEntry is (acctgTransId + acctgTransEntrySeqId), so
             re-importing with the same PK + same data + new field is safe.
    Import:  Admin > Entity Engine XML Import  (same way as POCasseterp.xml)
-->
<entity-engine-xml>

    <!-- AT-GAAP-2022-IT  Depr Expense IT Hardware 2022 -->
    <AcctgTransEntry acctgTransId="AT-GAAP-2022-IT" acctgTransEntrySeqId="01"
        organizationPartyId="Company" glAccountId="ASSETERP-741000"
        debitCreditFlag="D" amount="15300.00" currencyUomId="USD"
        description="Depr Expense IT Hardware 2022"/>
    <AcctgTransEntry acctgTransId="AT-GAAP-2022-IT" acctgTransEntrySeqId="02"
        organizationPartyId="Company" glAccountId="ASSETERP-142000"
        debitCreditFlag="C" amount="15300.00" currencyUomId="USD"
        description="Accum Depr IT Hardware 2022"/>

