<?xml version="1.0" encoding="UTF-8"?>
<!-- Asset ERP POC — expectedEndOfLife updates + FixedAssetDepMethod for all 25 assets -->
<entity-engine-xml>

    <!-- ================================================================
         UPDATE FixedAsset.expectedEndOfLife
         IT HW = 5yr life (2022 -> 2027)
         Software = 3yr life (2022 -> 2025)
         Vehicles = 5yr life (2022 -> 2027)
         Machinery = 10yr life (2022 -> 2032)
         Furniture = 10yr life (2022 -> 2032)
         ================================================================ -->

    <!-- IT Hardware -->
    <FixedAsset fixedAssetId="ASSET-IT-001" expectedEndOfLife="2027-01-15"/>
    <FixedAsset fixedAssetId="ASSET-IT-002" expectedEndOfLife="2027-02-01"/>
    <FixedAsset fixedAssetId="ASSET-IT-003" expectedEndOfLife="2027-03-01"/>
    <FixedAsset fixedAssetId="ASSET-IT-004" expectedEndOfLife="2027-04-01"/>
    <FixedAsset fixedAssetId="ASSET-IT-005" expectedEndOfLife="2027-05-15"/>
    <FixedAsset fixedAssetId="ASSET-IT-006" expectedEndOfLife="2027-06-01"/>
    <FixedAsset fixedAssetId="ASSET-IT-007" expectedEndOfLife="2027-07-01"/>
    <FixedAsset fixedAssetId="ASSET-IT-008" expectedEndOfLife="2027-08-01"/>
    <FixedAsset fixedAssetId="ASSET-IT-009" expectedEndOfLife="2027-09-01"/>
    <FixedAsset fixedAssetId="ASSET-IT-010" expectedEndOfLife="2027-10-01"/>

