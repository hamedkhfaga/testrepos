    <Enumeration enumId="DEP_DDB"  enumTypeId="AE_DEP_METHOD" sequenceId="02" description="Double Declining Balance"/>
    <Enumeration enumId="DEP_SYD"  enumTypeId="AE_DEP_METHOD" sequenceId="03" description="Sum of Years Digits"/>
    <Enumeration enumId="DEP_UOP"  enumTypeId="AE_DEP_METHOD" sequenceId="04" description="Units of Production"/>
    <Enumeration enumId="DEP_RB"   enumTypeId="AE_DEP_METHOD" sequenceId="05" description="Reducing Balance"/>
