    <!--
        Depreciation Formula CustomMethod records.
        These are the calculation engine wiring: each CustomMethod.customMethodName
        is the OFBiz service name invoked by calculateFixedAssetDepreciation.
        DEP_SL and DEP_DDB reuse the OFBiz standard services (shipped in AccountingSeedData.xml).
        DEP_SYD, DEP_UOP, DEP_RB, DEP_NONE, DEP_MACRS are implemented in
        component://asseterp/script/AsseterpDepServices.groovy.
    -->
    <CustomMethod customMethodId="AE_DEP_SL_FORMULA"   customMethodTypeId="DEPRECIATION_FORMULA"
                  customMethodName="straightLineDepreciation"
                  description="Straight Line — (cost−salvage)/years"/>
    <CustomMethod customMethodId="AE_DEP_DDB_FORMULA"  customMethodTypeId="DEPRECIATION_FORMULA"
                  customMethodName="doubleDecliningBalanceDepreciation"
                  description="Double Declining Balance — 2×(NBV−salvage)/remainingYears"/>
    <CustomMethod customMethodId="AE_DEP_SYD_FORMULA"  customMethodTypeId="DEPRECIATION_FORMULA"
                  customMethodName="asseterpSydDepreciation"
                  description="Sum-of-Years-Digits — (cost−salvage)×(n−yr+1)/SYD"/>
    <CustomMethod customMethodId="AE_DEP_UOP_FORMULA"  customMethodTypeId="DEPRECIATION_FORMULA"
                  customMethodName="asseterpUopDepreciation"
                  description="Units of Production — (cost−salvage)/capacity × unitsToDate"/>
    <CustomMethod customMethodId="AE_DEP_RB_FORMULA"   customMethodTypeId="DEPRECIATION_FORMULA"
                  customMethodName="asseterpRbDepreciation"
                  description="Reducing Balance — NBV × r, where r=1−(S/C)^(1/n)"/>
    <CustomMethod customMethodId="AE_DEP_NONE_FORMULA" customMethodTypeId="DEPRECIATION_FORMULA"
                  customMethodName="asseterpNoneDepreciation"
                  description="Non-Depreciable — always posts zero (Land, perpetual assets)"/>
    <CustomMethod customMethodId="AE_DEP_MACRS_FORMULA" customMethodTypeId="DEPRECIATION_FORMULA"
                  customMethodName="asseterpMacrsDepreciation"
                  description="MACRS — IRS Rev. Proc. 87-57 half-year convention tables (3/5/7/10/15/20YR)"/>

