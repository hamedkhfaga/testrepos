<screens xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Widget-Screen" xsi:schemaLocation="http://ofbiz.apache.org/Widget-Screen http://ofbiz.apache.org/dtds/widget-screen.xsd">

    <screen name="main">
        <section>
            <actions>
                <set field="headerItem" value="main"/>
            </actions>
            <widgets>
                <decorator-screen name="AsseterpCommonDecorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- ================================================================
         DEPRECIATION BOOKS — LIST / SEARCH
         URL: /asseterp/control/FindAssetBooks
         ================================================================ -->

    <screen name="FindAssetBooks">
        <section>
            <actions>
                <set field="headerItem" value="assetBooks"/>
                <script location="component://asseterp/script/AsseterpBookActions.groovy"
                        invoke="findAssetBooks"/>
            </actions>
            <widgets>
                <decorator-screen name="AsseterpCommonDecorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <screenlet title="${uiLabelMap.AsseterpSectionDepreciationBooks}">
                            <include-form name="FindAssetBooks"
                                    location="component://asseterp/widget/AsseterpForms.xml"/>
                        </screenlet>
                        <section>
                            <condition>
                                <not><if-empty field="assetBookList"/></not>
                            </condition>
                            <widgets>
                                <screenlet>
                                    <include-form name="ListAssetBooks"
                                            location="component://asseterp/widget/AsseterpForms.xml"/>
                                </screenlet>
                            </widgets>
                        </section>
                        <container style="button-bar">
                            <link target="EditAssetBook"
                                  text="${uiLabelMap.CommonNew} ${uiLabelMap.AsseterpAssetBookTitle}"
                                  style="create"/>
                        </container>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- ================================================================
         DEPRECIATION BOOK — DETAIL VIEW
         URL: /asseterp/control/ViewAssetBook?asseterpAssetBookId=...
         ================================================================ -->

    <screen name="ViewAssetBook">
        <section>
            <actions>
                <set field="headerItem" value="assetBooks"/>
                <entity-one entity-name="AsseterpAssetBook" value-field="assetBook">
                    <field-map field-name="asseterpAssetBookId"
                               from-field="parameters.asseterpAssetBookId"/>
                </entity-one>
            </actions>
            <widgets>
                <decorator-screen name="AsseterpCommonDecorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <screenlet title="${uiLabelMap.AsseterpAssetBookTitle}: ${assetBook.asseterpAssetBookId}">
                            <include-form name="ViewAssetBook"
                                    location="component://asseterp/widget/AsseterpForms.xml"/>
                        </screenlet>
                        <container style="button-bar">
                            <link target="EditAssetBook" text="${uiLabelMap.CommonEdit}" style="buttontext">
                                <parameter param-name="asseterpAssetBookId"
                                           from-field="assetBook.asseterpAssetBookId"/>
                            </link>
                            <link target="FindAssetBooks" text="${uiLabelMap.CommonBack}" style="buttontext"/>
                        </container>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- ================================================================
         DEPRECIATION BOOK — CREATE / EDIT FORM
         URL: /asseterp/control/EditAssetBook            (no id = create)
              /asseterp/control/EditAssetBook?asseterpAssetBookId=...  (edit)
         ================================================================ -->

    <screen name="EditAssetBook">
        <section>
            <actions>
                <set field="headerItem" value="assetBooks"/>
                <entity-one entity-name="AsseterpAssetBook" value-field="assetBook"
                        auto-field-map="true" use-cache="false"/>
            </actions>
            <widgets>
                <decorator-screen name="AsseterpCommonDecorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <section>
                            <condition><if-not-empty field="assetBook"/></condition>
                            <widgets>
                                <screenlet title="${uiLabelMap.CommonEdit} ${uiLabelMap.AsseterpAssetBookTitle}">
                                    <include-form name="CreateUpdateAssetBook"
                                            location="component://asseterp/widget/AsseterpForms.xml"
                                            override-target="UpdateAssetBook"/>
                                </screenlet>
                            </widgets>
                            <fail-widgets>
                                <screenlet title="${uiLabelMap.CommonNew} ${uiLabelMap.AsseterpAssetBookTitle}">
                                    <include-form name="CreateUpdateAssetBook"
                                            location="component://asseterp/widget/AsseterpForms.xml"
                                            override-target="CreateAssetBook"/>
                                </screenlet>
                            </fail-widgets>
                        </section>
                        <container style="button-bar">
                            <link target="FindAssetBooks" text="${uiLabelMap.CommonCancel}" style="buttontext"/>
                        </container>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

</screens>
