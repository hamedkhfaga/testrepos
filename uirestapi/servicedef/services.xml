    <service name="uiRunSql" engine="groovy" location="component://uirestapi/groovyScripts/uiRunSql.groovy" invoke="uiRunSql" export="true" action="POST" auth="true"><description>Execute SQL</description><attribute name="sqlCommand" type="String" mode="IN" optional="false"/><attribute name="grouperName" type="String" mode="IN" optional="true"/><attribute name="limitView" type="Integer" mode="IN" optional="true"/><attribute name="rows" type="List" mode="OUT" optional="true"/><attribute name="columns" type="List" mode="OUT" optional="true"/><attribute name="rowCount" type="Integer" mode="OUT" optional="true"/></service>
