    <service name="uiGetEmployeeList" engine="groovy"
        location="component://uirestapi/groovyScripts/uiGetEmployeeList.groovy"
        invoke="uiGetEmployeeList" export="true" action="POST" auth="true">
        <description>Get paginated employee list with search filters</description>
        <attribute name="viewSize"     type="Integer" mode="IN" optional="true"/>
        <attribute name="viewIndex"    type="Integer" mode="IN" optional="true"/>
        <attribute name="firstName"    type="String"  mode="IN" optional="true"/>
        <attribute name="lastName"     type="String"  mode="IN" optional="true"/>
        <attribute name="partyId"      type="String"  mode="IN" optional="true"/>
        <attribute name="employeeList" type="List"    mode="OUT" optional="true"/>
        <attribute name="totalCount"   type="Integer" mode="OUT" optional="true"/>
        <attribute name="viewSize"     type="Integer" mode="OUT" optional="true"/>
        <attribute name="viewIndex"    type="Integer" mode="OUT" optional="true"/>
    </service>

