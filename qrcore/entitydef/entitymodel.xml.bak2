<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>QrCore Entity Model — central secured QR/barcode infrastructure</title>
    <description>
        One QrCode row per (docType, docId, channel): the stable, verifiable tag for a
        document, asset, inventory item, or e-commerce touchpoint. The printable token is
        never stored — only its SHA-256 hash — and is recomputed on demand with the
        server-side HMAC secret, so tokens cannot be forged or leaked from the database.
        Every verification attempt (valid or not) is recorded as a QrScanEvent for
        tracking and analytics (B2B / customer scans).
    </description>

    <entity entity-name="QrCode" package-name="org.apache.ofbiz.qrcore" title="Registered QR Code">
        <field name="qrCodeId" type="id"><description>primary key</description></field>
        <field name="docType" type="id-long">
            <description>document kind, e.g. ACCTG_TRANS, INVOICE, QUOTE, ORDER, FIXED_ASSET, INVENTORY_ITEM, PRODUCT, URL</description></field>
        <field name="docId" type="id-vlong"><description>identifier of the tagged record</description></field>
        <field name="organizationPartyId" type="id"/>
        <field name="channel" type="id">
            <description>issuing context: DOCUMENT, ASSET_TAG, INV_LABEL, ECOMMERCE, B2B</description></field>
        <field name="statusId" type="id"/>
        <field name="tokenHash" type="long-varchar">
            <description>SHA-256 (base64url) of the full token; token itself is never persisted</description></field>
        <field name="issuedAtMillis" type="numeric">
            <description>issue instant baked into the HMAC so the token is reproducible</description></field>
        <field name="expireAt" type="date-time"/>
        <field name="issuedByUserLogin" type="id-vlong"/>
        <field name="targetUrl" type="url">
            <description>optional landing URL for e-commerce/B2B QRs</description></field>
        <field name="scanCount" type="numeric"><description>denormalized total scans</description></field>
        <field name="lastScanDate" type="date-time"/>
        <prim-key field="qrCodeId"/>
        <relation type="one" fk-name="QRC_STATUS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
        <index name="QRC_DOC_IDX">
            <index-field name="docType"/>
            <index-field name="docId"/>
        </index>
    </entity>

    <entity entity-name="QrScanEvent" package-name="org.apache.ofbiz.qrcore" title="QR Scan / Verification Event">
        <field name="scanEventId" type="id"/>
        <field name="qrCodeId" type="id"><description>null when an unknown/forged token was presented</description></field>
        <field name="scanDate" type="date-time"/>
        <field name="result" type="id">
            <description>VALID, INVALID_SIGNATURE, REVOKED, EXPIRED, UNKNOWN</description></field>
        <field name="scannedByUserLogin" type="id-vlong"/>
        <field name="sourceIp" type="short-varchar"/>
        <field name="userAgent" type="long-varchar"/>
        <field name="note" type="long-varchar"/>
        <prim-key field="scanEventId"/>
        <relation type="one" fk-name="QRSE_QRC" rel-entity-name="QrCode">
            <key-map field-name="qrCodeId"/>
        </relation>
        <index name="QRSE_QRC_IDX"><index-field name="qrCodeId"/></index>
    </entity>
</entitymodel>
