<!--
    Explicit plugin load order.

    Without this file, OFBiz auto-discovers "plugins" subdirectories and loads them
    alphabetically. That caused "loan" (which seeds data depending on records owned by
    other plugins, e.g. payroll) to load and seed its data BEFORE the plugins it depends
    on, producing missing-parent-record errors on startup.

    Rule of thumb: components with no cross-plugin data dependencies first; "payroll"
    before "loan" (loan's payroll-deduction config/data assumes payroll exists); "loan"
    last since it has the most outward dependencies of any plugin here.
-->
<component-loader xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/component-loader.xsd">
    <load-component component-location="assetmaint"/>
    <load-component component-location="assets"/>
    <load-component component-location="bi"/>
    <load-component component-location="birt"/>
    <load-component component-location="cmssite"/>
    <load-component component-location="ebay"/>
    <load-component component-location="ebaystore"/>
    <load-component component-location="ecommerce"/>
    <load-component component-location="example"/>
    <load-component component-location="exampleext"/>
    <load-component component-location="fingerprint"/>
    <load-component component-location="firstdatapaymentgateway"/>
    <load-component component-location="ldap"/>
    <load-component component-location="lucene"/>
    <load-component component-location="msggateway"/>
    <load-component component-location="multiflex"/>
    <load-component component-location="myportal"/>
    <load-component component-location="passport"/>
    <load-component component-location="pricat"/>
    <load-component component-location="projectmgr"/>
    <load-component component-location="rest-api"/>
    <load-component component-location="scrum"/>
    <load-component component-location="solr"/>
    <load-component component-location="uirestapi"/>
    <load-component component-location="webpos"/>
    <!-- qrcore: central secured-QR services; no cross-plugin dependencies -->
    <load-component component-location="qrcore"/>
    <!-- ui: ALL custom UI-support over standard OFBiz (audit trail, treasury/bank
         services, payment guards) — moved out of qrcore 2026-07-24; no cross-plugin
         data dependencies -->
    <load-component component-location="ui"/>
    <!-- asseterp: asset ERP plugin; demo data references standard app records only -->
    <load-component component-location="asseterp"/>
    <!-- payroll must load before loan: loan's seed/demo data and payroll-deduction
         repayment config assume payroll component data is already present -->
    <load-component component-location="payroll"/>
    <!-- loan loads last: it has the broadest cross-component data dependencies
         (party, accounting, payroll) of any plugin in this directory -->
    <load-component component-location="loan"/>
</component-loader>
