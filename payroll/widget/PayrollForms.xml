    <field name="countryGeoId" title="Country"  >
        <drop-down allow-empty="true">
            <entity-options entity-name="Geo" key-field-name="geoId" description="${geoName}">
                <entity-constraint name="geoTypeId" operator="equals" value="COUNTRY"/>
                <entity-order-by field-name="geoName"/>
            </entity-options>
        </drop-down>
    </field>

    <field name="isActive" title="Active">
        <drop-down allow-empty="false">
            <option key="Y" description="Yes"/>
            <option key="N" description="No"/>
        </drop-down>
    </field>

    <field name="saveBtn" title="Save"><submit/></field>
</form>

