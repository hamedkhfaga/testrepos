<form name="PayrollOrganizationSearchForm" type="single" target="PayrollOrganizationList">
    <field name="filterPressed"><hidden value="Y"/></field>
    
    <field name="organizationPartyId" title="Org Party ID"><text-find size="20" maxlength="20"/></field>
    <field name="orgName" title="Organization Name"><text-find size="30" maxlength="100"/></field>
    <field name="countryGeoId" title="Country"><text-find size="10" maxlength="20"/></field>

    <field name="isActive" title="Active">
        <drop-down allow-empty="true">
            <option key="" description="All"/>
            <option key="Y" description="Y"/>
            <option key="N" description="N"/>
        </drop-down>
    </field>

    <field name="VIEW_SIZE" title="Page Size">
        <drop-down>
            <option key="10" description="10"/>
            <option key="20" description="20"/>
            <option key="50" description="50"/>
            <option key="100" description="100"/>
        </drop-down>
    </field>

    <field name="VIEW_INDEX"><hidden value="0"/></field>

    <field name="submitButton" title="Search" widget-style="smallSubmit"><submit/></field>
<field name="resetButton" title=" " widget-style="linktext">
    <hyperlink target="PayrollOrganizationList" description="Reset"/>
</field>


</form>

