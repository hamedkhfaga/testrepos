<?xml version="1.0" encoding="UTF-8"?>
<entity-engine-xml>
  <!-- ===================================================== -->
  <!-- Payroll Scheduler: RecurrenceInfo + JobSandbox         -->
  <!-- OFBiz 24 friendly (avoid JobSandbox.recurrenceRule)    -->
  <!-- ===================================================== -->

  <!-- ===================================================== -->
  <!-- 1) Recurrence definitions                             -->
  <!-- ===================================================== -->

  <!-- Email queue worker: every 5 minutes -->
  <RecurrenceInfo recurrenceInfoId="PAY_EMAIL_5MIN"
                  startDateTime="2026-02-02 05:15:00.000"
                  recurrenceRule="FREQ=MINUTELY;INTERVAL=5"
                  recurrenceCount="-1"
                  recurrenceTimeZone="Asia/Riyadh"/>

  <!-- SMS queue worker: every 5 minutes -->
  <RecurrenceInfo recurrenceInfoId="PAY_SMS_5MIN"
                  startDateTime="2026-02-02 05:15:00.000"
                  recurrenceRule="FREQ=MINUTELY;INTERVAL=5"
                  recurrenceCount="-1"
                  recurrenceTimeZone="Asia/Riyadh"/>

  <!-- Export worker: every 10 minutes -->
  <RecurrenceInfo recurrenceInfoId="PAY_EXPORT_10MIN"
                  startDateTime="2026-02-02 05:20:00.000"
                  recurrenceRule="FREQ=MINUTELY;INTERVAL=10"
                  recurrenceCount="-1"
                  recurrenceTimeZone="Asia/Riyadh"/>

  <!-- Compliance report: daily at 02:00 -->
  <RecurrenceInfo recurrenceInfoId="PAY_COMP_DAILY_0200"
                  startDateTime="2026-02-03 02:00:00.000"
                  recurrenceRule="FREQ=DAILY;BYHOUR=2;BYMINUTE=0;BYSECOND=0"
                  recurrenceCount="-1"
                  recurrenceTimeZone="Asia/Riyadh"/>

  <!-- Monthly payroll runner: 1st day each month at 01:00 -->
  <RecurrenceInfo recurrenceInfoId="PAY_MONTHLY_0100"
                  startDateTime="2026-03-01 01:00:00.000"
                  recurrenceRule="FREQ=MONTHLY;BYMONTHDAY=1;BYHOUR=1;BYMINUTE=0;BYSECOND=0"
                  recurrenceCount="-1"
                  recurrenceTimeZone="Asia/Riyadh"/>

  <!-- ===================================================== -->
  <!-- 2) Jobs (JobSandbox)                                  -->
  <!-- ===================================================== -->
  <!-- statusId: SERVICE_PENDING is correct for new jobs      -->

  <JobSandbox jobId="PAY_EMAIL_JOB"
              jobName="Payroll Email Queue Worker"
              serviceName="processPayrollEmailQueueWorker"
              poolId="pool"
              runAsUser="system"
              statusId="SERVICE_PENDING"
              runTime="2026-02-02 05:15:05.000"
              recurrenceInfoId="PAY_EMAIL_5MIN"
              maxRetry="3"
              currentRetryCount="0"
              maxRecurrenceCount="-1"
              currentRecurrenceCount="0"/>

  <JobSandbox jobId="PAY_SMS_JOB"
              jobName="Payroll SMS Queue Worker"
              serviceName="processPayrollSmsQueueWorker"
              poolId="pool"
              runAsUser="system"
              statusId="SERVICE_PENDING"
              runTime="2026-02-02 05:15:10.000"
              recurrenceInfoId="PAY_SMS_5MIN"
              maxRetry="3"
              currentRetryCount="0"
              maxRecurrenceCount="-1"
              currentRecurrenceCount="0"/>

  <JobSandbox jobId="PAY_EXPORT_JOB"
              jobName="Payroll Export Worker"
              serviceName="processPayrollExportQueueWorker"
              poolId="pool"
              runAsUser="system"
              statusId="SERVICE_PENDING"
              runTime="2026-02-02 05:20:10.000"
              recurrenceInfoId="PAY_EXPORT_10MIN"
              maxRetry="3"
              currentRetryCount="0"
              maxRecurrenceCount="-1"
              currentRecurrenceCount="0"/>

  <JobSandbox jobId="PAY_COMP_JOB"
              jobName="Payroll Compliance Daily Worker"
              serviceName="processPayrollComplianceDailyWorker"
              poolId="pool"
              runAsUser="system"
              statusId="SERVICE_PENDING"
              runTime="2026-02-03 02:00:05.000"
              recurrenceInfoId="PAY_COMP_DAILY_0200"
              maxRetry="2"
              currentRetryCount="0"
              maxRecurrenceCount="-1"
              currentRecurrenceCount="0"/>

  <JobSandbox jobId="PAY_MONTHLY_JOB"
              jobName="Payroll Monthly Runner"
              serviceName="runMonthlyPayroll"
              poolId="pool"
              runAsUser="system"
              statusId="SERVICE_PENDING"
              runTime="2026-03-01 01:00:05.000"
              recurrenceInfoId="PAY_MONTHLY_0100"
              maxRetry="3"
              currentRetryCount="0"
              maxRecurrenceCount="-1"
              currentRecurrenceCount="0"/>
</entity-engine-xml>
