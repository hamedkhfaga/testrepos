<?xml version="1.0" encoding="UTF-8"?>
<entity-engine-xml>

    <!-- ===================================================== -->
    <!-- POC: WT Period Setup (2025-01 .. 2026-03)              -->
    <!-- Depends on:                                            -->
    <!--  - Party/PartyGroup/PartyRole core is present          -->
    <!--  - PayrollOrganization entity exists (payroll plugin)  -->
    <!--  - WT statuses exist (pocdata_01_status.xml)           -->
    <!-- ===================================================== -->

    <!-- 1) Organization Party -->
    <Party partyId="WTORG" partyTypeId="PARTY_GROUP"/>
    <PartyGroup partyId="WTORG" groupName="World Telecom (WT)"/>
    <PartyRole partyId="WTORG" roleTypeId="INTERNAL_ORGANIZATIO"/>

    <!-- 2) PayrollOrganization -->
    <PayrollOrganization organizationPartyId="WTORG"
                         orgName="World Telecom (WT)"
                         defaultCurrencyUomId="SAR"
                         countryGeoId="SAU"
                         isActive="Y"/>

    <!-- 3) PayrollPeriodType -->
    <PayrollPeriodType payrollPeriodTypeId="WTPERMON"
                       description="WT Monthly Payroll Period"
                       isActive="Y"/>

    <!-- 4) PayrollPeriod (15 months) -->
    <!-- NOTE: PayrollPeriod.startDate/endDate/payDate are type="date" => YYYY-MM-DD -->
    <!-- 2025 -->
    <PayrollPeriod payrollPeriodId="WTP2501" organizationPartyId="WTORG" periodName="2025-01"
                  payrollPeriodTypeId="WTPERMON" startDate="2025-01-01" endDate="2025-01-31" payDate="2025-01-31"
                  statusId="WT_PER_OPEN"/>
