    <SecurityPermission permission-id="SYS_SETTINGS_VIEW" description="View System Settings"/>
    <SecurityPermission permission-id="PAYROLL_STRUCT_MNG" description="Manage Payroll Structures"/>
    <SecurityPermission permission-id="ALLOWANCE_TYPE_MNG" description="Manage Allowance Types"/>
