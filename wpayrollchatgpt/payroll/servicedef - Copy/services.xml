    <!-- EmployeePayrollAssignment CRUD -->
    
    <service name="createEmployeePayrollAssignment" 
             engine="java"
             location="org.apache.ofbiz.payroll.PayrollEngine"
             invoke="createEmployeePayrollAssignment"
             auth="true">
        <description>Create employee payroll assignment</description>
        
        <!-- Required fields -->
        <attribute name="partyId" type="String" mode="IN" optional="false"/>
        <attribute name="payrollStructureId" type="String" mode="IN" optional="false"/>
        <attribute name="effectiveDate" type="Timestamp" mode="IN" optional="false"/>
        
        <!-- Optional fields -->
        <attribute name="employmentType" type="String" mode="IN" optional="true"/>
        <attribute name="contractType" type="String" mode="IN" optional="true"/>
        <attribute name="baseSalary" type="Double" mode="IN" optional="true"/>
        <attribute name="thruDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="statusId" type="String" mode="IN" optional="true"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
        
        <!-- Required for audit -->
      <attribute name="userLogin"
           type="org.apache.ofbiz.entity.GenericValue"
           mode="IN"
           optional="false"/> 
        <!-- Output parameters -->
        <attribute name="assignmentId" type="String" mode="OUT" optional="true"/>
        <attribute name="responseMessage" type="String" mode="OUT" optional="true"/>
        
    </service>
	
<service name="createEmployeePayrollAssignmentRest"
         engine="java"
         location="org.apache.ofbiz.payroll.PayrollEngine"
             invoke="createEmployeePayrollAssignment"
         auth="true"
         export="true">
    <description>Create Employee Payroll Assignment (REST wrapper)</description>

    <!-- Request fields -->
    <attribute name="partyId" type="String" mode="IN" optional="false"/>
    <attribute name="payrollStructureId" type="String" mode="IN" optional="false"/>

    <attribute name="employmentType" type="String" mode="IN" optional="true"/>
    <attribute name="contractType" type="String" mode="IN" optional="true"/>
    <attribute name="baseSalary" type="Double" mode="IN" optional="true"/>
    <attribute name="effectiveDate" type="Timestamp" mode="IN" optional="true"/>
    <attribute name="thruDate" type="Timestamp" mode="IN" optional="true"/>
    <attribute name="statusId" type="String" mode="IN" optional="true"/>
    <attribute name="comments" type="String" mode="IN" optional="true"/>

    <!-- Response fields -->
    <attribute name="assignmentId" type="String" mode="OUT" optional="true"/>
</service>



