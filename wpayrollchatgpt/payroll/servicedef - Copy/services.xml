    <!-- HR POLICY SERVICES -->
    <!-- ==================== -->
    
    <service name="validatePayrollAgainstPolicies" engine="java" location="org.apache.ofbiz.payroll.HRPolicyService" 
             invoke="validatePayrollAgainstPolicies">
        <description>Validate payroll against HR policies</description>
        <attribute name="payrollIterationId" type="String" mode="IN" optional="false"/>
        <attribute name="userLogin" type="org.apache.ofbiz.entity.GenericValue" mode="IN"/>
        <attribute name="policyViolations" type="java.util.List" mode="OUT"/>
        <attribute name="policyWarnings" type="java.util.List" mode="OUT"/>
        <attribute name="isCompliant" type="java.lang.Boolean" mode="OUT"/>
        <attribute name="checkedPolicies" type="java.lang.Integer" mode="OUT"/>
    </service>

    <service name="getEmployeePolicies" engine="java" location="org.apache.ofbiz.payroll.HRPolicyService" 
             invoke="getEmployeePolicies">
        <description>Get applicable policies for employee</description>
        <attribute name="partyId" type="String" mode="IN" optional="false"/>
        <attribute name="userLogin" type="org.apache.ofbiz.entity.GenericValue" mode="IN"/>
        <attribute name="applicablePolicies" type="java.util.List" mode="OUT"/>
        <attribute name="countryGeoId" type="String" mode="OUT"/>
        <attribute name="employmentType" type="String" mode="OUT"/>
    </service>

