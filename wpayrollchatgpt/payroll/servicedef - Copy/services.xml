    <auto-attributes mode="IN" include="nonpk" optional="false"/>
    <auto-attributes mode="IN" include="pk" optional="true"/>
    <override name="userLogin" optional="false"/>
    
</service>
    <service name="updateEmployeePayrollAssignment" default-entity-name="EmployeePayrollAssignment"
             engine="entity-auto" invoke="update">
        <description>Update employee payroll assignment</description>
    </service>

    <!-- AllowanceType CRUD -->
    <service name="createAllowanceType" default-entity-name="AllowanceType"
             engine="entity-auto" invoke="create">
        <description>Create allowance type</description>
    </service>
    <service name="updateAllowanceType" default-entity-name="AllowanceType"
             engine="entity-auto" invoke="update">
        <description>Update allowance type</description>
    </service>

    <!-- EmployeeAllowance CRUD -->
    <service name="createEmployeeAllowance" default-entity-name="EmployeeAllowance"
             engine="entity-auto" invoke="create">
        <description>Create employee allowance</description>
    </service>
    <service name="updateEmployeeAllowance" default-entity-name="EmployeeAllowance"
             engine="entity-auto" invoke="update">
        <description>Update employee allowance</description>
    </service>

    <!-- HRPolicy CRUD -->
    <service name="createHRPolicy" default-entity-name="HRPolicy"
             engine="entity-auto" invoke="create">
        <description>Create HR policy</description>
    </service>
    <service name="updateHRPolicy" default-entity-name="HRPolicy"
             engine="entity-auto" invoke="update">
        <description>Update HR policy</description>
    </service>

    <!-- ==================== -->
    <!-- CORE PAYROLL SERVICES -->
    <!-- ==================== -->
    
    <service name="calculateComprehensivePayroll" default-entity-name="EnhancedPayrollIteration"
             engine="java" location="org.apache.ofbiz.payroll.PayrollEngine" invoke="calculateComprehensivePayroll">
        <description>Comprehensive payroll calculation for all employees</description>
        <attribute name="payrollIterationId" type="String" mode="IN" optional="false"/>
        <attribute name="userLogin" type="org.apache.ofbiz.entity.GenericValue" mode="IN"/>
        <attribute name="payrollResults" type="java.util.List" mode="OUT"/>
        <attribute name="totalEmployees" type="java.lang.Integer" mode="OUT"/>
        <attribute name="totalGrossPay" type="java.math.BigDecimal" mode="OUT"/>
        <attribute name="totalNetPay" type="java.math.BigDecimal" mode="OUT"/>
        <attribute name="totalDeductions" type="java.math.BigDecimal" mode="OUT"/>
    </service>

    <service name="finalizePayrollRun" default-entity-name="EnhancedPayrollIteration"
             engine="java" location="org.apache.ofbiz.payroll.PayrollEngine" invoke="finalizePayrollRun">
        <description>Finalize and approve payroll run</description>
        <attribute name="payrollIterationId" type="String" mode="IN" optional="false"/>
        <attribute name="userLogin" type="org.apache.ofbiz.entity.GenericValue" mode="IN"/>
        <attribute name="successMessage" type="java.lang.String" mode="OUT"/>
    </service>

    <!-- ==================== -->
    <!-- TAX & COMPLIANCE SERVICES -->
    <!-- ==================== -->
    
    <service name="calculateIncomeTax" engine="java" location="org.apache.ofbiz.payroll.TaxCalculationService" 
             invoke="calculateIncomeTax">
        <description>Calculate income tax based on country-specific rules</description>
        <attribute name="partyId" type="String" mode="IN" optional="false"/>
        <attribute name="grossSalary" type="java.math.BigDecimal" mode="IN" optional="false"/>
        <attribute name="taxAmount" type="java.math.BigDecimal" mode="OUT"/>
        <attribute name="countryGeoId" type="String" mode="OUT"/>
        <attribute name="employmentType" type="String" mode="OUT"/>
    </service>

    <service name="calculateSocialSecurity" engine="java" location="org.apache.ofbiz.payroll.TaxCalculationService" 
             invoke="calculateSocialSecurity">
        <description>Calculate social security contributions</description>
        <attribute name="partyId" type="String" mode="IN" optional="false"/>
        <attribute name="grossSalary" type="java.math.BigDecimal" mode="IN" optional="false"/>
        <attribute name="socialSecurityAmount" type="java.math.BigDecimal" mode="OUT"/>
        <attribute name="countryGeoId" type="String" mode="OUT"/>
    </service>

    <!-- ==================== -->
    <!-- LOAN MANAGEMENT SERVICES -->
    <!-- ==================== -->
    
    <service name="calculateLoanDeductions" engine="java" location="org.apache.ofbiz.payroll.LoanManagementService" 
             invoke="calculateLoanDeductions">
        <description>Calculate loan deductions for payroll</description>
        <attribute name="partyId" type="String" mode="IN" optional="false"/>
        <attribute name="totalLoanDeductions" type="java.math.BigDecimal" mode="OUT"/>
        <attribute name="activeLoans" type="java.util.List" mode="OUT"/>
        <attribute name="loanCount" type="java.lang.Integer" mode="OUT"/>
    </service>

    <service name="createEmployeeLoan" default-entity-name="EmployeeLoan"
             engine="java" location="org.apache.ofbiz.payroll.LoanManagementService" invoke="createEmployeeLoan">
        <description>Create new employee loan</description>
        <attribute name="partyId" type="String" mode="IN" optional="false"/>
        <attribute name="loanType" type="String" mode="IN" optional="false"/>
        <attribute name="loanAmount" type="java.math.BigDecimal" mode="IN" optional="false"/>
        <attribute name="interestRate" type="java.math.BigDecimal" mode="IN" optional="false"/>
        <attribute name="totalInstallments" type="java.lang.Long" mode="IN" optional="false"/>
        <attribute name="userLogin" type="org.apache.ofbiz.entity.GenericValue" mode="IN"/>
        <attribute name="loanId" type="String" mode="OUT"/>
        <attribute name="monthlyInstallment" type="java.math.BigDecimal" mode="OUT"/>
        <attribute name="statusId" type="String" mode="OUT"/>
    </service>

    <!-- ==================== -->
    <!-- INTERNATIONAL HR SERVICES -->
    <!-- ==================== -->
    
    <service name="calculateAllowances" engine="java" location="org.apache.ofbiz.payroll.InternationalHRService" 
             invoke="calculateAllowances">
        <description>Calculate allowances for international employees</description>
        <attribute name="partyId" type="String" mode="IN" optional="false"/>
        <attribute name="totalAllowances" type="java.math.BigDecimal" mode="OUT"/>
        <attribute name="allowanceBreakdown" type="java.util.Map" mode="OUT"/>
    </service>

    <service name="calculateOvertime" engine="java" location="org.apache.ofbiz.payroll.InternationalHRService" 
             invoke="calculateOvertime">
        <description>Calculate overtime for employees</description>
        <attribute name="partyId" type="String" mode="IN" optional="false"/>
        <attribute name="payrollIterationId" type="String" mode="IN" optional="false"/>
        <attribute name="overtimeAmount" type="java.math.BigDecimal" mode="OUT"/>
        <attribute name="overtimeHours" type="java.lang.Long" mode="OUT"/>
    </service>

    <service name="validateEmployeeDocuments" engine="java" location="org.apache.ofbiz.payroll.InternationalHRService" 
             invoke="validateEmployeeDocuments">
        <description>Validate work permit and visa expiry</description>
        <attribute name="partyId" type="String" mode="IN" optional="false"/>
        <attribute name="expiringDocuments" type="java.util.List" mode="OUT"/>
        <attribute name="expiredDocuments" type="java.util.List" mode="OUT"/>
        <attribute name="isDocumentsValid" type="java.lang.Boolean" mode="OUT"/>
    </service>

    <!-- ==================== -->
    <!-- BARCODE & REPORTING SERVICES -->
    <!-- ==================== -->
    
    <service name="generatePayslips" engine="java" location="org.apache.ofbiz.payroll.BarcodeReportService" 
             invoke="generatePayslips">
        <description>Generate payslips with barcodes</description>
        <attribute name="payrollIterationId" type="String" mode="IN" optional="false"/>
        <attribute name="userLogin" type="org.apache.ofbiz.entity.GenericValue" mode="IN"/>
        <attribute name="generatedCount" type="java.lang.Integer" mode="OUT"/>
        <attribute name="totalEmployees" type="java.lang.Integer" mode="OUT"/>
    </service>

    <service name="generatePayslipPDF" engine="java" location="org.apache.ofbiz.payroll.BarcodeReportService" 
             invoke="generatePayslipPDF">
        <description>Generate PDF payslip</description>
        <attribute name="payrollResultId" type="String" mode="IN" optional="false"/>
        <attribute name="userLogin" type="org.apache.ofbiz.entity.GenericValue" mode="IN"/>
        <attribute name="fileName" type="String" mode="OUT"/>
        <attribute name="filePath" type="String" mode="OUT"/>
    </service>

    <service name="exportPayrollToExcel" engine="java" location="org.apache.ofbiz.payroll.BarcodeReportService" 
             invoke="exportPayrollToExcel">
        <description>Export payroll data to Excel</description>
        <attribute name="payrollIterationId" type="String" mode="IN" optional="false"/>
        <attribute name="exportType" type="String" mode="IN" optional="false"/>
        <attribute name="fileName" type="String" mode="OUT"/>
        <attribute name="filePath" type="String" mode="OUT"/>
        <attribute name="recordCount" type="java.lang.Integer" mode="OUT"/>
    </service>

    <!-- ==================== -->
    <!-- EMAIL NOTIFICATION SERVICES -->
    <!-- ==================== -->
    
    <service name="queuePayslipEmail" engine="java" location="org.apache.ofbiz.payroll.EmailNotificationService" 
             invoke="queuePayslipEmail">
        <description>Queue payslip email for employee</description>
        <attribute name="payrollResultId" type="String" mode="IN" optional="false"/>
        <attribute name="userLogin" type="org.apache.ofbiz.entity.GenericValue" mode="IN"/>
        <attribute name="emailQueueId" type="String" mode="OUT"/>
        <attribute name="toAddress" type="String" mode="OUT"/>
    </service>

    <service name="processEmailQueue" engine="java" location="org.apache.ofbiz.payroll.EmailNotificationService" 
             invoke="processEmailQueue">
        <description>Process email queue</description>
        <attribute name="userLogin" type="org.apache.ofbiz.entity.GenericValue" mode="IN"/>
        <attribute name="processedCount" type="java.lang.Integer" mode="OUT"/>
        <attribute name="failedCount" type="java.lang.Integer" mode="OUT"/>
        <attribute name="totalEmails" type="java.lang.Integer" mode="OUT"/>
    </service>

    <!-- ==================== -->
    <!-- BANK INTEGRATION SERVICES -->
    <!-- ==================== -->
    
    <service name="generateBankTransferFiles" engine="java" location="org.apache.ofbiz.payroll.BankIntegrationService" 
             invoke="generateBankTransferFiles">
        <description>Generate bank transfer files</description>
        <attribute name="payrollIterationId" type="String" mode="IN" optional="false"/>
        <attribute name="bankConfigId" type="String" mode="IN" optional="true"/>
        <attribute name="userLogin" type="org.apache.ofbiz.entity.GenericValue" mode="IN"/>
        <attribute name="batchId" type="String" mode="OUT"/>
        <attribute name="fileName" type="String" mode="OUT"/>
        <attribute name="filePath" type="String" mode="OUT"/>
        <attribute name="totalRecords" type="java.lang.Integer" mode="OUT"/>
        <attribute name="totalAmount" type="java.math.BigDecimal" mode="OUT"/>
    </service>

