 <service name="AutoCreateEmployeePayrollAssignment"
         default-entity-name="EmployeePayrollAssignment"
         engine="entity-auto"
         invoke="create"
         auth="true">
    <description>Create a new Employee Payroll Assignment</description>

    <!-- Auto-generate primary key -->
    <auto-attributes include="pk" mode="OUT" optional="false"/>

    <!-- Include all non-PK fields as IN parameters -->
    <auto-attributes include="nonpk" mode="IN" optional="false"/>

    <!-- Override comments to be optional (it’s a text area) -->
    <override name="comments" optional="true"/>
</service>

	
	<service name="createPayrollAssignmentJava" 
         engine="java"
         location="org.apache.payroll.PayrollEngine"   
         invoke="createEmployeePayrollAssignment"
         auth="true"
         require-new-transaction="true">
    <description>Create employee payroll assignment</description>
    
    <!-- Input parameters -->
    <attribute name="partyId" type="String" mode="IN" optional="false"/>
    <attribute name="payrollStructureId" type="String" mode="IN" optional="false"/>
    <attribute name="effectiveDate" type="java.sql.Timestamp" mode="IN" optional="false"/>
    <attribute name="employmentType" type="String" mode="IN" optional="true"/>
    <attribute name="contractType" type="String" mode="IN" optional="true"/>
    <attribute name="baseSalary" type="java.math.BigDecimal" mode="IN" optional="true"/>
    <attribute name="thruDate" type="java.sql.Timestamp" mode="IN" optional="true"/>
    <attribute name="statusId" type="String" mode="IN" optional="true"/>
    <attribute name="comments" type="String" mode="IN" optional="true"/>
    
    <!-- FIXED: Use String for userLoginId instead of GenericValue -->
    <attribute name="userLoginId" type="String" mode="IN" optional="false"/>
    
    <!-- Output parameters -->
    <attribute name="assignmentId" type="String" mode="OUT" optional="true"/>
    <attribute name="responseMessage" type="String" mode="OUT" optional="true"/>
</service>
 
 
 <service name="testCreateAssignmentSimple" 
         engine="simple"
         default-entity-name="EmployeePayrollAssignment"
         invoke="create"
         auth="true">
