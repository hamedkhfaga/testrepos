<screen name="EmployeeListsuccess2">

    <!-- ========================================================= -->
    <!-- EMPLOYEE LIST SCREEN – IMPROVED UI / CLEAN LAYOUT         -->
    <!-- ========================================================= -->

    <section>
        <widgets>

            <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                <decorator-section name="body">

                    <!-- Page Title -->
                    <container style="padding:20px;">
                        <label text="Payroll Employee List" style="h1"/>
                        <label text="Overview of all employees inside the payroll system" style="italic"/>
                    </container>

                    <!-- Beautiful Section Container -->
                    <container style="border:1px solid #ccc; padding:25px; margin-top:20px; 
                                      background:#fafafa; border-radius:6px;">

                        <screenlet title="Employee Directory">

                            <!-- Include Employee Form -->
                            <include-form name="EmployeeListForm"
                                          location="component://payroll/widget/PayrollForms.xml"/>
                        </screenlet>

                    </container>

                </decorator-section>
            </decorator-screen>

        </widgets>
    </section>

</screen>

<!-- ========================= -->
<!--  Employee List Screen     -->
<!-- ========================= -->
<screen name="EmployeeList">

    <section>
        <widgets>
            <decorator-screen name="main-decorator"
                              location="${parameters.mainDecoratorLocation}">
                <decorator-section name="body">

                    <!-- Page Title -->
                    <container style="margin-bottom:20px;">
                        <label text="Employee List"
                               style="font-size:22px;font-weight:bold;"/>
                        <label text="Overview of employee payroll information"
                               style="font-size:14px;color:gray;"/>
                    </container>

                    <!-- Overview Cards -->
                    <container style="display:flex;gap:15px;margin-bottom:25px;">
                        <container style="padding:20px;background:#f4f4f4;border-radius:8px;flex:1;">
                            <label text="Total Employees" style="font-weight:bold;"/>
                            <label text="${totalEmployees}" style="font-size:24px;"/>
                        </container>

                        <container style="padding:20px;background:#f4f4f4;border-radius:8px;flex:1;">
                            <label text="Active Employees" style="font-weight:bold;"/>
                            <label text="${activeEmployees}" style="font-size:24px;"/>
                        </container>

                        <container style="padding:20px;background:#f4f4f4;border-radius:8px;flex:1;">
                            <label text="Inactive Employees" style="font-weight:bold;"/>
                            <label text="${inactiveEmployees}" style="font-size:24px;"/>
                        </container>
                    </container>

                    <!-- Main Employee Table -->
                    <screenlet title="Employee Directory">
                        <include-form name="EmployeeListForm"
                                      location="component://payroll/widget/PayrollForms.xml"/>
                    </screenlet>

                </decorator-section>
            </decorator-screen>
        </widgets>
    </section>

</screen>




 

</screens>