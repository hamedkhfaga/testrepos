	<!---   custom screen   -->
	<screen name="main">
    <section>
        <widgets>
            <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                <decorator-section name="body">
                    <label text="MAIN SCREEN" style="h1"/>
                    <label text="Hello World! Main screen content above."/>
                    
                    <!-- Section for nested content -->
                    <section>
                        <condition><if-has-permission permission="OFBTOOLS"/></condition>
                        <widgets>
                            <label text="=== NESTED SECTION ===" style="h2"/>
                            <label text="User has permission to see this nested section."/>
                            <label text="• Test Item A"/>
                            <label text="• Test Item B"/>
                            <label text="• Test Item C"/>
                        </widgets>
                    </section>
                    
                    <!-- Another section without condition -->
                    <section>
                        <widgets>
                            <label text="Public Nested Section" style="h3"/>
                            <label text="This section is always visible to all users."/>
                            <container style="simple-box">
                                <label text="Sample Data:"/>
                                <label text="Row 1: Value 1"/>
                                <label text="Row 2: Value 2"/>
                                <label text="Row 3: Value 3"/>
                            </container>
                        </widgets>
                    </section>
                    
                    <label text="=== END OF SCREEN ===" style="h2"/>
                </decorator-section>
            </decorator-screen>
        </widgets>
    </section>
</screen>  
 



<screen name="maina">
    <section>
        <widgets>
            <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                <decorator-section name="body">
                    <label text="MAIN SCREEN" style="h1"/>
                    <label text="Hello World from Main Screen!"/>
                    
                    <!-- Correct way to include nested content -->
                    <section>
                        <widgets>
                            <!-- Content of what would be the nested screen -->
                            <container style="panel" class="nested-panel">
                                <label text="NESTED CONTENT AREA" style="h2"/>
                                <label text="This is embedded content using section/widgets pattern."/>
                                
                                <container style="spacing">
                                    <label text="Test Labels:" style="bold"/>
                                    <label text="• Payroll Module"/>
                                    <label text="• Employee Database"/>
                                    <label text="• Report Generator"/>
                                    <label text="• Audit Trail"/>
                                </container>
                                
                                <container style="form">
                                    <label text="Status Info:" style="h3"/>
                                    <container style="form-row">
                                        <label text="Module:" style="form-label"/>
                                        <label text="PayrollDashboard" style="form-value"/>
                                    </container>
                                    <container style="form-row">
                                        <label text="State:" style="form-label"/>
                                        <label text="Running ✓" style="form-value"/>
                                    </container>
                                </container>
                            </container>
                        </widgets>
                    </section>
                    
                    <label text="Back to Main Content" style="h2"/>
                    <label text="Main screen continues here after nested section."/>
                </decorator-section>
            </decorator-screen>
        </widgets>
    </section>
</screen>

   
